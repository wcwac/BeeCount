<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp">
    <RelativeLayout android:orientation="horizontal" android:id="@+id/total_layout" android:layout_width="match_parent" android:layout_height="50dp">
        <View android:id="@+id/tag_color" android:layout_width="15dp" android:layout_height="15dp" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
        <TextView android:textSize="15sp" android:textColor="@color/black" android:id="@+id/tag_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="标签名" android:layout_centerVertical="true" android:layout_marginStart="10dp" android:layout_toEndOf="@+id/tag_color" />
        <TextView android:textSize="12sp" android:textColor="@color/grey" android:id="@+id/auto_add_tag" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="(A)" android:layout_centerVertical="true" android:layout_marginStart="5dp" android:layout_toEndOf="@+id/tag_name" />
        <ImageView android:id="@+id/tag_edit" android:background="@drawable/selectable_item_circle" android:padding="12dp" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginTop="5dp" android:layout_marginBottom="5dp" android:src="@mipmap/ic_book_menu" android:tint="@color/iconTint" android:layout_marginEnd="5dp" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/child_tag" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:overScrollMode="never" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
</LinearLayout>