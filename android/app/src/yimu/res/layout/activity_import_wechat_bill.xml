<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/parent_layout" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:layout_width="match_parent" android:layout_height="wrap_content" android:src="@mipmap/ic_import_wechat_tip" android:scaleType="fitCenter" android:layout_above="@+id/tip_text" android:paddingStart="20dp" android:paddingEnd="20dp" />
    <TextView android:textSize="11dp" android:textColor="@color/darkGrey" android:id="@+id/tip_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="20dp" android:text="注意事项：1.账单列表，非账单详情；2.高度小于1万像素；3.简体中文、系统默认字体；4.尽可能使用日间主题；" android:layout_above="@+id/choice_bill_image" android:lineSpacingExtra="3dp" />
    <TextView android:textSize="15sp" android:textColor="@color/textColorLight" android:gravity="center" android:id="@+id/choice_bill_image" android:background="@drawable/selectable_item_primary_background" android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginBottom="40dp" android:text="选择微信账单截图" android:layout_alignParentBottom="true" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" />
    <TextView android:textSize="12sp" android:textColor="@color/textGray" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:text="OCR技术由华为云提供" android:layout_alignParentBottom="true" android:layout_centerHorizontal="true" />
    <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/preview_layout" android:background="@drawable/background_add_image_popup" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="5dp" android:layout_above="@+id/choice_bill_image" android:layout_marginStart="30dp">
        <TextView android:textSize="11sp" android:textColor="@color/textGray" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="猜您想要识别：" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" />
        <ImageView android:id="@+id/image_preview" android:layout_width="60dp" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
    </LinearLayout>
</RelativeLayout>