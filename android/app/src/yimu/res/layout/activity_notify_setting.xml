<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <RelativeLayout android:background="@drawable/shape_bg_setting" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:minHeight="42dp" android:paddingStart="10dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_toStartOf="@+id/btn_layout">
                <RelativeLayout android:id="@+id/icon_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignTop="@+id/mode_layout" android:layout_marginEnd="10dp">
                    <ImageView android:id="@+id/icon_small" android:layout_width="25dp" android:layout_height="25dp" android:src="@mipmap/ic_init" />
                    <ImageView android:id="@+id/icon_big" android:visibility="gone" android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_init" />
                </RelativeLayout>
                <LinearLayout android:orientation="vertical" android:id="@+id/mode_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_toEndOf="@+id/icon_layout">
                    <TextView android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" android:textStyle="bold" android:id="@+id/title_preview" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="自动记账运行中" android:singleLine="true" />
                    <TextView android:textSize="12dp" android:textColor="@color/notify_grey_color" android:id="@+id/content_preview" android:visibility="visible" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="今日收入0.00 • 今日支出0.00" android:singleLine="true" />
                </LinearLayout>
            </RelativeLayout>
            <LinearLayout android:orientation="horizontal" android:id="@+id/btn_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_alignParentEnd="true">
                <ImageView android:id="@+id/btn_ai" android:background="@drawable/selectable_item_circle" android:padding="4dp" android:layout_width="38dp" android:layout_height="38dp" android:src="@mipmap/ic_notify_ai" android:tint="@color/notify_color" />
                <ImageView android:id="@+id/btn_speech" android:background="@drawable/selectable_item_circle" android:padding="3dp" android:layout_width="38dp" android:layout_height="38dp" android:src="@mipmap/ic_notify_speech" android:tint="@color/notify_color" />
                <ImageView android:id="@+id/btn_add" android:background="@drawable/selectable_item_circle" android:padding="3dp" android:layout_width="38dp" android:layout_height="38dp" android:src="@mipmap/ic_notify_add" android:tint="@color/notify_color" />
                <ImageView android:id="@+id/btn_module" android:background="@drawable/selectable_item_circle" android:padding="8dp" android:visibility="gone" android:layout_width="38dp" android:layout_height="38dp" android:src="@mipmap/ic_home_module" android:tint="@color/notify_color" />
            </LinearLayout>
        </RelativeLayout>
        <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp">
            <RelativeLayout android:id="@+id/notify_show_layout" android:layout_width="match_parent" android:layout_height="60dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true">
                    <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="显示通知栏" />
                </LinearLayout>
                <Switch android:id="@+id/switch_notify_show" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <RelativeLayout android:id="@+id/notify_keep_layout" android:visibility="gone" android:layout_width="match_parent" android:layout_height="60dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true">
                    <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="通知栏常驻" />
                </LinearLayout>
                <Switch android:id="@+id/switch_notify_keep" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <RelativeLayout android:id="@+id/notify_style_layout" android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="60dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                <ImageView android:id="@+id/notify_style_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true">
                    <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="通知栏样式" />
                </LinearLayout>
                <TextView android:textSize="13sp" android:textColor="@color/grey" android:id="@+id/notify_style" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="经典原生" android:layout_centerVertical="true" android:layout_marginEnd="6dp" android:layout_toStartOf="@+id/notify_style_more" />
            </RelativeLayout>
            <RelativeLayout android:id="@+id/title_layout" android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="60dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                <ImageView android:id="@+id/title_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true">
                    <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="标题内容" />
                </LinearLayout>
                <TextView android:textSize="13sp" android:textColor="@color/grey" android:id="@+id/title_content" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="自动记账状态" android:layout_centerVertical="true" android:layout_marginEnd="6dp" android:layout_toStartOf="@+id/title_more" />
            </RelativeLayout>
            <RelativeLayout android:id="@+id/second_content_layout" android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="60dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                <ImageView android:id="@+id/content_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true">
                    <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="副标题内容" />
                </LinearLayout>
                <TextView android:textSize="13sp" android:textColor="@color/grey" android:id="@+id/content" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="经典原生" android:layout_centerVertical="true" android:layout_marginEnd="6dp" android:layout_toStartOf="@+id/content_more" />
            </RelativeLayout>
            <RelativeLayout android:id="@+id/content_click_layout" android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="60dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                <ImageView android:id="@+id/content_click_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true">
                    <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="点击标题操作" />
                </LinearLayout>
                <TextView android:textSize="13sp" android:textColor="@color/grey" android:id="@+id/content_click" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="暂停/启用自动记账" android:layout_centerVertical="true" android:layout_marginEnd="6dp" android:layout_toStartOf="@+id/content_click_more" />
            </RelativeLayout>
            <LinearLayout android:orientation="vertical" android:id="@+id/self_notify_layout" android:layout_width="match_parent" android:layout_height="wrap_content">
                <RelativeLayout android:id="@+id/icon_show_layout" android:layout_width="match_parent" android:layout_height="60dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                    <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true">
                        <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="显示图标" />
                    </LinearLayout>
                    <Switch android:id="@+id/switch_icon_show" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/add_show_layout" android:layout_width="match_parent" android:layout_height="60dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                    <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true">
                        <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="手动记账按钮" />
                    </LinearLayout>
                    <Switch android:id="@+id/switch_add_show" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/ai_show_layout" android:layout_width="match_parent" android:layout_height="60dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                    <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true">
                        <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="智能记账按钮" />
                    </LinearLayout>
                    <Switch android:id="@+id/switch_ai_show" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/speech_show_layout" android:layout_width="match_parent" android:layout_height="60dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                    <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true">
                        <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="语音记账按钮" />
                    </LinearLayout>
                    <Switch android:id="@+id/switch_speech_show" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/module_show_layout" android:layout_width="match_parent" android:layout_height="60dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                    <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true">
                        <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="模板记账按钮" />
                    </LinearLayout>
                    <Switch android:id="@+id/switch_module_show" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>