<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:id="@+id/parent_layout" android:paddingBottom="30dp" android:clipChildren="false" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never">
    <LinearLayout android:orientation="vertical" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/shape_bg_budget" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp">
            <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/pay_layout" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:id="@+id/pay_num_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="共支出" />
                <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/pay_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:shadowColor="@color/colorPrimaryDark" />
            </LinearLayout>
            <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/income_layout" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:id="@+id/income_num_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="共收入" />
                <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/income_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:shadowColor="@color/colorPrimaryDark" />
            </LinearLayout>
            <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/balance_layout" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:id="@+id/balance_num_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="共结余" />
                <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/balance_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:shadowColor="@color/colorPrimaryDark" />
            </LinearLayout>
            <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/bill_count_layout" android:visibility="gone" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="账单数量" />
                <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/bill_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:shadowColor="@color/colorPrimaryDark" />
            </LinearLayout>
        </LinearLayout>
        <RelativeLayout android:id="@+id/bar_layout" android:background="@drawable/shape_bg_setting" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/bar_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="支出统计" android:layout_marginStart="10dp" />
            <FrameLayout android:id="@+id/bar_chart" android:layout_width="match_parent" android:layout_height="150dp" android:layout_marginTop="10dp" android:layout_below="@+id/bar_title" />
        </RelativeLayout>
        <LinearLayout android:orientation="vertical" android:id="@+id/member_layout" android:background="@drawable/shape_bg_theme_content_5" android:paddingTop="10dp" android:paddingBottom="10dp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="255dp" android:layout_marginBottom="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="成员收支" android:layout_marginStart="10dp" />
            </RelativeLayout>
            <RelativeLayout android:layout_width="match_parent" android:layout_height="200dp">
                <FrameLayout android:id="@+id/pie_member_chart" android:layout_width="match_parent" android:layout_height="200dp" />
            </RelativeLayout>
        </LinearLayout>
        <RelativeLayout android:orientation="vertical" android:id="@+id/chart_layout" android:background="@drawable/shape_bg_setting" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/pie_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="支出占比" android:layout_marginStart="10dp" />
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/category_pie_menu" android:background="@drawable/bg_statistics_bar_menu" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="22dp" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true">
                <TextView android:textSize="11sp" android:gravity="center" android:id="@+id/pie_parent" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="一级分类" android:paddingStart="10dp" android:paddingEnd="10dp" />
                <TextView android:textSize="11sp" android:gravity="center" android:id="@+id/pie_all" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="全部" android:paddingStart="10dp" android:paddingEnd="10dp" />
            </LinearLayout>
            <RelativeLayout android:id="@+id/pie_chart_layout" android:layout_width="match_parent" android:layout_height="200dp" android:layout_below="@+id/pie_title">
                <FrameLayout android:id="@+id/pie_chart" android:layout_width="match_parent" android:layout_height="200dp" />
                <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/pie_chart_check" android:layout_width="60dp" android:layout_height="wrap_content" android:layout_centerInParent="true">
                    <TextView android:textSize="13sp" android:textColor="@color/darkGrey" android:id="@+id/pie_chart_check_text" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="支出" />
                    <ImageView android:id="@+id/pie_chart_check_icon" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp" android:src="@mipmap/ic_checkout" android:tint="@color/black" />
                    <TextView android:textSize="10sp" android:textColor="@color/black" android:id="@+id/pie_chart_check_tip_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="切换到收入" />
                </LinearLayout>
            </RelativeLayout>
            <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_below="@+id/pie_chart_layout" android:layout_alignParentEnd="true">
                <CheckBox android:textColor="@color/darkGrey" android:id="@+id/category_num_check" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="false" android:text="显示收支金额" style="@style/autoCheckBox" />
                <CheckBox android:textColor="@color/darkGrey" android:id="@+id/filter_category_check" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="过滤占比小于1%的分类" style="@style/autoCheckBox" />
            </LinearLayout>
        </RelativeLayout>
        <LinearLayout android:orientation="vertical" android:id="@+id/data_layout" android:background="@drawable/shape_bg_setting" android:paddingTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/data_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="分类数据" android:layout_marginStart="10dp" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/bill_data" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:overScrollMode="never" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>