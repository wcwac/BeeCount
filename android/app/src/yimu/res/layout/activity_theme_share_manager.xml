<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:id="@+id/tool_bar" android:background="@color/white" android:layout_width="match_parent" android:layout_height="50dp">
        <ImageView android:id="@+id/btn_back" android:background="@drawable/selectable_item_circle" android:padding="16dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_back" android:scaleType="fitCenter" android:tint="@color/black" />
        <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="50dp" android:maxWidth="180dp" android:text="分享中心" android:singleLine="true" android:layout_toEndOf="@+id/btn_back" />
        <ImageView android:id="@+id/ic_search" android:background="@drawable/selectable_item_circle" android:padding="15dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_search" android:scaleType="fitXY" android:tint="@color/black" android:layout_toStartOf="@+id/ic_more" />
        <ImageView android:id="@+id/ic_more" android:background="@drawable/selectable_item_circle" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_bar_more" android:scaleType="centerInside" android:tint="@color/black" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/no_data_layout" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true">
            <include android:layout_width="150dp" android:layout_height="150dp" android:layout_marginTop="100dp" android:layout_marginBottom="10dp" layout="@layout/layout_common_tip" />
            <TextView android:textSize="14sp" android:textColor="@color/textGray" android:id="@+id/search_tip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="没有任何数据" />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/data_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="7.5dp" android:layout_marginEnd="5dp" />
    </RelativeLayout>
</LinearLayout>