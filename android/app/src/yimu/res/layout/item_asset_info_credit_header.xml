<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_asset_header" android:padding="15dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp">
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:id="@+id/number_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="剩余欠款" />
                <TextView android:textSize="22sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/number" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9999999" />
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:id="@+id/service_number_layout" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="分期手续费" />
                <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/service_number" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3sp" android:text="9999999" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:id="@+id/quota_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="总额度：" />
                <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/total_quota" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9999999" />
            </LinearLayout>
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/quota_remain_layout" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="剩余额度：" />
                <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/total_quota_remain" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2530" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="出账日：" />
                <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/out_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9999999" />
            </LinearLayout>
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="还款日：" />
                <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/in_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9999999" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/year_interest_layout" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="年费：" />
            <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:id="@+id/year_interest" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="已免年费" android:singleLine="true" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/card_code_layout" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp">
            <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="卡号：" />
            <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:id="@+id/card_code" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:singleLine="true" />
            <ImageView android:id="@+id/copy_btn" android:background="@drawable/selectable_item_circle" android:padding="6dp" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_copy" android:tint="@color/textColorLight" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:gravity="center" android:orientation="horizontal" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginTop="15dp">
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/add_bill_btn" android:background="@drawable/selectable_item_expand_mask" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@mipmap/ic_add_bill" android:tint="@color/black" />
            <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="记账" android:layout_marginStart="10dp" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/repayment_btn" android:background="@drawable/selectable_item_expand_mask" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@mipmap/ic_data_repayment" android:tint="@color/black" />
            <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="还款" android:layout_marginStart="10dp" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/transfer_accounts_btn" android:background="@drawable/selectable_item_expand_mask" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@mipmap/ic_transfer_accounts" android:tint="@color/black" />
            <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="转账" android:layout_marginStart="10dp" />
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout android:id="@+id/bill_repayment_layout" android:background="@drawable/shape_bg_setting" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:paddingStart="15dp">
        <TextView android:textSize="13sp" android:textColor="@color/black" android:id="@+id/bill_repayment_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="11月12日待还" />
        <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/bill_repayment_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:layout_marginBottom="10dp" android:text="4189.66" android:layout_below="@+id/bill_repayment_title" />
        <TextView android:textSize="13sp" android:textColor="@color/colorPrimaryText" android:gravity="center" android:id="@+id/bill_repayment" android:background="@drawable/selectable_item_light_primary_background" android:layout_width="80dp" android:layout_height="30dp" android:text="去还款" android:layout_centerVertical="true" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <RelativeLayout android:id="@+id/loan_repayment_layout" android:background="@drawable/shape_bg_setting" android:paddingTop="10dp" android:paddingBottom="10dp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:paddingStart="15dp">
        <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true">
            <TextView android:textSize="13sp" android:textColor="@color/black" android:id="@+id/loan_repayment_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="11月12日待还房贷" />
            <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/loan_repayment_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="4189.66" android:layout_below="@+id/loan_repayment_title" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true">
            <TextView android:textSize="13sp" android:textColor="@color/colorPrimaryText" android:gravity="center" android:id="@+id/loan_repayment" android:background="@drawable/selectable_item_light_primary_background" android:layout_width="80dp" android:layout_height="30dp" android:text="去还款" />
            <TextView android:textSize="13sp" android:textColor="@color/colorPrimaryText" android:gravity="center" android:id="@+id/loan_repayment_close" android:background="@drawable/selectable_item_light_primary_background" android:layout_width="80dp" android:layout_height="30dp" android:layout_marginTop="10dp" android:text="标记已还" />
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>