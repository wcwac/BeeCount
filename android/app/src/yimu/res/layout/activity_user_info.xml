<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
            <RelativeLayout android:id="@+id/head_layout" android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="60dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="头像" android:layout_centerVertical="true" />
                <ImageView android:id="@+id/photo_image" android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_launcher_no_color" android:layout_centerVertical="true" android:layout_alignParentEnd="true" app:border_color="@color/grey" app:border_width="1dp" app:oval="true" />
            </RelativeLayout>
            <RelativeLayout android:id="@+id/nickname_layout" android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="60dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="昵称" android:layout_centerVertical="true" />
                <LinearLayout android:gravity="end" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_alignParentEnd="true">
                    <TextView android:textSize="14sp" android:textColor="@color/darkGrey" android:id="@+id/nickname" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="200dp" android:text="一木记账" android:singleLine="true" />
                    <TextView android:textSize="10dp" android:textColor="@color/grey" android:id="@+id/id_info" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:maxWidth="200dp" android:text="ID:00000001" android:singleLine="true" />
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout android:id="@+id/user_vip" android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="60dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="会员" android:layout_centerVertical="true" />
                <TextView android:textSize="14sp" android:textColor="@color/darkGrey" android:id="@+id/vip_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="200dp" android:text="普通用户" android:singleLine="true" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
            <RelativeLayout android:id="@+id/email_layout" android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="60dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true">
                    <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="邮箱" />
                    <TextView android:textSize="12sp" android:textColor="@color/grey" android:id="@+id/email" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" />
                </LinearLayout>
                <TextView android:textSize="14sp" android:textColor="@color/darkGrey" android:id="@+id/email_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="200dp" android:text="未绑定" android:singleLine="true" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <RelativeLayout android:id="@+id/password_layout" android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="60dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true">
                    <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="密码" />
                    <TextView android:textSize="12sp" android:textColor="@color/grey" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="用于邮箱登录，及指纹认证失败时的凭证" />
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
            <RelativeLayout android:id="@+id/wechat_layout" android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="60dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true">
                    <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="微信" />
                    <TextView android:textSize="12sp" android:textColor="@color/grey" android:id="@+id/wechat_name" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="毛草纸" />
                </LinearLayout>
                <TextView android:textSize="14sp" android:textColor="@color/darkGrey" android:id="@+id/wechat_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="200dp" android:text="未绑定" android:singleLine="true" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <RelativeLayout android:id="@+id/qq_layout" android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="60dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true">
                    <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="QQ" />
                    <TextView android:textSize="12sp" android:textColor="@color/grey" android:id="@+id/qq_name" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" />
                </LinearLayout>
                <TextView android:textSize="14sp" android:textColor="@color/darkGrey" android:id="@+id/qq_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="200dp" android:text="未绑定" android:singleLine="true" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <RelativeLayout android:id="@+id/weibo_layout" android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="60dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true">
                    <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="微博" />
                    <TextView android:textSize="12sp" android:textColor="@color/grey" android:id="@+id/weibo_name" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" />
                </LinearLayout>
                <TextView android:textSize="14sp" android:textColor="@color/darkGrey" android:id="@+id/weibo_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="200dp" android:text="未绑定" android:singleLine="true" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
            </RelativeLayout>
        </LinearLayout>
        <TextView android:textSize="15sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/login_out" android:background="@drawable/shape_bg_main_bill_one" android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginTop="15dp" android:layout_marginBottom="20dp" android:text="退出登录" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
    </LinearLayout>
</ScrollView>