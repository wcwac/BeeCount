<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="15dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:id="@+id/day_pay_num_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="日均支出" />
            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/day_pay_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:singleLine="true" android:shadowColor="@color/colorPrimaryDark" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:id="@+id/day_income_num_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="日均收入" />
            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/day_income_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:singleLine="true" android:shadowColor="@color/colorPrimaryDark" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:id="@+id/day_balance_num_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="日均结余" />
            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/day_balance_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:singleLine="true" android:shadowColor="@color/colorPrimaryDark" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="15dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="转账" />
            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/transfer_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:singleLine="true" android:shadowColor="@color/colorPrimaryDark" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="还款" />
            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/repayment_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:singleLine="true" android:shadowColor="@color/colorPrimaryDark" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="收款" />
            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/collection_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:singleLine="true" android:shadowColor="@color/colorPrimaryDark" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="15dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="应付/借入" />
            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/borrow_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:singleLine="true" android:shadowColor="@color/colorPrimaryDark" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="应收/借出" />
            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/lend_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:singleLine="true" android:shadowColor="@color/colorPrimaryDark" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/service_cost_layout" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="手续费" />
            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/service_cost_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:singleLine="true" android:shadowColor="@color/colorPrimaryDark" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="15dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="报销" />
            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/reimbursement_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:singleLine="true" android:shadowColor="@color/colorPrimaryDark" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="报销到账" />
            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/reimbursement_do_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:singleLine="true" android:shadowColor="@color/colorPrimaryDark" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="待报销" />
            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/reimbursement_not_do_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:singleLine="true" android:shadowColor="@color/colorPrimaryDark" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="15dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="退款" />
            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/refund_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:singleLine="true" android:shadowColor="@color/colorPrimaryDark" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="退款收入" />
            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/refund_income_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:singleLine="true" android:shadowColor="@color/colorPrimaryDark" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="退款支出" />
            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/refund_pay_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:singleLine="true" android:shadowColor="@color/colorPrimaryDark" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="15dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="支出优惠" />
            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/pay_discount_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:singleLine="true" android:shadowColor="@color/colorPrimaryDark" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="收入优惠" />
            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/income_discount_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:singleLine="true" android:shadowColor="@color/colorPrimaryDark" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>