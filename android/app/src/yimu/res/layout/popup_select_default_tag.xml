<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/parent_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" app:maxHeight="320dp">
    <RelativeLayout android:id="@+id/background" android:background="@drawable/background_home_popup" android:layout_width="280dp" android:layout_height="wrap_content">
        <RelativeLayout android:id="@+id/top_layout" android:layout_width="match_parent" android:layout_height="40dp">
            <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/textColorPrimary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="选择标签" android:layout_centerVertical="true" android:layout_marginStart="10dp" />
            <ImageView android:id="@+id/change_mode" android:background="@drawable/selectable_item_circle" android:padding="12dp" android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_asset_choice_three" android:tint="@color/black" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/tag_list" android:layout_width="280dp" android:layout_height="wrap_content" android:layout_below="@+id/top_layout" android:layout_centerVertical="true" android:overScrollMode="never" />
    </RelativeLayout>
</FrameLayout>