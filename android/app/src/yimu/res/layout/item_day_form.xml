<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="horizontal" android:id="@+id/parent_layout" android:layout_width="match_parent" android:layout_height="40dp">
    <TextView android:textSize="13sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/date" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
    <TextView android:textSize="13sp" android:textColor="@color/moneyIncome" android:gravity="center" android:id="@+id/income" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
    <TextView android:textSize="13sp" android:textColor="@color/moneyPay" android:gravity="center" android:id="@+id/pay" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
    <TextView android:textSize="13sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/balance" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
</LinearLayout>