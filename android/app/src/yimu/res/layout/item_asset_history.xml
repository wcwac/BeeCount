<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/total_layout" android:background="@drawable/selectable_item_expand" android:layout_width="match_parent" android:layout_height="60dp" android:paddingStart="15dp" android:paddingEnd="15dp">
    <RadioButton android:id="@+id/radio_button" android:focusable="false" android:visibility="gone" android:clickable="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="5dp" />
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/num_layout" android:layout_toEndOf="@+id/radio_button">
        <TextView android:textSize="15sp" android:textColor="@color/black" android:id="@+id/content" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="新建资产" android:singleLine="true" />
        <TextView android:textSize="13sp" android:textColor="@color/grey" android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="8月7日 17:48" />
    </LinearLayout>
    <LinearLayout android:gravity="end" android:orientation="vertical" android:id="@+id/num_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_alignParentEnd="true">
        <TextView android:textSize="18sp" android:textColor="@color/black" android:id="@+id/change_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-1.00" android:singleLine="true" />
        <TextView android:textSize="13sp" android:textColor="@color/grey" android:id="@+id/current_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="余额 2483.62" />
    </LinearLayout>
    <View android:id="@+id/line" android:background="@color/divider" android:layout_width="match_parent" android:layout_height="1px" android:layout_alignParentBottom="true" />
</RelativeLayout>