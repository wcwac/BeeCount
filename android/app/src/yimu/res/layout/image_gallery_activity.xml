<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_images" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" app:layoutManager="GridLayoutManager" app:spanCount="?attr/image_gallery_span_count" />
    <FrameLayout android:id="@+id/layout_footer" android:background="@color/image_color_primary" android:padding="6dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:layout_gravity="center_vertical" android:id="@+id/tv_album_folder" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/image_all_photo" />
        <CheckBox android:layout_gravity="center" android:id="@+id/cb_original" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/image_original" />
        <TextView android:layout_gravity="end|center_vertical" android:id="@+id/tv_preview" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/image_preview" />
    </FrameLayout>
</LinearLayout>