<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:background="@color/white" android:layout_width="match_parent" android:layout_height="wrap_content">
        <RelativeLayout android:id="@+id/this_month_layout" android:layout_width="match_parent" android:layout_height="55dp">
            <TextView android:textSize="15sp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/this_month" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
            <ImageView android:id="@+id/this_month_tick" android:layout_width="23dp" android:layout_height="23dp" android:src="@mipmap/ic_tick" android:tint="@color/textColorPrimary" android:layout_centerVertical="true" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/last_month_layout" android:layout_width="match_parent" android:layout_height="55dp">
            <TextView android:textSize="15sp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/last_month" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
            <ImageView android:id="@+id/last_month_tick" android:layout_width="23dp" android:layout_height="23dp" android:src="@mipmap/ic_tick" android:tint="@color/textColorPrimary" android:layout_centerVertical="true" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/this_year_layout" android:layout_width="match_parent" android:layout_height="55dp">
            <TextView android:textSize="15sp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/this_year" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
            <ImageView android:id="@+id/this_year_tick" android:layout_width="23dp" android:layout_height="23dp" android:src="@mipmap/ic_tick" android:tint="@color/textColorPrimary" android:layout_centerVertical="true" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/all_layout" android:layout_width="match_parent" android:layout_height="55dp">
            <TextView android:textSize="15sp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/all_time" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
            <ImageView android:id="@+id/all_tick" android:layout_width="23dp" android:layout_height="23dp" android:src="@mipmap/ic_tick" android:tint="@color/textColorPrimary" android:layout_centerVertical="true" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/self_layout" android:layout_width="match_parent" android:layout_height="55dp">
            <TextView android:textSize="15sp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/self" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
            <ImageView android:id="@+id/self_tick" android:layout_width="23dp" android:layout_height="23dp" android:src="@mipmap/ic_tick" android:tint="@color/textColorPrimary" android:layout_centerVertical="true" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/start_date_layout" android:layout_width="match_parent" android:layout_height="55dp">
            <TextView android:textSize="15sp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="开始时间" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
            <TextView android:textSize="15sp" android:textColor="@color/darkGrey" android:id="@+id/start_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2020-5-10" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/end_date_layout" android:layout_width="match_parent" android:layout_height="55dp">
            <TextView android:textSize="15sp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="结束时间" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
            <TextView android:textSize="15sp" android:textColor="@color/darkGrey" android:id="@+id/end_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2020-5-10" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>