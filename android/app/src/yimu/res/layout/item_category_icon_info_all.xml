<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
    <RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
        <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/textColorPrimary" android:id="@+id/icon_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:text="收入" android:layout_marginStart="10dp" />
        <TextView android:textSize="13sp" android:textColor="@color/textColorPrimary" android:id="@+id/more_icon" android:paddingTop="15dp" android:paddingBottom="5dp" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/go_category_share_tip" android:layout_marginStart="15dp" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/icon_list" android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>