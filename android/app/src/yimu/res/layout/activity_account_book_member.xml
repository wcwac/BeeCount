<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
        <TextView android:textSize="12sp" android:textColor="@color/grey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="15dp" android:text="创建者" />
        <RelativeLayout android:background="@color/white" android:padding="15dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <ImageView android:id="@+id/owner_photo" android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_launcher_no_color" android:layout_centerVertical="true" app:oval="true" />
            <TextView android:textSize="15sp" android:textColor="@color/black" android:id="@+id/owner_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="未知" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_toStartOf="@+id/user_edit" android:layout_toEndOf="@+id/owner_photo" />
            <ImageView android:id="@+id/user_edit" android:background="@drawable/selectable_item_circle" android:padding="5dp" android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_bill_edit" android:tint="@color/iconTint" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <TextView android:textSize="12sp" android:textColor="@color/grey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="15dp" android:text="成员" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/member_list" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>