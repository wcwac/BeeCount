<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:id="@+id/parent_layout" android:clipChildren="false" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never">
    <LinearLayout android:orientation="vertical" android:paddingBottom="30dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="vertical" android:id="@+id/chart_layout" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:orientation="vertical" android:id="@+id/recent_layout" android:background="@drawable/shape_bg_theme_content_5" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="10dp">
                    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/check_bar_mode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true">
                        <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/bar_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="近7日统计" />
                        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_checkout" android:tint="@color/black" android:layout_marginStart="5dp" />
                    </LinearLayout>
                    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/bg_statistics_bar_menu" android:layout_width="wrap_content" android:layout_height="22dp" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true">
                        <TextView android:textSize="11sp" android:gravity="center" android:id="@+id/bar_pay" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="支出" android:paddingStart="10dp" android:paddingEnd="10dp" />
                        <TextView android:textSize="11sp" android:gravity="center" android:id="@+id/bar_income" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="收入" android:paddingStart="10dp" android:paddingEnd="10dp" />
                    </LinearLayout>
                </RelativeLayout>
                <FrameLayout android:id="@+id/bar_chart" android:layout_width="match_parent" android:layout_height="150dp" android:layout_marginTop="10dp" />
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="10dp">
                    <TextView android:textSize="12sp" android:textColor="@color/black" android:id="@+id/total_pay" android:layout_width="0dp" android:layout_height="wrap_content" android:text="总支出：" android:singleLine="true" android:layout_weight="1" android:paddingEnd="10dp" />
                    <TextView android:textSize="12sp" android:textColor="@color/black" android:id="@+id/day_pay" android:layout_width="0dp" android:layout_height="wrap_content" android:text="日均支出：" android:singleLine="true" android:layout_weight="1" />
                </LinearLayout>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_marginEnd="10dp">
                    <TextView android:textSize="12sp" android:textColor="@color/black" android:id="@+id/total_income" android:layout_width="0dp" android:layout_height="wrap_content" android:text="总收入：" android:singleLine="true" android:layout_weight="1" android:paddingEnd="10dp" />
                    <TextView android:textSize="12sp" android:textColor="@color/black" android:id="@+id/day_income" android:layout_width="0dp" android:layout_height="wrap_content" android:text="日均收入：" android:singleLine="true" android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:id="@+id/asset_layout" android:background="@drawable/shape_bg_theme_content_5" android:paddingTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/asset_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp">
                        <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="资产汇总" />
                        <ImageView android:id="@+id/asset_arrow" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_bottom_small" android:tint="@color/black" android:layout_marginStart="5dp" />
                    </LinearLayout>
                    <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/pie_type_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true">
                        <TextView android:textSize="13sp" android:textColor="@color/textColorPrimary" android:id="@+id/pie_type_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="总资产" />
                        <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@mipmap/ic_bottom_small" android:tint="@color/grey" />
                    </LinearLayout>
                </RelativeLayout>
                <RelativeLayout android:layout_width="match_parent" android:layout_height="200dp">
                    <FrameLayout android:id="@+id/pie_asset_chart" android:layout_width="match_parent" android:layout_height="200dp" />
                    <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/asset_chart_check" android:layout_width="60dp" android:layout_height="wrap_content" android:layout_centerInParent="true">
                        <ImageView android:id="@+id/asset_chart_check_icon" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp" android:src="@mipmap/ic_checkout" android:tint="@color/darkGrey" />
                        <TextView android:textSize="10sp" android:textColor="@color/darkGrey" android:id="@+id/asset_chart_check_tip_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="资产占比" />
                    </LinearLayout>
                </RelativeLayout>
                <CheckBox android:textColor="@color/darkGrey" android:layout_gravity="end" android:id="@+id/filter_asset_check" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="过滤占比小于1%的资产" style="@style/autoCheckBox" />
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:id="@+id/budget_layout" android:background="@drawable/shape_bg_theme_content_5" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="255dp" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="25dp">
                    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/budget_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp">
                        <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="预算占比" />
                        <ImageView android:id="@+id/budget_arrow" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_bottom_small" android:tint="@color/black" android:layout_marginStart="5dp" />
                    </LinearLayout>
                    <TextView android:textSize="13sp" android:textColor="@color/textColorPrimary" android:id="@+id/budget_info" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="查看详情&gt;" android:layout_marginStart="6dp" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <FrameLayout android:id="@+id/pie_budget_chart" android:layout_width="match_parent" android:layout_height="200dp" />
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:id="@+id/tag_chart_layout" android:background="@drawable/shape_bg_theme_content_5" android:paddingTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp">
                    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/check_tag_mode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="10dp">
                        <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:layout_gravity="center_vertical" android:id="@+id/tag_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="标签数据" />
                        <TextView android:textSize="12sp" android:textColor="@color/grey" android:layout_gravity="center_vertical" android:id="@+id/tag_mode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="(近一月)" android:layout_marginStart="3dp" />
                        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_checkout" android:tint="@color/black" android:layout_marginStart="5dp" />
                    </LinearLayout>
                    <TextView android:textSize="13sp" android:textColor="@color/textColorPrimary" android:id="@+id/tag_info" android:layout_width="wrap_content" android:layout_height="22dp" android:text="查看全部&gt;" android:layout_marginStart="6dp" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/tag_data" android:layout_width="match_parent" android:layout_height="wrap_content" android:overScrollMode="never" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>