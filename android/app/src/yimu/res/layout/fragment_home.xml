<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/parent_layout" android:descendantFocusability="blocksDescendants" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/tip_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="60dp" android:layout_marginBottom="150dp" android:layout_alignParentBottom="true" android:layout_centerHorizontal="true">
        <include android:id="@+id/tip_image" android:layout_width="150dp" android:layout_height="150dp" layout="@layout/layout_home_tip" />
        <TextView android:textSize="14sp" android:textColor="@color/textGray" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="你还没有任何记账" />
        <TextView android:textSize="13sp" android:textColor="@color/grey" android:gravity="center" android:id="@+id/tip_text" android:layout_width="180dp" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="想记点什么？试试点击或长按右下方按钮进行快速记账" android:lineSpacingExtra="3dp" />
    </LinearLayout>
    <androidx.drawerlayout.widget.DrawerLayout android:id="@+id/drawer_layout" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@+id/tool_bar">
        <FrameLayout android:id="@+id/pull_layout" android:layout_width="match_parent" android:layout_height="match_parent" app:headerHeight="56dp" app:pullHeight="128dp" app:triggerHeight="96dp">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/data_list" android:paddingBottom="15dp" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
        </FrameLayout>
        <include android:layout_gravity="start" android:id="@+id/right_drawer_layout" android:layout_width="280dp" android:layout_height="match_parent" layout="@layout/layout_drawer_module" />
    </androidx.drawerlayout.widget.DrawerLayout>
    <RelativeLayout android:id="@+id/tool_bar" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="horizontal" android:id="@+id/account_book_layout" android:layout_width="wrap_content" android:layout_height="45dp" android:paddingStart="15dp">
            <ImageView android:id="@+id/account_book_icon" android:layout_width="22dp" android:layout_height="45dp" android:scaleType="centerInside" />
            <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/account_book_name" android:layout_width="wrap_content" android:layout_height="45dp" android:layout_marginStart="8dp" />
        </LinearLayout>
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="45dp" android:layout_alignParentEnd="true">
            <ProgressBar android:id="@+id/spin_kit" android:visibility="gone" android:layout_width="20dp" android:layout_height="20dp" app:SpinKit_Color="@color/colorPrimary" />
            <ImageView android:id="@+id/btn_add_bill" android:background="@drawable/selectable_item_circle" android:padding="9dp" android:visibility="gone" android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_menu_add_bill" android:tint="@color/textColorPrimary" />
            <ImageView android:id="@+id/btn_search" android:background="@drawable/selectable_item_circle" android:padding="11dp" android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_main_search" android:tint="@color/textColorPrimary" />
            <ImageView android:id="@+id/btn_more" android:background="@drawable/selectable_item_circle" android:padding="10dp" android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_menu" android:tint="@color/textColorPrimary" android:layout_marginEnd="5dp" />
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>