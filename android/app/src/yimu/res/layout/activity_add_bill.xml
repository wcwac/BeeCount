<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:background="@color/backgroundWhite" android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:id="@+id/tool_bar" android:layout_width="match_parent" android:layout_height="50dp">
        <ImageView android:id="@+id/btn_back" android:background="@drawable/selectable_item_circle" android:padding="16dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_back" android:scaleType="fitCenter" android:tint="@color/black" />
        <com.wangc.bill.reference.ui.ReferenceTabs android:layout_gravity="center_horizontal" android:id="@+id/tab_layout" android:layout_width="200dp" android:layout_height="match_parent" android:layout_toEndOf="@+id/btn_back" app:tabIndicatorHeight="3dp" app:tabMinWidth="50dp" app:tabMode="fixed" app:titleTextSize="15dp" />
        <TextView android:textSize="15sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:id="@+id/account_book_name" android:layout_width="match_parent" android:layout_height="match_parent" android:text="日常账本" android:singleLine="true" android:paddingEnd="15dp" android:layout_toEndOf="@+id/tab_layout" android:layout_alignParentEnd="true" />
        <TextView android:textSize="15sp" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/edit_btn" android:background="@drawable/selectable_item_circle" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="50dp" android:maxWidth="80dp" android:text="@string/edit" android:singleLine="true" android:paddingStart="10dp" android:paddingEnd="15dp" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <FrameLayout android:id="@+id/category_pager" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_above="@+id/tag_and_file" android:layout_below="@+id/tool_bar" />
    <LinearLayout android:orientation="vertical" android:id="@+id/tag_and_file" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_above="@+id/bottom_Layout">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/tag_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:overScrollMode="never" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/file_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:overScrollMode="never" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
    </LinearLayout>
    <LinearLayout android:orientation="vertical" android:id="@+id/bottom_Layout" android:background="@color/white" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentBottom="true">
        <View android:background="@color/divider" android:layout_width="match_parent" android:layout_height="1px" />
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/tag_btn" android:background="?android:attr/selectableItemBackground" android:layout_width="wrap_content" android:layout_height="45dp" android:layout_centerVertical="true" android:paddingStart="10dp" android:paddingEnd="10dp" android:layout_marginStart="6dp">
                <ImageView android:id="@+id/tag_btn_icon" android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_tag" android:tint="@color/black" />
                <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/tag_btn_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tags" android:layout_marginStart="5dp" />
            </LinearLayout>
            <EditText android:textSize="14sp" android:textColor="@color/darkGrey" android:textColorHint="@color/grey" android:gravity="bottom" android:id="@+id/remark" android:background="@color/transparent" android:paddingBottom="13dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxHeight="150dp" android:minHeight="45dp" android:hint="添加备注" android:singleLine="false" android:includeFontPadding="false" android:layout_centerVertical="true" android:paddingStart="10dp" android:layout_toStartOf="@+id/cost_layout" android:layout_toEndOf="@+id/tag_btn" />
            <EditText android:textSize="14sp" android:textColor="@color/darkGrey" android:textColorHint="@color/grey" android:gravity="bottom" android:id="@+id/tags" android:background="@color/transparent" android:paddingBottom="12dp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="45dp" android:hint="输入标签，空格结束" android:singleLine="true" android:includeFontPadding="false" android:layout_centerVertical="true" android:paddingStart="10dp" android:layout_toStartOf="@+id/cost_layout" android:layout_toEndOf="@+id/tag_btn" />
            <LinearLayout android:orientation="vertical" android:id="@+id/cost_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true">
                <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
                    <TextView android:textSize="14dp" android:textStyle="bold" android:textColor="@color/black" android:layout_gravity="bottom" android:id="@+id/symbol" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="2dp" android:text="¥" android:includeFontPadding="false" />
                    <TextView android:textSize="22dp" android:textStyle="bold" android:textColor="@color/moneyPay" android:gravity="end" android:id="@+id/cost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="200dp" android:text="0.00" android:singleLine="true" android:includeFontPadding="false" android:layout_marginStart="3dp" />
                </LinearLayout>
                <TextView android:textSize="11dp" android:textColor="@color/grey" android:layout_gravity="end" android:id="@+id/currency_asset_info" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="2dp" android:text="≈¥0.00" />
                <TextView android:textSize="11dp" android:textColor="@color/grey" android:layout_gravity="end" android:id="@+id/currency_info" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="2dp" android:text="≈¥0.00" />
            </LinearLayout>
        </RelativeLayout>
        <View android:background="@color/divider" android:layout_width="match_parent" android:layout_height="1px" />
        <HorizontalScrollView android:scrollbars="none" android:layout_width="match_parent" android:layout_height="45dp" android:overScrollMode="never">
            <LinearLayout android:orientation="horizontal" android:id="@+id/menu_layout" android:layout_width="match_parent" android:layout_height="45dp" android:paddingStart="6dp" android:paddingEnd="6dp">
                <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/date_layout" android:background="?android:attr/selectableItemBackground" android:layout_width="wrap_content" android:layout_height="match_parent" android:paddingStart="10dp">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_date_small" android:tint="@color/black" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="今天" android:paddingEnd="10dp" android:layout_marginStart="3dp" />
                </LinearLayout>
                <RelativeLayout android:id="@+id/asset_layout" android:background="?android:attr/selectableItemBackground" android:layout_width="wrap_content" android:layout_height="45dp" android:paddingStart="10dp">
                    <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/asset_info_layout" android:layout_width="wrap_content" android:layout_height="45dp">
                        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
                            <ImageView android:id="@+id/asset_icon" android:layout_width="16dp" android:layout_height="16dp" />
                            <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/asset_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="100dp" android:text="" android:singleLine="true" android:layout_marginStart="3dp" android:layout_marginEnd="10dp" />
                        </LinearLayout>
                        <TextView android:textSize="11dp" android:textColor="@color/red" android:id="@+id/asset_num_tip" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="余额不足" />
                    </LinearLayout>
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/group_asset_list" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="10dp" />
                </RelativeLayout>
                <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/reimbursement_layout" android:background="?android:attr/selectableItemBackground" android:layout_width="wrap_content" android:layout_height="45dp" android:paddingStart="10dp">
                    <ImageView android:id="@+id/reimbursement_icon" android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_data_no_baoxiao" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/reimbursement_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="100dp" android:text="不报销" android:singleLine="true" android:layout_marginStart="3dp" android:layout_marginEnd="10dp" />
                </LinearLayout>
                <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/add_file_layout" android:background="?android:attr/selectableItemBackground" android:layout_width="wrap_content" android:layout_height="45dp" android:paddingStart="10dp">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_file_small" android:tint="@color/black" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="80dp" android:text="附件" android:singleLine="true" android:layout_marginStart="3dp" android:layout_marginEnd="10dp" />
                </LinearLayout>
                <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/discount_layout" android:background="?android:attr/selectableItemBackground" android:layout_width="wrap_content" android:layout_height="45dp" android:paddingStart="10dp" android:paddingEnd="10dp">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_discount" android:tint="@color/black" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/discount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="优惠" android:singleLine="true" android:layout_marginStart="3dp" />
                    <TextView android:textSize="12sp" android:textColor="@color/grey" android:id="@+id/discount_currency" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:layout_marginStart="3dp" />
                </LinearLayout>
                <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/config_layout" android:background="?android:attr/selectableItemBackground" android:layout_width="wrap_content" android:layout_height="45dp" android:paddingStart="10dp">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_setting_add_bill" android:tint="@color/black" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="80dp" android:text="属性" android:singleLine="true" android:layout_marginStart="3dp" android:layout_marginEnd="10dp" />
                </LinearLayout>
                <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/lend_date_layout" android:background="?android:attr/selectableItemBackground" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="match_parent" android:paddingStart="10dp">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_repayment_date" android:tint="@color/black" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/lend_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="还款日期" android:paddingEnd="10dp" android:layout_marginStart="3dp" />
                </LinearLayout>
                <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/service_charge_layout" android:background="?android:attr/selectableItemBackground" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="45dp" android:paddingStart="10dp" android:paddingEnd="10dp">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_service_charge" android:tint="@color/black" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/service_charge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="手续费" android:singleLine="true" android:layout_marginStart="3dp" />
                    <TextView android:textSize="12sp" android:textColor="@color/grey" android:id="@+id/service_charge_currency" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:layout_marginStart="3dp" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>
        <com.wangc.bill.reference.ui.NumberKeyboard android:id="@+id/number_key_board" android:layout_width="match_parent" android:layout_height="220dp" />
    </LinearLayout>
</RelativeLayout>