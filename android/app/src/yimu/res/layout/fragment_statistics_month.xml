<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="horizontal" android:background="@color/white" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="horizontal" android:id="@+id/current_year_layout" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginTop="6dp" android:layout_marginStart="20dp">
            <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/current_year" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2020年" />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/month_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:overScrollMode="never" android:layout_marginStart="8dp" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never">
        <LinearLayout android:orientation="vertical" android:paddingBottom="30dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_budget" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/pay_layout" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                        <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:id="@+id/pay_num_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="月支出" />
                        <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/pay_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:singleLine="true" android:shadowColor="@color/colorPrimaryDark" />
                    </LinearLayout>
                    <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/income_layout" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                        <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:id="@+id/income_num_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="月收入" />
                        <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/income_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:singleLine="true" android:shadowColor="@color/colorPrimaryDark" />
                    </LinearLayout>
                    <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/balance_layout" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                        <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="月结余" />
                        <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/balance_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:singleLine="true" android:shadowColor="@color/colorPrimaryDark" />
                    </LinearLayout>
                </LinearLayout>
                <include android:id="@+id/statistics_info_layout" android:visibility="gone" layout="@layout/layout_statistics_info_more" />
                <ImageView android:layout_gravity="center_horizontal" android:id="@+id/more_info" android:padding="4dp" android:layout_width="120dp" android:layout_height="25dp" android:src="@mipmap/ic_bottom_small" android:tint="@color/textColorLight" />
            </LinearLayout>
            <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <LinearLayout android:orientation="vertical" android:id="@+id/chart_layout" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <RelativeLayout android:id="@+id/bar_layout" android:background="@drawable/shape_bg_theme_content_5" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/bar_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp">
                            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="收支统计" />
                            <ImageView android:id="@+id/bar_arrow" android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_chart_expand" android:tint="@color/black" android:layout_marginStart="4dp" />
                        </LinearLayout>
                        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/bar_menu" android:background="@drawable/bg_statistics_bar_menu" android:layout_width="wrap_content" android:layout_height="22dp" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true">
                            <TextView android:textSize="11sp" android:gravity="center" android:id="@+id/bar_pay" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="支出" android:paddingStart="10dp" android:paddingEnd="10dp" />
                            <TextView android:textSize="11sp" android:gravity="center" android:id="@+id/bar_income" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="收入" android:paddingStart="10dp" android:paddingEnd="10dp" />
                            <TextView android:textSize="11sp" android:gravity="center" android:id="@+id/bar_balance" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="结余" android:paddingStart="10dp" android:paddingEnd="10dp" />
                        </LinearLayout>
                        <FrameLayout android:id="@+id/bar_chart" android:layout_width="match_parent" android:layout_height="150dp" android:layout_marginTop="10dp" android:layout_below="@+id/bar_title" />
                    </RelativeLayout>
                    <RelativeLayout android:id="@+id/line_layout" android:background="@drawable/shape_bg_theme_content_5" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/line_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp">
                            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="资产走势" />
                            <ImageView android:id="@+id/line_arrow" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_bottom_small" android:tint="@color/black" android:layout_marginStart="5dp" />
                        </LinearLayout>
                        <FrameLayout android:id="@+id/line_chart" android:layout_width="match_parent" android:layout_height="150dp" android:layout_marginTop="10dp" android:layout_below="@+id/line_title" />
                    </RelativeLayout>
                    <LinearLayout android:orientation="vertical" android:id="@+id/member_layout" android:background="@drawable/shape_bg_theme_content_5" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="255dp" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="成员收支" android:layout_marginStart="10dp" />
                            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/bg_statistics_bar_menu" android:layout_width="wrap_content" android:layout_height="22dp" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true">
                                <TextView android:textSize="11sp" android:gravity="center" android:id="@+id/member_pay" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="支出" android:paddingStart="10dp" android:paddingEnd="10dp" />
                                <TextView android:textSize="11sp" android:gravity="center" android:id="@+id/member_income" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="收入" android:paddingStart="10dp" android:paddingEnd="10dp" />
                            </LinearLayout>
                        </RelativeLayout>
                        <RelativeLayout android:layout_width="match_parent" android:layout_height="200dp">
                            <FrameLayout android:id="@+id/pie_member_chart" android:layout_width="match_parent" android:layout_height="200dp" />
                            <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/member_chart_check" android:layout_width="60dp" android:layout_height="wrap_content" android:layout_centerInParent="true">
                                <ImageView android:id="@+id/asset_chart_check_icon" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp" android:src="@mipmap/ic_checkout" android:tint="@color/black" />
                                <TextView android:textSize="10sp" android:textColor="@color/black" android:id="@+id/member_chart_check_tip_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="支出占比" />
                            </LinearLayout>
                        </RelativeLayout>
                    </LinearLayout>
                    <RelativeLayout android:id="@+id/category_chart_layout" android:background="@drawable/shape_bg_theme_content_5" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/check_pie_mode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp">
                            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/pie_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="分类占比" />
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_checkout" android:tint="@color/black" android:layout_marginStart="5dp" />
                        </LinearLayout>
                        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/category_pie_menu" android:background="@drawable/bg_statistics_bar_menu" android:layout_width="wrap_content" android:layout_height="22dp" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true">
                            <TextView android:textSize="11sp" android:gravity="center" android:id="@+id/pie_parent" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="一级分类" android:paddingStart="10dp" android:paddingEnd="10dp" />
                            <TextView android:textSize="11sp" android:gravity="center" android:id="@+id/pie_all" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="全部" android:paddingStart="10dp" android:paddingEnd="10dp" />
                        </LinearLayout>
                        <RelativeLayout android:id="@+id/pie_chart_layout" android:layout_width="match_parent" android:layout_height="200dp" android:layout_below="@+id/category_pie_menu">
                            <FrameLayout android:id="@+id/pie_chart" android:layout_width="match_parent" android:layout_height="match_parent" />
                            <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/pie_chart_check" android:layout_width="60dp" android:layout_height="wrap_content" android:layout_centerInParent="true">
                                <TextView android:textSize="11sp" android:textColor="@color/black" android:id="@+id/pie_chart_check_text" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                                <ImageView android:id="@+id/pie_chart_check_icon" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp" android:src="@mipmap/ic_checkout" android:tint="@color/black" />
                                <TextView android:textSize="10sp" android:textColor="@color/black" android:id="@+id/pie_chart_check_tip_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="切换到收入" />
                            </LinearLayout>
                        </RelativeLayout>
                        <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_below="@+id/pie_chart_layout" android:layout_alignParentEnd="true">
                            <CheckBox android:textColor="@color/darkGrey" android:id="@+id/category_num_check" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="false" android:text="显示收支金额" style="@style/autoCheckBox" />
                            <CheckBox android:textColor="@color/darkGrey" android:id="@+id/filter_category_check" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="过滤占比小于1%的分类" style="@style/autoCheckBox" />
                        </LinearLayout>
                    </RelativeLayout>
                    <RelativeLayout android:orientation="vertical" android:id="@+id/category_data_layout" android:background="@drawable/shape_bg_theme_content_5" android:paddingTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/data_title_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:layout_marginStart="10dp">
                            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/data_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="分类数据" />
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_checkout" android:tint="@color/black" android:layout_marginStart="5dp" />
                        </LinearLayout>
                        <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/textColorPrimary" android:id="@+id/view_all_bill" android:layout_width="wrap_content" android:layout_height="25dp" android:text="当月账单&gt;" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
                        <androidx.recyclerview.widget.RecyclerView android:id="@+id/bill_data" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@+id/data_title_layout" android:overScrollMode="never" />
                    </RelativeLayout>
                    <LinearLayout android:orientation="vertical" android:id="@+id/form_layout" android:background="@drawable/shape_bg_theme_content_5" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/date_form_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="报表统计" android:layout_centerVertical="true" android:layout_marginStart="10dp" />
                            <ImageView android:id="@+id/form_sort_btn" android:background="@drawable/selectable_item_circle" android:padding="11dp" android:layout_width="38dp" android:layout_height="38dp" android:src="@mipmap/ic_sort" android:tint="@color/black" android:layout_alignParentEnd="true" />
                        </RelativeLayout>
                        <LinearLayout android:orientation="horizontal" android:id="@+id/date_form_header" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="10dp">
                            <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" android:id="@+id/date" android:layout_width="0dp" android:layout_height="match_parent" android:text="日期" android:layout_weight="1" />
                            <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" android:id="@+id/income" android:layout_width="0dp" android:layout_height="match_parent" android:text="收入" android:layout_weight="1" />
                            <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" android:id="@+id/pay" android:layout_width="0dp" android:layout_height="match_parent" android:text="支出" android:layout_weight="1" />
                            <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" android:id="@+id/balance" android:layout_width="0dp" android:layout_height="match_parent" android:text="结余" android:layout_weight="1" />
                        </LinearLayout>
                        <androidx.recyclerview.widget.RecyclerView android:id="@+id/day_form_data" android:layout_width="match_parent" android:layout_height="wrap_content" android:overScrollMode="never" />
                    </LinearLayout>
                    <RelativeLayout android:id="@+id/tag_chart_layout" android:background="@drawable/shape_bg_theme_content_5" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                        <RelativeLayout android:gravity="center_vertical" android:id="@+id/tag_pie_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="10dp">
                            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="标签占比" />
                            <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/tag_type_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true">
                                <TextView android:textSize="13sp" android:textColor="@color/textColorPrimary" android:id="@+id/tag_type_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="所有标签" />
                                <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@mipmap/ic_bottom_small" android:tint="@color/grey" />
                            </LinearLayout>
                        </RelativeLayout>
                        <RelativeLayout android:id="@+id/tag_pie_layout" android:layout_width="match_parent" android:layout_height="200dp" android:layout_below="@+id/tag_pie_title">
                            <FrameLayout android:id="@+id/tag_pie_chart" android:layout_width="match_parent" android:layout_height="match_parent" />
                            <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/tag_chart_check" android:layout_width="60dp" android:layout_height="wrap_content" android:layout_centerInParent="true">
                                <TextView android:textSize="12sp" android:textColor="@color/black" android:id="@+id/tag_chart_check_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="支出" />
                                <ImageView android:id="@+id/tag_chart_check_icon" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp" android:src="@mipmap/ic_checkout" android:tint="@color/black" />
                                <TextView android:textSize="10sp" android:textColor="@color/black" android:id="@+id/tag_chart_check_tip_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="点击切换" />
                            </LinearLayout>
                        </RelativeLayout>
                        <CheckBox android:textColor="@color/darkGrey" android:id="@+id/tag_num_check" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="false" android:text="显示标签金额" android:layout_below="@+id/tag_pie_layout" android:layout_alignParentEnd="true" style="@style/autoCheckBox" />
                    </RelativeLayout>
                    <RelativeLayout android:orientation="vertical" android:id="@+id/tag_data_layout" android:background="@drawable/shape_bg_theme_content_5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                        <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/tag_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="10dp" android:text="标签数据" android:layout_marginStart="10dp" />
                        <ImageView android:id="@+id/tag_sort_btn" android:background="@drawable/selectable_item_circle" android:padding="11dp" android:layout_width="38dp" android:layout_height="38dp" android:src="@mipmap/ic_sort" android:tint="@color/black" android:layout_alignParentEnd="true" />
                        <androidx.recyclerview.widget.RecyclerView android:id="@+id/tag_data" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@+id/tag_title" android:overScrollMode="never" />
                    </RelativeLayout>
                    <LinearLayout android:orientation="vertical" android:id="@+id/month_content_layout" android:background="@drawable/shape_bg_theme_content_5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/content_expand" android:layout_width="wrap_content" android:layout_height="38dp">
                                <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/content_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="本月总结" android:layout_marginStart="10dp" />
                                <ImageView android:visibility="gone" android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_chart_expand" android:tint="@color/black" android:layout_marginStart="4dp" />
                            </LinearLayout>
                            <ImageView android:id="@+id/content_copy" android:background="@drawable/selectable_item_circle" android:padding="10dp" android:visibility="gone" android:layout_width="38dp" android:layout_height="38dp" android:src="@mipmap/ic_content_copy" android:tint="@color/black" android:layout_toStartOf="@+id/content_edit" />
                            <ImageView android:id="@+id/content_edit" android:background="@drawable/selectable_item_circle" android:padding="10dp" android:visibility="gone" android:layout_width="38dp" android:layout_height="38dp" android:src="@mipmap/ic_edit" android:tint="@color/black" android:layout_alignParentEnd="true" />
                        </RelativeLayout>
                        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                            <FrameLayout android:id="@+id/markdown_view" android:paddingBottom="10dp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" />
                            <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/content_tip_layout" android:paddingBottom="15dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true">
                                <include android:layout_width="90dp" android:layout_height="90dp" layout="@layout/layout_common_tip" />
                                <TextView android:textSize="13sp" android:textColor="@color/textGray" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="点击填写本月总结" />
                            </LinearLayout>
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>