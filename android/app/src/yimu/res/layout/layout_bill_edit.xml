<?xml version='1.0' encoding='utf-8'?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/white" app:cardCornerRadius="0dp" app:cardElevation="8dp">
    <RelativeLayout android:layout_width="match_parent" android:layout_height="60dp">
        <TextView android:textSize="13sp" android:textColor="@color/textColorPrimary" android:gravity="center" android:id="@+id/choice_all" android:background="?android:attr/selectableItemBackgroundBorderless" android:layout_width="wrap_content" android:layout_height="50dp" android:text="全选" android:layout_centerVertical="true" android:paddingStart="12dp" android:paddingEnd="12dp" />
        <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="45dp" android:layout_centerVertical="true" android:layout_alignParentEnd="true">
            <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/bill_group" android:background="@drawable/selectable_item_circle" android:layout_width="40dp" android:layout_height="45dp">
                <ImageView android:padding="0.5dp" android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_bill_group" android:tint="@color/black" />
                <TextView android:textSize="11sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="组合" />
            </LinearLayout>
            <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/bill_statistics" android:background="@drawable/selectable_item_circle" android:layout_width="40dp" android:layout_height="45dp">
                <ImageView android:padding="0.5dp" android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_edit_chart" android:tint="@color/black" />
                <TextView android:textSize="11sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="统计" />
            </LinearLayout>
            <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/bill_export" android:background="@drawable/selectable_item_circle" android:layout_width="40dp" android:layout_height="45dp">
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_edit_export" android:tint="@color/black" />
                <TextView android:textSize="11sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="导出" />
            </LinearLayout>
            <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/bill_edit" android:background="@drawable/selectable_item_circle" android:layout_width="40dp" android:layout_height="45dp">
                <ImageView android:id="@+id/ic_bill_edit" android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_edit_edit" android:tint="@color/black" />
                <TextView android:textSize="11sp" android:textColor="@color/black" android:id="@+id/bill_edit_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="编辑" />
            </LinearLayout>
            <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/bill_reimbursement" android:background="@drawable/selectable_item_circle" android:visibility="gone" android:layout_width="40dp" android:layout_height="45dp">
                <ImageView android:id="@+id/ic_bill_reimbursement" android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_edit_reimbursement" android:tint="@color/black" />
                <TextView android:textSize="11sp" android:textColor="@color/black" android:id="@+id/bill_reimbursement_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="报销" />
            </LinearLayout>
            <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/bill_delete" android:background="@drawable/selectable_item_circle" android:layout_width="40dp" android:layout_height="45dp">
                <ImageView android:id="@+id/ic_delete" android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_edit_delete" android:tint="@color/black" />
                <TextView android:textSize="11sp" android:textColor="@color/black" android:id="@+id/delete_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="删除" />
            </LinearLayout>
            <ImageView android:layout_gravity="center_vertical" android:id="@+id/complete" android:background="@drawable/selectable_item_circle" android:padding="12dp" android:layout_width="40dp" android:layout_height="45dp" android:src="@mipmap/ic_edit_complete" android:tint="@color/black" />
        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>