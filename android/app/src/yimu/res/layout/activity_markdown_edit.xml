<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/parent_layout" android:background="@color/white" android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:id="@+id/tool_bar" android:background="@color/white" android:layout_width="match_parent" android:layout_height="50dp">
        <ImageView android:id="@+id/btn_back" android:background="@drawable/selectable_item_circle" android:padding="16dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_back" android:scaleType="fitCenter" android:tint="@color/black" />
        <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="50dp" android:maxWidth="200dp" android:text="Markdown" android:singleLine="true" android:layout_toEndOf="@+id/btn_back" />
        <ImageView android:id="@+id/right_icon" android:background="@drawable/selectable_item_circle" android:padding="12dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_tick" android:scaleType="fitXY" android:tint="@color/black" android:layout_alignParentEnd="true" />
        <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/right_text" android:background="@drawable/selectable_item_circle" android:layout_width="wrap_content" android:layout_height="50dp" android:text="预览" android:singleLine="true" android:paddingStart="10dp" android:paddingEnd="10dp" android:layout_toStartOf="@+id/right_icon" />
        <ImageView android:id="@+id/btn_help" android:background="@drawable/selectable_item_circle" android:padding="14dp" android:layout_width="45dp" android:layout_height="45dp" android:src="@mipmap/ic_tip" android:scaleType="fitXY" android:tint="@color/black" android:layout_centerVertical="true" android:layout_toStartOf="@+id/right_text" />
    </RelativeLayout>
    <EditText android:textSize="15sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:gravity="start|top" android:id="@+id/markdown_edit" android:background="@color/transparent" android:paddingTop="15dp" android:layout_width="match_parent" android:layout_height="match_parent" android:hint="请输入内容" android:layout_above="@+id/bottom_layout" android:layout_below="@+id/tool_bar" android:lineSpacingExtra="8dp" android:paddingStart="15dp" android:paddingEnd="15dp" />
    <FrameLayout android:id="@+id/markdown_view" android:background="@color/white" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_above="@+id/bottom_layout" android:layout_below="@+id/tool_bar" />
    <LinearLayout android:orientation="vertical" android:id="@+id/bottom_layout" android:background="@color/white" android:scrollbars="none" android:layout_width="match_parent" android:layout_height="70dp" android:layout_alignParentBottom="true">
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="35dp">
            <ImageView android:id="@+id/btn_bold" android:background="@drawable/selectable_item_circle" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_width="0dp" android:layout_height="match_parent" android:src="@mipmap/ic_format_bold" android:tint="@color/black" android:layout_weight="1" />
            <ImageView android:id="@+id/btn_italic" android:background="@drawable/selectable_item_circle" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_width="0dp" android:layout_height="match_parent" android:src="@mipmap/ic_format_italic" android:tint="@color/black" android:layout_weight="1" />
            <ImageView android:id="@+id/btn_strikethrough" android:background="@drawable/selectable_item_circle" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_width="0dp" android:layout_height="match_parent" android:src="@mipmap/ic_format_strikethrough" android:tint="@color/black" android:layout_weight="1" />
            <ImageView android:id="@+id/btn_title_one" android:background="@drawable/selectable_item_circle" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_width="0dp" android:layout_height="match_parent" android:src="@mipmap/ic_markdown_title_one" android:tint="@color/black" android:layout_weight="1" />
            <ImageView android:id="@+id/btn_title_two" android:background="@drawable/selectable_item_circle" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_width="0dp" android:layout_height="match_parent" android:src="@mipmap/ic_markdown_title_two" android:tint="@color/black" android:layout_weight="1" />
            <ImageView android:id="@+id/btn_title_three" android:background="@drawable/selectable_item_circle" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_width="0dp" android:layout_height="match_parent" android:src="@mipmap/ic_markdown_title_three" android:tint="@color/black" android:layout_weight="1" />
            <ImageView android:id="@+id/btn_title_four" android:background="@drawable/selectable_item_circle" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_width="0dp" android:layout_height="match_parent" android:src="@mipmap/ic_markdown_title_four" android:tint="@color/black" android:layout_weight="1" />
            <ImageView android:id="@+id/btn_divider" android:background="@drawable/selectable_item_circle" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_width="0dp" android:layout_height="match_parent" android:src="@mipmap/ic_divider_solid" android:tint="@color/black" android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="35dp">
            <ImageView android:id="@+id/btn_quote" android:background="@drawable/selectable_item_circle" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_width="0dp" android:layout_height="match_parent" android:src="@mipmap/ic_format_quote" android:tint="@color/black" android:layout_weight="1" />
            <ImageView android:id="@+id/btn_check" android:background="@drawable/selectable_item_circle" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_width="0dp" android:layout_height="match_parent" android:src="@mipmap/ic_format_bullet" android:tint="@color/black" android:layout_weight="1" />
            <ImageView android:id="@+id/btn_number" android:background="@drawable/selectable_item_circle" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_width="0dp" android:layout_height="match_parent" android:src="@mipmap/ic_format_number" android:tint="@color/black" android:layout_weight="1" />
            <ImageView android:id="@+id/btn_link" android:background="@drawable/selectable_item_circle" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_width="0dp" android:layout_height="match_parent" android:src="@mipmap/ic_link" android:tint="@color/black" android:layout_weight="1" />
            <ImageView android:id="@+id/btn_image" android:background="@drawable/selectable_item_circle" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_width="0dp" android:layout_height="match_parent" android:src="@mipmap/ic_image" android:tint="@color/black" android:layout_weight="1" />
            <ImageView android:id="@+id/btn_table" android:background="@drawable/selectable_item_circle" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_width="0dp" android:layout_height="match_parent" android:src="@mipmap/ic_table" android:tint="@color/black" android:layout_weight="1" />
            <ImageView android:id="@+id/btn_line_code" android:background="@drawable/selectable_item_circle" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_width="0dp" android:layout_height="match_parent" android:src="@mipmap/ic_line_code" android:tint="@color/black" android:layout_weight="1" />
            <ImageView android:id="@+id/btn_code" android:background="@drawable/selectable_item_circle" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_width="0dp" android:layout_height="match_parent" android:src="@mipmap/ic_format_code" android:tint="@color/black" android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>