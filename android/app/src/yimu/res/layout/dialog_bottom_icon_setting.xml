<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:id="@+id/parent_layout" android:background="@drawable/bg_add_bill_dialog" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="10dp" android:text="设置图标" android:paddingStart="15dp" />
    <RelativeLayout android:id="@+id/set_light_icon" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="56dp">
        <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="设置日间图标" android:layout_centerInParent="true" android:layout_marginStart="15dp" />
    </RelativeLayout>
    <RelativeLayout android:id="@+id/set_night_icon" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="56dp">
        <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="设置夜间图标" android:layout_centerInParent="true" android:layout_marginStart="15dp" />
    </RelativeLayout>
    <RelativeLayout android:id="@+id/system_icon" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="56dp">
        <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="恢复默认" android:layout_centerInParent="true" android:layout_marginStart="15dp" />
    </RelativeLayout>
    <RelativeLayout android:id="@+id/cancel" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="56dp">
        <TextView android:textSize="15sp" android:textColor="@color/grey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="取消" android:layout_centerInParent="true" android:layout_marginStart="15dp" />
    </RelativeLayout>
</LinearLayout>