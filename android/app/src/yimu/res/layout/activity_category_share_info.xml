<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:id="@+id/tool_bar" android:background="@color/white" android:layout_width="match_parent" android:layout_height="50dp">
        <ImageView android:id="@+id/btn_back" android:background="@drawable/selectable_item_circle" android:padding="16dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_back" android:scaleType="fitCenter" android:tint="@color/black" />
        <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="50dp" android:maxWidth="180dp" android:text="图标分享" android:singleLine="true" android:layout_toEndOf="@+id/btn_back" />
        <TextView android:textSize="14sp" android:textColor="@color/textColorPrimary" android:gravity="center" android:id="@+id/choice_all" android:layout_width="wrap_content" android:layout_height="50dp" android:text="全选" android:paddingStart="10dp" android:paddingEnd="10dp" android:layout_toStartOf="@+id/ic_complete" />
        <ImageView android:id="@+id/ic_complete" android:background="@drawable/selectable_item_circle" android:padding="12dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_tick" android:scaleType="fitXY" android:tint="@color/black" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@+id/tool_bar">
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textSize="12sp" android:textColor="@color/darkGrey" android:id="@+id/tip_text" android:paddingTop="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="提示：点击可编辑分类，导入后将覆盖同级同名分类，分类不存在则直接创建。如您仅想替换分类图标，点击此处快捷替换" android:lineSpacingExtra="5dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/data_list" android:paddingTop="15dp" android:clipChildren="false" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>