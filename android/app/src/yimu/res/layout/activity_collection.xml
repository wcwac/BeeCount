<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:id="@+id/tool_bar" android:background="@color/white" android:layout_width="match_parent" android:layout_height="50dp">
        <ImageView android:id="@+id/btn_back" android:background="@drawable/selectable_item_circle" android:padding="17dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_close" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" />
        <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="180dp" android:text="收款" android:singleLine="true" android:layout_centerVertical="true" android:layout_toEndOf="@+id/btn_back" />
        <ImageView android:id="@+id/btn_delete" android:background="@drawable/selectable_item_circle" android:padding="14dp" android:visibility="gone" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_delete" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" android:layout_toStartOf="@+id/btn_complete" />
        <ImageView android:id="@+id/btn_complete" android:background="@drawable/selectable_item_circle" android:padding="12dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_tick" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never">
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp">
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="15dp" android:layout_marginEnd="15dp">
                        <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:id="@+id/content_title" android:layout_width="wrap_content" android:layout_height="50dp" android:text="债务" />
                        <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:id="@+id/type_title" android:layout_width="wrap_content" android:layout_height="50dp" android:text="金额" />
                        <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:id="@+id/interest_title" android:layout_width="wrap_content" android:layout_height="50dp" android:text="利息" />
                        <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:id="@+id/remark_title" android:layout_width="wrap_content" android:layout_height="50dp" android:text="备注" />
                    </LinearLayout>
                    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <RelativeLayout android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginEnd="15dp">
                            <TextView android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:gravity="center_vertical" android:id="@+id/type_content" android:background="@color/translate" android:layout_width="match_parent" android:layout_height="50dp" android:singleLine="true" />
                        </RelativeLayout>
                        <RelativeLayout android:layout_width="match_parent" android:layout_height="50dp">
                            <EditText android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/type_number" android:background="@color/translate" android:layout_width="match_parent" android:layout_height="50dp" android:hint="请输入收款金额" android:singleLine="true" android:inputType="numberDecimal" android:layout_toStartOf="@+id/currency_num_info" />
                            <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/currency_num_info" android:visibility="invisible" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/btn_clear" />
                            <ImageView android:id="@+id/btn_clear" android:background="@drawable/selectable_item_circle" android:padding="8dp" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_clear" android:tint="@color/iconTint" android:layout_centerVertical="true" android:layout_marginEnd="8dp" android:layout_alignParentEnd="true" />
                        </RelativeLayout>
                        <RelativeLayout android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginEnd="15dp">
                            <EditText android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/type_interest" android:background="@color/translate" android:layout_width="match_parent" android:layout_height="50dp" android:hint="利息将会累加到收款账户，优惠负数" android:singleLine="true" android:inputType="numberDecimal" android:layout_toStartOf="@+id/currency_interest_info" />
                            <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/currency_interest_info" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_alignParentEnd="true" />
                        </RelativeLayout>
                        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginEnd="15dp">
                            <EditText android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/remark" android:background="@color/translate" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp" android:hint="请输入备注" />
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="15dp">
                        <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:id="@+id/temp_title" android:visibility="invisible" android:layout_width="wrap_content" android:layout_height="50dp" android:text="利息" />
                        <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:id="@+id/file_title" android:layout_width="wrap_content" android:layout_height="50dp" android:text="附件" android:layout_alignEnd="@+id/temp_title" />
                    </RelativeLayout>
                    <RelativeLayout android:id="@+id/file_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp" android:layout_marginStart="15dp">
                        <androidx.recyclerview.widget.RecyclerView android:id="@+id/file_list" android:paddingBottom="5dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" />
                        <TextView android:textSize="14sp" android:textColor="@color/grey" android:gravity="center_vertical" android:id="@+id/add_file_tip" android:layout_width="wrap_content" android:layout_height="50dp" android:text="点击添加" />
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                <RelativeLayout android:id="@+id/collection_date_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="50dp" android:paddingEnd="10dp">
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="收款日期" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
                    <ImageView android:id="@+id/collection_date_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                    <TextView android:textSize="13sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:gravity="center" android:id="@+id/collection_date" android:layout_width="wrap_content" android:layout_height="50dp" android:hint="选择日期" android:singleLine="true" android:layout_toStartOf="@+id/collection_date_more" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/choice_asset_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="55dp">
                    <LinearLayout android:orientation="vertical" android:id="@+id/choice_asset_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="15dp">
                        <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="收款账户" />
                        <TextView android:textSize="12sp" android:textColor="@color/grey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="会从此账户累加收款金额和利息" />
                    </LinearLayout>
                    <TextView android:textSize="13sp" android:textColor="@color/black" android:gravity="end" android:id="@+id/asset_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="无账户" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/ic_more" android:layout_toEndOf="@+id/choice_asset_title" />
                    <ImageView android:id="@+id/ic_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/general_bill_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="55dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="20dp" android:layout_toStartOf="@+id/switch_add_bill">
                        <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/add_bill_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="生成收款账单" />
                        <TextView android:textSize="12sp" android:textColor="@color/grey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="选择生成账单后将会计入收支" android:singleLine="true" />
                    </LinearLayout>
                    <Switch android:id="@+id/switch_add_bill" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="false" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/bill_category" android:background="@drawable/selectable_item_expand_mask" android:visibility="gone" android:layout_width="match_parent" android:layout_height="55dp">
                    <TextView android:textSize="14sp" android:textColor="@color/darkGrey" android:id="@+id/bill_category_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="账单分类" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
                    <TextView android:textSize="13sp" android:textColor="@color/darkGrey" android:gravity="end" android:id="@+id/category_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="无账户" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/bill_category_more" android:layout_toEndOf="@+id/bill_category_title" />
                    <ImageView android:id="@+id/bill_category_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/bill_currency_cost_layout" android:background="@drawable/selectable_item_expand_mask" android:visibility="gone" android:layout_width="match_parent" android:layout_height="55dp">
                    <TextView android:textSize="14sp" android:textColor="@color/darkGrey" android:id="@+id/bill_currency_cost_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="账单金额" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
                    <LinearLayout android:gravity="end" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/bill_currency_cost_more" android:layout_toEndOf="@+id/bill_currency_cost_title">
                        <TextView android:textSize="14sp" android:textColor="@color/darkGrey" android:id="@+id/bill_currency_asset_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="11" android:singleLine="true" />
                        <TextView android:textSize="12sp" android:textColor="@color/grey" android:id="@+id/bill_currency_cost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="≈12" android:singleLine="true" />
                    </LinearLayout>
                    <ImageView android:id="@+id/bill_currency_cost_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>