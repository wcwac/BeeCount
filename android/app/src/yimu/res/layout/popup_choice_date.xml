<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/parent_layout" android:layout_width="match_parent" android:layout_height="match_parent">
    <ScrollView android:background="@drawable/dialog_user_agreement_bg" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerInParent="true" android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="55dp">
                    <TextView android:textSize="25sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/tv_month_day" android:layout_width="wrap_content" android:layout_height="match_parent" android:paddingStart="25dp" />
                    <LinearLayout android:orientation="vertical" android:paddingLeft="6dp" android:paddingTop="12dp" android:paddingRight="6dp" android:paddingBottom="12dp" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_toEndOf="@+id/tv_month_day">
                        <TextView android:textSize="10sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/tv_year" android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1" />
                        <TextView android:textSize="10sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/tv_lunar" android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1" />
                    </LinearLayout>
                </RelativeLayout>
                <com.wangc.bill.reference.ui.ReferenceCalendar android:id="@+id/calendarView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" app:calendar_padding="10dp" app:current_day_lunar_text_color="@color/colorPrimary" app:current_day_text_color="@color/colorPrimary" app:current_month_lunar_text_color="@color/grey" app:current_month_text_color="@color/darkGrey" app:max_year="2099" app:min_year="1980" app:month_view="com.wangc.bill.calendar.CustomMonthView" app:month_view_show_mode="mode_only_current" app:selected_lunar_text_color="@color/white" app:selected_text_color="@color/white" />
            </LinearLayout>
            <LinearLayout android:gravity="center" android:layout_gravity="center_horizontal" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp">
                <FrameLayout android:id="@+id/hour_picker" android:layout_width="80dp" android:layout_height="140dp" android:layout_marginStart="20dp" />
                <TextView android:textSize="25dp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/hour_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=":" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
                <FrameLayout android:id="@+id/minute_picker" android:layout_width="80dp" android:layout_height="140dp" android:layout_marginEnd="20dp" />
            </LinearLayout>
            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="20dp">
                <TextView android:textSize="15sp" android:textColor="@color/textGray" android:gravity="center" android:id="@+id/cancel" android:background="@drawable/selectable_item_expand_mask" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/cancel" android:layout_weight="1" />
                <TextView android:textSize="15sp" android:textColor="@color/colorPrimaryText" android:gravity="center" android:id="@+id/confirm" android:background="@drawable/selectable_item_expand_mask" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/confirm" android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>