<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/total_layout" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:paddingBottom="60dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/banner_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp">
            <LinearLayout android:gravity="center_vertical" android:orientation="vertical" android:id="@+id/home_background" android:layout_width="match_parent" android:layout_height="0dp" android:layout_margin="15dp" android:paddingStart="15dp" android:paddingEnd="15dp" app:layout_constraintDimensionRatio="980:376" app:layout_constraintLeft_toLeftOf="parent" app:layout_constraintRight_toRightOf="parent" app:layout_constraintTop_toTopOf="parent">
                <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
                    <LinearLayout android:orientation="vertical" android:id="@+id/one_layout_current" android:layout_width="wrap_content" android:layout_height="wrap_content">
                        <TextView android:textSize="13sp" android:textColor="@color/textGray" android:id="@+id/month_income_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="本月收入" android:singleLine="true" />
                        <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="@color/darkGrey" android:id="@+id/month_income" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:singleLine="true" />
                    </LinearLayout>
                    <LinearLayout android:orientation="vertical" android:id="@+id/two_layout_current" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="25dp">
                        <TextView android:textSize="13sp" android:textColor="@color/textGray" android:id="@+id/month_balance_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="本月结余" android:singleLine="true" />
                        <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="@color/darkGrey" android:id="@+id/month_balance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:singleLine="true" />
                    </LinearLayout>
                    <LinearLayout android:orientation="vertical" android:id="@+id/three_layout_current" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="25dp">
                        <TextView android:textSize="13sp" android:textColor="@color/textGray" android:id="@+id/month_budget_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="剩余预算" android:singleLine="true" />
                        <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="@color/darkGrey" android:id="@+id/month_budget" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:singleLine="true" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:orientation="vertical" android:id="@+id/four_layout_current" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp">
                    <TextView android:textSize="13sp" android:textColor="@color/textGray" android:id="@+id/month_pay_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="本月支出" />
                    <TextView android:textSize="25dp" android:textStyle="bold" android:textColor="@color/textColorPrimary" android:id="@+id/month_pay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:singleLine="true" android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/add_bill_btn" android:background="@drawable/selectable_item_primary_background" android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
            <ImageView android:id="@+id/add_bill_icon" android:layout_width="25dp" android:layout_height="25dp" android:src="@mipmap/ic_add_bill" android:tint="@color/textColorWhite" />
            <TextView android:textSize="15sp" android:textColor="@color/textColorWhite" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="添加一条新记账" android:layout_marginStart="10dp" />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/module_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="15dp" />
        <RelativeLayout android:id="@+id/add_btn" android:background="@drawable/dashed_rounded_rect" android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginTop="15dp" android:layout_marginBottom="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@mipmap/ic_add" android:tint="@color/grey" android:layout_centerInParent="true" />
        </RelativeLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>