<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:gravity="center_horizontal" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never">
    <LinearLayout android:gravity="center_horizontal" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <ImageView android:layout_width="100dp" android:layout_height="100dp" android:layout_marginTop="20dp" android:src="@mipmap/ic_init" />
        <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
            <RelativeLayout android:id="@+id/red_book_layout" android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="60dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="小红书" android:layout_centerVertical="true" />
                <TextView android:textSize="12sp" android:textColor="@color/grey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="一木宇宙" android:singleLine="true" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <RelativeLayout android:id="@+id/email_layout" android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="50dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="邮箱" android:layout_centerVertical="true" />
                <TextView android:textSize="12sp" android:textColor="@color/grey" android:id="@+id/email_address" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="yimuyuzhou@163.com" android:singleLine="true" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <RelativeLayout android:id="@+id/qq_group_layout" android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="50dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="QQ群" android:layout_centerVertical="true" />
                <TextView android:textSize="12sp" android:textColor="@color/grey" android:id="@+id/qq_group" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="824186564" android:singleLine="true" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <RelativeLayout android:id="@+id/web_layout" android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="50dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="官网" android:layout_centerVertical="true" />
                <TextView android:textSize="12sp" android:textColor="@color/grey" android:id="@+id/web_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="www.yimuapp.com" android:singleLine="true" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <RelativeLayout android:id="@+id/wechat_layout" android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="50dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="公众号" android:layout_centerVertical="true" />
                <TextView android:textSize="12sp" android:textColor="@color/grey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="一木宇宙" android:singleLine="true" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
            <RelativeLayout android:id="@+id/version_layout" android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="50dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                <LinearLayout android:gravity="end" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_alignParentEnd="true">
                    <TextView android:textSize="12sp" android:textColor="@color/grey" android:id="@+id/version" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="v1.0" android:singleLine="true" />
                    <TextView android:textSize="11sp" android:textColor="@color/red" android:id="@+id/new_version" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="存在新版本" android:layout_marginStart="10dp" />
                </LinearLayout>
                <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="软件版本" android:layout_centerVertical="true" />
            </RelativeLayout>
            <RelativeLayout android:id="@+id/filing_number_layout" android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="50dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                <LinearLayout android:gravity="end" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_alignParentEnd="true">
                    <TextView android:textSize="12sp" android:textColor="@color/grey" android:id="@+id/filing_number" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" />
                </LinearLayout>
                <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="备案号" android:layout_centerVertical="true" />
            </RelativeLayout>
            <RelativeLayout android:id="@+id/user_agreement" android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="50dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="用户协议" android:layout_centerVertical="true" />
            </RelativeLayout>
            <RelativeLayout android:id="@+id/privacy_policy" android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="50dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="隐私政策" android:layout_centerVertical="true" />
            </RelativeLayout>
            <RelativeLayout android:id="@+id/user_info" android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="50dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="个人信息收集清单" android:layout_centerVertical="true" />
            </RelativeLayout>
            <RelativeLayout android:id="@+id/other_info" android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="50dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="第三方共享个人信息清单" android:layout_centerVertical="true" />
            </RelativeLayout>
            <RelativeLayout android:id="@+id/open_source" android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="50dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="开源协议" android:layout_centerVertical="true" />
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="30dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="我们的应用" />
            <RelativeLayout android:id="@+id/item_app" android:background="@drawable/bg_white" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="5dp">
                <ImageView android:id="@+id/item_icon" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_item_icon" app:corner_radius="10dp" app:oval="false" />
                <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_toEndOf="@+id/item_icon">
                    <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="一木记物" />
                    <TextView android:textSize="12sp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="全品类物品生活管家。数码家电、日常用品、首饰、会员订阅轻松记录。保修期、保质期、有效期到期提醒" android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout android:id="@+id/todo_app" android:background="@drawable/bg_white" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="60dp">
                <ImageView android:id="@+id/todo_icon" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_todo_icon" app:corner_radius="10dp" app:oval="false" />
                <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_toEndOf="@+id/todo_icon">
                    <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="一木清单" />
                    <TextView android:textSize="12sp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="智能待办清单，制定待办事项、出行计划、重要笔记、习惯打卡，使用番茄钟和专注计时，轻松规划每一天" android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>