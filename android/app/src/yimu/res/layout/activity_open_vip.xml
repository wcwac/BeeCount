<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/parent_layout" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:layout_above="@+id/open_vip_layout">
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp">
                <TextView android:textSize="12sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="我们坚持品质出众，用户至上。如果您喜欢一木，您的付费支持将为一木的持续发展注入动力。" android:lineSpacingExtra="5dp" />
                <TextView android:textSize="12sp" android:textColor="@color/black" android:id="@+id/vip_desc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="我们保障每一个用户权益，会员支持终身保价。我们深知无法满足所有用户需求，如您不满意，可在7日内申请退款（限安卓），一木可能是唯一支持退款的主流记账软件，具体可查看《会员服务协议》。" android:lineSpacingExtra="5dp" />
            </LinearLayout>
            <RelativeLayout android:id="@+id/title_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/origin_color" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="官方力荐" />
                    <TextView android:textSize="11sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="获得国内主流应用市场至高荣誉大满贯的记账软件" android:lineSpacingExtra="5dp" />
                    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp">
                        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                            <ImageView android:layout_width="match_parent" android:layout_height="wrap_content" android:src="@mipmap/icon_jinmi" android:tint="@color/black" />
                            <TextView android:textSize="9dp" android:textColor="@color/grey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="年度十佳金米奖" />
                        </LinearLayout>
                        <ImageView android:layout_width="0dp" android:layout_height="wrap_content" android:src="@mipmap/icon_zhimei" android:tint="@color/black" android:layout_weight="1" />
                        <ImageView android:layout_width="0dp" android:layout_height="wrap_content" android:src="@mipmap/icon_jiguang" android:tint="@color/black" android:layout_weight="1" />
                        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                            <ImageView android:layout_width="match_parent" android:layout_height="wrap_content" android:src="@mipmap/icon_jiangxin" android:tint="@color/black" />
                            <TextView android:textSize="9dp" android:textColor="@color/grey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="原匠心奖升级" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
            <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                <LinearLayout android:orientation="horizontal" android:id="@+id/table_title" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp">
                    <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/origin_color" android:layout_width="0dp" android:layout_height="wrap_content" android:text="会员权益" android:singleLine="true" android:layout_weight="3" />
                    <TextView android:textSize="14sp" android:textColor="@color/textColorPrimary" android:layout_width="0dp" android:layout_height="wrap_content" android:text="会员" android:singleLine="true" android:layout_weight="2" />
                    <TextView android:textSize="14sp" android:textColor="@color/grey" android:layout_width="0dp" android:layout_height="wrap_content" android:text="免费" android:singleLine="true" android:layout_weight="2" />
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/vip_function_list" android:layout_width="match_parent" android:layout_height="match_parent" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:orientation="vertical" android:id="@+id/open_vip_layout" android:background="@drawable/shape_bg_main_bill_top" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:elevation="5dp">
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="10dp" android:layout_marginBottom="10dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
            <RelativeLayout android:id="@+id/month_vip_choice" android:background="@drawable/shape_bg_describe" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginEnd="10dp">
                <LinearLayout android:gravity="bottom|center_horizontal" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true">
                    <TextView android:textSize="17dp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/month_vip_price" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="¥0" />
                    <TextView android:textSize="12dp" android:textColor="@color/darkGrey" android:id="@+id/month_vip_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="/月" android:layout_marginStart="2dp" />
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout android:id="@+id/year_vip_choice" android:background="@drawable/shape_bg_describe" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="10dp" android:layout_marginEnd="10dp">
                <LinearLayout android:gravity="bottom|center_horizontal" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true">
                    <TextView android:textSize="17dp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/year_vip_price" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="¥0" />
                    <TextView android:textSize="12dp" android:textColor="@color/black" android:id="@+id/year_vip_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="/年" android:layout_marginStart="2dp" />
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout android:id="@+id/forever_vip_choice" android:background="@drawable/shape_bg_vip_choice" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="10dp">
                <LinearLayout android:gravity="bottom|center_horizontal" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true">
                    <TextView android:textSize="17dp" android:textStyle="bold" android:textColor="@color/white" android:id="@+id/forever_vip_price" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="¥0" />
                    <TextView android:textSize="12dp" android:textColor="@color/white" android:id="@+id/forever_vip_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="永久" android:layout_marginStart="2dp" />
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout android:visibility="gone" android:clipChildren="false" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:layout_marginStart="30dp" android:layout_marginEnd="30dp">
            <LinearLayout android:gravity="center_vertical" android:orientation="vertical" android:id="@+id/vip_group_layout" android:background="@mipmap/ic_vip_group_not_choice" android:layout_width="match_parent" android:layout_height="0dp" android:paddingStart="10dp" app:layout_constraintDimensionRatio="1372:376" app:layout_constraintLeft_toLeftOf="parent" app:layout_constraintRight_toRightOf="parent">
                <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
                    <ImageView android:id="@+id/vip_group_icon" android:layout_width="45dp" android:layout_height="wrap_content" android:src="@mipmap/ic_vip_group_icon" />
                    <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="一木记账 + 一木清单" android:layout_marginStart="10dp" />
                </LinearLayout>
                <TextView android:textSize="12sp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="联合会员，都好用，更便宜" />
                <LinearLayout android:gravity="bottom" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp">
                    <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/current_cost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="198" />
                    <TextView android:textSize="15sp" android:textColor="@color/darkGrey" android:id="@+id/old_cost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="¥226" android:layout_marginStart="10dp" />
                    <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="永久会员" android:layout_marginStart="10dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="50dp">
            <FrameLayout android:textSize="15sp" android:textColor="@color/white" android:id="@+id/wechat_pay" android:background="@drawable/shape_button_login_wechat" android:layout_width="150dp" android:layout_height="40dp" android:text="@string/wechat_pay" />
            <FrameLayout android:textSize="15sp" android:textColor="@color/white" android:id="@+id/ali_pay" android:background="@drawable/shape_button_login_qq" android:layout_width="150dp" android:layout_height="40dp" android:text="@string/ali_pay" android:layout_marginStart="30dp" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="35dp">
            <TextView android:textSize="12sp" android:textStyle="bold" android:textColor="@color/grey" android:gravity="center" android:layout_width="wrap_content" android:layout_height="35dp" android:text="升级即视为同意" />
            <TextView android:textSize="12sp" android:textStyle="bold" android:textColor="@color/textBlue" android:gravity="center" android:id="@+id/vip_agreement" android:layout_width="wrap_content" android:layout_height="40dp" android:text="《会员服务协议》" />
            <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/textBlue" android:gravity="center" android:id="@+id/use_cdk" android:layout_width="150dp" android:layout_height="35dp" android:text="@string/use_cdk" />
            <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/textBlue" android:gravity="center" android:id="@+id/edu_check" android:visibility="gone" android:layout_width="150dp" android:layout_height="35dp" android:text="教育优惠" android:layout_marginStart="30dp" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>