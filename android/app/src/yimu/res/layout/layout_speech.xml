<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <RelativeLayout android:id="@+id/speech_layout" android:background="@color/whiteAlpha95" android:focusable="true" android:visibility="invisible" android:clickable="true" android:layout_width="match_parent" android:layout_height="match_parent">
            <TextView android:textSize="24sp" android:textColor="@color/textColorPrimary" android:id="@+id/speech_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="100dp" android:text="说出你要记录的账单" android:layout_centerHorizontal="true" />
            <ProgressBar android:id="@+id/spin_kit" android:padding="12dp" android:layout_width="85dp" android:layout_height="85dp" android:layout_marginTop="100dp" android:layout_below="@+id/speech_status" android:layout_centerHorizontal="true" app:SpinKit_Color="@color/textColorPrimary" />
            <TextView android:textSize="14sp" android:textColor="@color/grey" android:id="@+id/cancel_tip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="100dp" android:text="手指上滑，取消输入" android:layout_below="@+id/spin_kit" android:layout_centerHorizontal="true" />
            <TextView android:textSize="20sp" android:textColor="@color/colorPrimaryDark" android:id="@+id/speech_msg" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:text="早餐花了11元" android:layout_below="@+id/speech_status" android:layout_centerHorizontal="true" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" />
            <TextView android:textSize="15sp" android:textColor="@color/grey" android:id="@+id/analysis_info" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_below="@+id/speech_msg" android:layout_centerHorizontal="true" android:lineSpacingExtra="6dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" />
        </RelativeLayout>
    </FrameLayout>
    <FrameLayout android:id="@+id/edit_bill_btn" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="140dp" android:src="@mipmap/ic_bill_edit" android:scaleType="center" android:tint="@color/textColorWhite" android:layout_alignParentBottom="true" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_alignParentEnd="true" app:backgroundTint="@color/textBlue" app:borderWidth="0dp" app:fabSize="normal" app:maxImageSize="36dp" />
    <FrameLayout android:id="@+id/close_speech_btn" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:src="@mipmap/ic_wrong" android:scaleType="center" android:tint="@color/textColorWhite" android:layout_above="@+id/edit_bill_btn" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_alignParentEnd="true" app:backgroundTint="@color/red" app:borderWidth="0dp" app:fabSize="normal" app:maxImageSize="36dp" />
</RelativeLayout>