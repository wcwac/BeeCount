<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/total_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
    <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:padding="15dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/budget_name" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="周预算" />
        <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/budget_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2021年06月30日 - 2021年08月30日" />
        <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:textSize="12sp" android:textColor="@color/darkGrey" android:id="@+id/budget_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="总预算：" />
            <TextView android:textSize="12sp" android:textColor="@color/darkGrey" android:id="@+id/remain_budget_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="剩余预算：" android:layout_marginStart="10dp" />
        </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/book_edit" android:background="@drawable/selectable_item_circle" android:padding="11dp" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="5dp" android:src="@mipmap/ic_book_menu" android:tint="@color/iconTint" android:layout_alignParentEnd="true" />
</RelativeLayout>