<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:gravity="center_vertical" android:id="@+id/total_layout" android:background="@color/transparent" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/background" android:clickable="false" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
    <RelativeLayout android:id="@+id/top_layout" android:layout_width="match_parent" android:layout_height="40dp">
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/month_layout" android:layout_width="wrap_content" android:layout_height="match_parent">
            <ImageView android:layout_gravity="center_vertical" android:id="@+id/month_pre" android:padding="8dp" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_left" />
            <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/textColorBlack" android:gravity="center" android:id="@+id/month_info" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="11月" android:singleLine="true" />
            <ImageView android:layout_gravity="center_vertical" android:id="@+id/month_next" android:padding="8dp" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_right" />
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:id="@+id/account_book_layout" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginEnd="5dp" android:layout_toStartOf="@+id/btn_today">
            <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/textColorBlack" android:gravity="center" android:id="@+id/asset_name" android:layout_width="wrap_content" android:layout_height="match_parent" android:maxWidth="100dp" android:text="日常账本" android:singleLine="true" android:paddingStart="10dp" />
            <ImageView android:layout_gravity="center_vertical" android:id="@+id/asset_icon" android:layout_width="14dp" android:layout_height="14dp" android:src="@mipmap/ic_bottom" android:tint="@color/black" android:layout_marginStart="5dp" />
        </LinearLayout>
        <ImageView android:id="@+id/btn_today" android:background="@drawable/selectable_item_circle" android:padding="8dp" android:layout_width="35dp" android:layout_height="35dp" android:src="@mipmap/ic_widget_today" android:layout_centerVertical="true" android:layout_toStartOf="@+id/btn_add" />
        <ImageView android:id="@+id/btn_add" android:background="@drawable/selectable_item_circle" android:padding="10dp" android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_add" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@+id/top_layout">
        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <GridView android:id="@+id/week_list" android:scrollbars="none" android:layout_width="match_parent" android:layout_height="15dp" android:listSelector="@android:color/transparent" android:numColumns="7" android:divider="@null" android:overScrollMode="never" android:layout_marginStart="10dp" />
            <GridView android:id="@+id/calendar_list" android:scrollbars="none" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginBottom="5dp" android:listSelector="@android:color/transparent" android:numColumns="7" android:divider="@null" android:overScrollMode="never" android:layout_marginStart="10dp" />
        </LinearLayout>
        <RelativeLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ListView android:id="@+id/bill_list" android:scrollbars="none" android:layout_width="match_parent" android:layout_height="match_parent" android:listSelector="@android:color/transparent" android:divider="@null" android:overScrollMode="never" />
        </RelativeLayout>
    </LinearLayout>
    <RelativeLayout android:id="@+id/open_vip_layout" android:background="@drawable/shape_bg_black25_15" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent">
        <TextView android:textSize="15sp" android:textColor="@color/white" android:gravity="center" android:id="@+id/open_vip" android:background="@drawable/shape_bg_open_vip_btn" android:layout_width="150dp" android:layout_height="50dp" android:layout_marginBottom="30dp" android:text="立即开通" android:layout_alignParentBottom="true" android:layout_centerHorizontal="true" />
    </RelativeLayout>
</RelativeLayout>