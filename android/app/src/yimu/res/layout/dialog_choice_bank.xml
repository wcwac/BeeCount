<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@drawable/bg_add_bill_dialog" android:layout_width="match_parent" android:layout_height="wrap_content">
    <RelativeLayout android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginTop="10dp" android:paddingStart="15dp">
        <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="选择银行" android:layout_centerVertical="true" />
        <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/sort_by_letter" android:background="@drawable/selectable_item_expand_mask" android:layout_width="wrap_content" android:layout_height="45dp" android:text="按首字母排序" android:layout_centerVertical="true" android:layout_toStartOf="@+id/btn_close" />
        <ImageView android:id="@+id/btn_close" android:background="@drawable/selectable_item_circle" android:padding="15dp" android:layout_width="45dp" android:layout_height="45dp" android:src="@mipmap/ic_close" android:tint="@color/black" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <TextView android:textSize="11sp" android:textColor="@color/grey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:text="提示：如银行不存在，可添加自定义账户，本地上传或在线搜索图标" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/bank_list" android:paddingBottom="60dp" android:clipChildren="false" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>