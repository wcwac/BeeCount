<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@drawable/dialog_user_agreement_bg" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
    <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="@color/black" android:layout_gravity="center_horizontal" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="编辑账单" />
    <TextView android:textSize="15sp" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/modify_book" android:background="@drawable/selectable_item_expand" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:text="账本" android:paddingStart="20dp" android:paddingEnd="20dp" />
    <TextView android:textSize="15sp" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/modify_asset" android:background="@drawable/selectable_item_expand" android:layout_width="match_parent" android:layout_height="50dp" android:text="账户" android:paddingStart="20dp" android:paddingEnd="20dp" />
    <TextView android:textSize="15sp" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/modify_category" android:background="@drawable/selectable_item_expand" android:layout_width="match_parent" android:layout_height="50dp" android:text="分类" android:paddingStart="20dp" android:paddingEnd="20dp" />
