    <TextView android:textSize="15sp" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/modify_not_reimbursement" android:background="@drawable/selectable_item_expand" android:layout_width="match_parent" android:layout_height="50dp" android:text="不报销" android:paddingStart="20dp" android:paddingEnd="20dp" />
    <TextView android:textSize="15sp" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/modify_remark" android:background="@drawable/selectable_item_expand" android:layout_width="match_parent" android:layout_height="50dp" android:text="备注" android:paddingStart="20dp" android:paddingEnd="20dp" />
