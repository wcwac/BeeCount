    <TextView android:textSize="15sp" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/modify_config" android:background="@drawable/selectable_item_expand" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginBottom="10dp" android:text="设置" android:paddingStart="20dp" android:paddingEnd="20dp" />
