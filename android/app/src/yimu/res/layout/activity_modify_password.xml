<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:id="@+id/tool_bar" android:background="@color/white" android:layout_width="match_parent" android:layout_height="50dp">
        <ImageView android:id="@+id/btn_back" android:background="@drawable/selectable_item_circle" android:padding="17dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_close" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" />
        <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="180dp" android:text="更改密码" android:singleLine="true" android:layout_centerVertical="true" android:layout_toEndOf="@+id/btn_back" />
        <ImageView android:id="@+id/btn_complete" android:background="@drawable/selectable_item_circle" android:padding="12dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_tick" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
        <EditText android:textSize="15sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/origin_password" android:background="@color/transparent" android:layout_width="match_parent" android:layout_height="55dp" android:hint="请输入当前密码" android:singleLine="true" android:inputType="textPassword" android:paddingStart="15dp" android:paddingEnd="15dp" />
        <View android:background="@color/divider" android:layout_width="match_parent" android:layout_height="1px" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
        <EditText android:textSize="15sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/password" android:background="@color/transparent" android:layout_width="match_parent" android:layout_height="55dp" android:hint="新密码，6-20位字符" android:singleLine="true" android:inputType="textPassword" android:paddingStart="15dp" android:paddingEnd="15dp" />
        <View android:background="@color/divider" android:layout_width="match_parent" android:layout_height="1px" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
        <EditText android:textSize="15sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/password_again" android:background="@color/transparent" android:layout_width="match_parent" android:layout_height="55dp" android:hint="确认密码" android:singleLine="true" android:inputType="textPassword" android:paddingStart="15dp" android:paddingEnd="15dp" />
    </LinearLayout>
</LinearLayout>