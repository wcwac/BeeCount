<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:background="@color/white" android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:id="@+id/tool_bar" android:layout_width="match_parent" android:layout_height="50dp">
        <ImageView android:id="@+id/close_btn" android:background="@drawable/selectable_item_expand_mask" android:padding="15dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_close" android:tint="@color/iconTint" />
        <TextView android:textSize="16sp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="收支统计" android:layout_centerInParent="true" />
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/bar_menu" android:background="@drawable/bg_statistics_bar_menu" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_centerVertical="true" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true">
            <TextView android:textSize="12sp" android:gravity="center" android:id="@+id/bar_pay" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="支出" android:paddingStart="15dp" android:paddingEnd="15dp" />
            <TextView android:textSize="12sp" android:gravity="center" android:id="@+id/bar_income" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="收入" android:paddingStart="15dp" android:paddingEnd="15dp" />
        </LinearLayout>
    </RelativeLayout>
    <FrameLayout android:id="@+id/bar_chart" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="15dp" android:layout_below="@+id/tool_bar" />
</RelativeLayout>