<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:gravity="center_vertical" android:id="@+id/total_layout" android:background="@color/translate" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/background" android:clickable="false" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
    <RelativeLayout android:id="@+id/top_layout" android:layout_width="match_parent" android:layout_height="40dp">
        <ImageView android:id="@+id/top_background" android:clickable="false" android:layout_width="match_parent" android:layout_height="40dp" android:scaleType="fitXY" />
        <LinearLayout android:orientation="horizontal" android:id="@+id/account_book_layout" android:layout_width="wrap_content" android:layout_height="match_parent" android:paddingStart="10dp">
            <TextView android:textSize="13dp" android:textStyle="bold" android:textColor="@color/textColorBlack" android:gravity="center" android:id="@+id/account_book_name" android:layout_width="wrap_content" android:layout_height="match_parent" android:maxWidth="120dp" android:text="日常账本" android:singleLine="true" />
            <ImageView android:layout_gravity="center_vertical" android:id="@+id/book_icon" android:layout_width="11dp" android:layout_height="11dp" android:src="@mipmap/ic_bottom" android:tint="@color/black" android:layout_marginStart="3dp" />
        </LinearLayout>
        <LinearLayout android:gravity="center_vertical" android:orientation="vertical" android:id="@+id/num_layout" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginStart="10dp" android:layout_toEndOf="@+id/account_book_layout">
            <TextView android:textSize="9dp" android:textColor="@color/textColorBlack" android:id="@+id/pay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" />
            <TextView android:textSize="9dp" android:textColor="@color/textColorBlack" android:id="@+id/income" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" />
        </LinearLayout>
        <LinearLayout android:gravity="end|center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_toStartOf="@+id/btn_add">
            <ImageView android:id="@+id/pre_month" android:background="@drawable/selectable_item_circle" android:padding="8dp" android:layout_width="30dp" android:layout_height="40dp" android:src="@mipmap/ic_more_left" android:tint="@color/black" />
            <TextView android:textSize="14dp" android:textStyle="bold" android:textColor="@color/textColorBlack" android:id="@+id/month" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" />
            <ImageView android:id="@+id/next_month" android:background="@drawable/selectable_item_circle" android:padding="8dp" android:layout_width="30dp" android:layout_height="40dp" android:src="@mipmap/ic_more" android:tint="@color/black" />
        </LinearLayout>
        <ImageView android:id="@+id/btn_refresh" android:background="@drawable/selectable_item_circle" android:padding="9dp" android:layout_width="35dp" android:layout_height="35dp" android:src="@mipmap/ic_refresh" android:tint="@color/black" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
        <ImageView android:id="@+id/btn_add" android:background="@drawable/selectable_item_circle" android:padding="3dp" android:layout_width="35dp" android:layout_height="35dp" android:src="@mipmap/ic_notify_add" android:tint="@color/black" android:layout_centerVertical="true" android:layout_toStartOf="@+id/btn_refresh" />
    </RelativeLayout>
    <GridView android:id="@+id/week_list" android:scrollbars="none" android:layout_width="match_parent" android:layout_height="wrap_content" android:listSelector="@android:color/transparent" android:numColumns="7" android:divider="@null" android:layout_below="@+id/top_layout" android:overScrollMode="never" />
    <GridView android:id="@+id/date_list" android:scrollbars="none" android:layout_width="match_parent" android:layout_height="wrap_content" android:listSelector="@android:color/transparent" android:numColumns="7" android:divider="@null" android:layout_below="@+id/week_list" android:overScrollMode="never" />
    <RelativeLayout android:id="@+id/open_vip_layout" android:background="@drawable/shape_bg_black25_15" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent">
        <TextView android:textSize="15sp" android:textColor="@color/white" android:gravity="center" android:id="@+id/open_vip" android:background="@drawable/shape_bg_open_vip_btn" android:layout_width="150dp" android:layout_height="50dp" android:layout_marginBottom="30dp" android:text="立即开通" android:layout_alignParentBottom="true" android:layout_centerHorizontal="true" />
    </RelativeLayout>
</RelativeLayout>