<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
    <RelativeLayout android:id="@+id/backup_tip" android:background="@drawable/bg_home_tip" android:visibility="gone" android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginBottom="10dp" android:layout_marginEnd="15dp">
        <TextView android:textSize="12dp" android:textColor="@color/red" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="账单数据宝贵，建议您点击查看当前数据备份状态" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="10dp" android:layout_toStartOf="@+id/tip_close" />
        <ImageView android:id="@+id/tip_close" android:padding="3dp" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_tip_close" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <RelativeLayout android:id="@+id/huawei_tip" android:background="@drawable/bg_home_tip" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:layout_marginEnd="15dp">
        <TextView android:textSize="12dp" android:textColor="@color/red" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="10dp" android:text="如果您近期有升级鸿蒙NEXT的计划，由于不同系统本地数据无法通用，建议您升级前做好数据云备份" android:layout_centerVertical="true" android:lineSpacingExtra="5dp" android:layout_marginStart="10dp" android:layout_toStartOf="@+id/huawei_tip_close" />
        <ImageView android:id="@+id/huawei_tip_close" android:padding="3dp" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_tip_close" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <RelativeLayout android:id="@+id/auto_tip" android:background="@drawable/selectable_item_light_primary_background" android:visibility="gone" android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginBottom="10dp" android:layout_marginEnd="15dp">
        <TextView android:textSize="12dp" android:textColor="@color/colorPrimaryDark" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="试试自动记账，一键高效记录，告别半途而废" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="10dp" android:layout_toStartOf="@+id/auto_tip_close" />
        <ImageView android:id="@+id/auto_tip_close" android:padding="3dp" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_tip_close" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/category_type_tip" android:clipChildren="false" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:layout_marginEnd="15dp">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="0dp" app:layout_constraintDimensionRatio="1319:210" app:layout_constraintLeft_toLeftOf="parent" app:layout_constraintRight_toRightOf="parent" app:layout_constraintTop_toTopOf="parent">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@mipmap/banner_category_type_home" android:scaleType="fitXY" />
            <ImageView android:id="@+id/category_type_close" android:padding="3dp" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_tip_close" android:layout_alignParentEnd="true" />
        </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/year_info_tip" android:clipChildren="false" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:layout_marginEnd="15dp">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="0dp" app:layout_constraintDimensionRatio="1320:420" app:layout_constraintLeft_toLeftOf="parent" app:layout_constraintRight_toRightOf="parent" app:layout_constraintTop_toTopOf="parent">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@mipmap/ic_year_info" android:scaleType="fitXY" />
            <ImageView android:id="@+id/year_info_close" android:padding="3dp" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_tip_close" android:layout_alignParentEnd="true" />
        </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <RelativeLayout android:id="@+id/comment_tip" android:background="@drawable/shape_bg_budget" android:visibility="visible" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:layout_marginEnd="15dp">
        <TextView android:textSize="13sp" android:textColor="@color/textColorWhite" android:id="@+id/comment_desc" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="感谢您坚持使用一木记账，如果一木对您有所帮助，希望您能给予我们一个好评" android:lineSpacingExtra="5dp" android:layout_marginStart="10dp" android:layout_toStartOf="@+id/comment_close" />
        <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/colorPrimary" android:gravity="center" android:id="@+id/comment_btn" android:background="@drawable/shape_bg_white_15" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginTop="15dp" android:layout_marginBottom="10dp" android:text="去给好评" android:layout_below="@+id/comment_desc" android:paddingStart="15dp" android:paddingEnd="15dp" android:layout_marginStart="10dp" />
        <ImageView android:id="@+id/comment_close" android:padding="3dp" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_tip_close" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/banner_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:layout_marginEnd="15dp">
        <LinearLayout android:gravity="center_vertical" android:orientation="vertical" android:id="@+id/home_background" android:layout_width="match_parent" android:layout_height="0dp" android:paddingStart="15dp" android:paddingEnd="15dp" app:layout_constraintDimensionRatio="980:376" app:layout_constraintLeft_toLeftOf="parent" app:layout_constraintRight_toRightOf="parent" app:layout_constraintTop_toTopOf="parent">
            <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <LinearLayout android:orientation="vertical" android:id="@+id/month_income_layout" android:layout_width="wrap_content" android:layout_height="wrap_content">
                    <TextView android:textSize="12sp" android:id="@+id/month_income_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="本月收入" android:singleLine="true" android:paddingEnd="35dp" />
                    <TextView android:textSize="15sp" android:textStyle="bold" android:id="@+id/month_income" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:singleLine="true" android:paddingEnd="25dp" />
                </LinearLayout>
                <LinearLayout android:orientation="vertical" android:id="@+id/month_balance_layout" android:layout_width="wrap_content" android:layout_height="wrap_content">
                    <TextView android:textSize="12sp" android:id="@+id/month_balance_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="本月结余" android:singleLine="true" android:paddingEnd="35dp" />
                    <TextView android:textSize="15sp" android:textStyle="bold" android:id="@+id/month_balance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:singleLine="true" android:paddingEnd="25dp" />
                </LinearLayout>
                <LinearLayout android:orientation="vertical" android:id="@+id/budget_setting" android:layout_width="wrap_content" android:layout_height="wrap_content">
                    <TextView android:textSize="12sp" android:id="@+id/month_budget_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="剩余预算" android:singleLine="true" />
                    <TextView android:textSize="13sp" android:id="@+id/month_budget" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/click_to_setting" android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:id="@+id/month_pay_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp">
                <TextView android:textSize="12sp" android:id="@+id/month_pay_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="本月支出" />
                <TextView android:textSize="25dp" android:textStyle="bold" android:id="@+id/month_pay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:singleLine="true" android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/add_bill_btn" android:background="@drawable/selectable_item_primary_background" android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginTop="15dp" android:layout_marginEnd="15dp">
        <ImageView android:id="@+id/add_bill_icon" android:layout_width="25dp" android:layout_height="25dp" android:src="@mipmap/ic_add_bill" android:tint="@color/textColorWhite" />
        <TextView android:textSize="15sp" android:textColor="@color/textColorWhite" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="添加一条新记账" android:layout_marginStart="10dp" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/module_list" android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>