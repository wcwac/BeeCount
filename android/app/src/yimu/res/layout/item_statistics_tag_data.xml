<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="55dp" android:paddingStart="10dp" android:paddingEnd="10dp">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="15dp" android:layout_toStartOf="@+id/cost_layout">
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <View android:id="@+id/tag_color" android:layout_width="12dp" android:layout_height="12dp" />
            <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/tag_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="居家生活" android:singleLine="true" android:layout_marginStart="8dp" />
        </LinearLayout>
        <TextView android:textSize="12sp" android:textColor="@color/textGray" android:id="@+id/tag_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="5笔" />
    </LinearLayout>
    <LinearLayout android:gravity="end" android:orientation="vertical" android:id="@+id/cost_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/more">
        <TextView android:textSize="12sp" android:textColor="@color/moneyPay" android:id="@+id/pay_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="支出：5" />
        <TextView android:textSize="12sp" android:textColor="@color/moneyIncome" android:id="@+id/income_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="收入：5" />
    </LinearLayout>
    <ImageView android:id="@+id/more" android:layout_width="15dp" android:layout_height="15dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
    <View android:id="@+id/line" android:background="@color/divider" android:layout_width="match_parent" android:layout_height="1px" android:layout_alignParentBottom="true" />
</RelativeLayout>