<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@drawable/dialog_user_agreement_bg" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
    <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="@color/black" android:layout_gravity="center_horizontal" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="5dp" android:text="金额设置" />
    <TextView android:textSize="12sp" android:textColor="@color/grey" android:layout_gravity="center_vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:text="本金" android:layout_marginStart="25dp" />
    <RelativeLayout android:id="@+id/number_layout" android:background="@drawable/shape_edit_frame" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
        <EditText android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/number" android:background="@color/transparent" android:layout_width="match_parent" android:layout_height="match_parent" android:hint="请输入本金" android:inputType="numberDecimal" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/btn_clear_number" />
        <ImageView android:id="@+id/btn_clear_number" android:background="@drawable/selectable_item_circle" android:padding="8dp" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_clear" android:tint="@color/iconTint" android:layout_centerVertical="true" android:layout_marginEnd="5dp" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <TextView android:textSize="12sp" android:textColor="@color/grey" android:layout_gravity="center_vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:text="服务费" android:layout_marginStart="25dp" />
    <RelativeLayout android:id="@+id/service_layout" android:background="@drawable/shape_edit_frame" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
        <EditText android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/service" android:background="@color/transparent" android:layout_width="match_parent" android:layout_height="match_parent" android:hint="请输入服务费" android:inputType="numberDecimal" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/btn_clear_service" />
        <ImageView android:id="@+id/btn_clear_service" android:background="@drawable/selectable_item_circle" android:padding="8dp" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_clear" android:tint="@color/iconTint" android:layout_centerVertical="true" android:layout_marginEnd="5dp" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <TextView android:textSize="12sp" android:textColor="@color/grey" android:layout_gravity="center_vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:text="还款总额" android:layout_marginStart="25dp" />
    <RelativeLayout android:id="@+id/total_layout" android:background="@drawable/shape_edit_frame" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
        <EditText android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/total" android:background="@color/transparent" android:layout_width="match_parent" android:layout_height="match_parent" android:hint="请输入还款总额" android:inputType="numberDecimal" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/btn_clear_total" />
        <ImageView android:id="@+id/btn_clear_total" android:background="@drawable/selectable_item_circle" android:padding="8dp" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_clear" android:tint="@color/iconTint" android:layout_centerVertical="true" android:layout_marginEnd="5dp" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <RelativeLayout android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="20dp">
        <TextView android:textSize="15sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/early_settlement" android:background="?android:attr/selectableItemBackground" android:layout_width="wrap_content" android:layout_height="50dp" android:text="提前结清" android:paddingStart="20dp" android:paddingEnd="20dp" />
        <TextView android:textSize="15sp" android:textColor="@color/textGray" android:gravity="center" android:id="@+id/cancel" android:background="?android:attr/selectableItemBackground" android:layout_width="wrap_content" android:layout_height="50dp" android:text="取消" android:paddingStart="20dp" android:paddingEnd="20dp" android:layout_toStartOf="@+id/confirm" />
        <TextView android:textSize="15sp" android:textColor="@color/textColorPrimary" android:gravity="center" android:id="@+id/confirm" android:background="?android:attr/selectableItemBackground" android:layout_width="wrap_content" android:layout_height="50dp" android:text="确定" android:paddingStart="20dp" android:paddingEnd="20dp" android:layout_alignParentEnd="true" />
    </RelativeLayout>
</LinearLayout>