<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/parent_layout" android:background="@drawable/shape_bg_theme_content_10" android:layout_width="match_parent" android:layout_height="130dp" android:layout_marginTop="15dp" android:layout_marginEnd="15dp">
    <ImageView android:id="@+id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" app:corner_radius="@dimen/common_radius" app:oval="false" />
    <RelativeLayout android:paddingTop="10dp" android:paddingBottom="7dp" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="10dp" android:layout_toStartOf="@+id/month_info_view">
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_custom_module_hot_map" />
            <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="热力图" android:layout_marginStart="5dp" />
        </LinearLayout>
        <RelativeLayout android:paddingTop="10dp" android:paddingBottom="3dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentBottom="true">
            <LinearLayout android:gravity="center" android:id="@+id/check_mode_btn" android:background="@drawable/shape_bg_primary_15" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="6dp" android:paddingEnd="6dp">
                <TextView android:textSize="12sp" android:textColor="@color/white" android:id="@+id/btn_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="支出" />
                <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@mipmap/ic_hot_map_check" android:tint="@color/white" android:layout_marginStart="3dp" />
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
    <FrameLayout android:id="@+id/month_info_view" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginTop="10dp" android:layout_marginBottom="7dp" android:layout_marginEnd="7dp" android:layout_alignParentEnd="true" />
</RelativeLayout>