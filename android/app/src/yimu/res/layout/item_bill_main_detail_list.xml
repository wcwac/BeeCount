<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:id="@+id/total_layout" android:layout_width="match_parent" android:layout_height="wrap_content">
    <RelativeLayout android:id="@+id/time_layout" android:paddingTop="15dp" android:paddingBottom="5dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/date_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="10dp" />
        <TextView android:textSize="13sp" android:textColor="@color/darkGrey" android:id="@+id/week_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@+id/date_info" />
        <LinearLayout android:orientation="horizontal" android:id="@+id/income_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="15dp" android:layout_toStartOf="@+id/pay_layout">
            <TextView android:textSize="13sp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="收" />
            <TextView android:textSize="13sp" android:textColor="@color/moneyIncome" android:id="@+id/income" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:layout_marginStart="4dp" />
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:id="@+id/pay_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true">
            <TextView android:textSize="13sp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="支" />
            <TextView android:textSize="13sp" android:textColor="@color/moneyPay" android:id="@+id/pay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:layout_marginStart="4dp" />
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout android:id="@+id/bill_layout" android:background="@drawable/selectable_item_expand" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingEnd="10dp">
        <RelativeLayout android:id="@+id/start_layout" android:layout_width="40dp" android:layout_height="55dp">
            <ImageView android:id="@+id/icon" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginTop="10dp" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" />
            <RadioButton android:id="@+id/radio_button" android:background="@color/transparent" android:focusable="false" android:visibility="gone" android:clickable="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginStart="8dp" />
        </RelativeLayout>
        <LinearLayout android:orientation="vertical" android:paddingBottom="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_toEndOf="@+id/start_layout">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/cost_layout">
                    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
                        <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/category" android:layout_width="0dp" android:layout_height="wrap_content" android:singleLine="true" android:layout_weight="1" />
                        <TextView android:textSize="9sp" android:textColor="@color/reimbursement_text" android:id="@+id/reimbursement" android:background="@drawable/bg_reimbursement" android:paddingTop="2dp" android:paddingBottom="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="待报销" android:singleLine="true" android:paddingStart="3dp" android:paddingEnd="3dp" android:layout_marginStart="5dp" />
                        <TextView android:textSize="9sp" android:textColor="@color/refund_text" android:id="@+id/refund" android:background="@drawable/bg_refund" android:paddingTop="2dp" android:paddingBottom="2dp" android:visibility="invisible" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="退" android:singleLine="true" android:paddingStart="3dp" android:paddingEnd="3dp" android:layout_marginStart="5dp" />
                        <TextView android:textSize="9sp" android:textColor="@color/discount_text" android:id="@+id/discount" android:background="@drawable/bg_discount" android:paddingTop="2dp" android:paddingBottom="2dp" android:visibility="invisible" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="惠" android:singleLine="true" android:paddingStart="3dp" android:paddingEnd="3dp" android:layout_marginStart="5dp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:gravity="bottom" android:orientation="horizontal" android:id="@+id/cost_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_alignParentEnd="true">
                    <TextView android:textSize="12sp" android:textColor="@color/grey" android:id="@+id/old_cost" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="3dp" />
                    <TextView android:textSize="15sp" android:textStyle="bold" android:id="@+id/cost" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp">
                <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/start_info" android:layout_width="wrap_content" android:layout_height="wrap_content">
                    <TextView android:textSize="11sp" android:textColor="@color/darkGrey" android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:textSize="11sp" android:textColor="@color/colorPrimaryDark" android:id="@+id/create_user" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="100dp" android:singleLine="true" android:layout_marginStart="5dp" />
                    <TextView android:textSize="11sp" android:gravity="center" android:id="@+id/not_into_total" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="16dp" android:text="不计收支" android:singleLine="true" android:paddingStart="6dp" android:paddingEnd="6dp" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" />
                    <TextView android:textSize="11sp" android:gravity="center" android:id="@+id/not_into_budget" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="16dp" android:text="不计预算" android:singleLine="true" android:paddingStart="6dp" android:paddingEnd="6dp" android:layout_marginEnd="5dp" />
                </LinearLayout>
                <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="10dp" android:layout_alignParentEnd="true">
                    <ImageView android:id="@+id/asset_icon" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginEnd="3dp" />
                    <TextView android:textSize="11sp" android:textColor="@color/darkGrey" android:gravity="end" android:id="@+id/asset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" />
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/group_asset_list" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <ImageView android:id="@+id/group_tag" android:visibility="gone" android:layout_width="15dp" android:layout_height="15dp" android:src="@mipmap/ic_group" android:tint="@color/darkGrey" android:paddingStart="3dp" />
                </LinearLayout>
            </RelativeLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/tag_list" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:textSize="12sp" android:textColor="@color/darkGrey" android:ellipsize="end" android:id="@+id/remark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:maxLines="2" android:lineSpacingExtra="3dp" />
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/address_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:layout_marginEnd="10dp">
                <ImageView android:id="@+id/ic_task_address" android:layout_width="13dp" android:layout_height="13dp" android:src="@mipmap/ic_task_address" android:tint="@color/grey" />
                <TextView android:textSize="11dp" android:textColor="@color/grey" android:id="@+id/address" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:layout_marginEnd="10dp" />
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/file_list" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" />
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>