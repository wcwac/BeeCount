<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:paddingBottom="30dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <RelativeLayout android:id="@+id/text_tip_layout" android:background="@drawable/selectable_item_light_primary_background" android:visibility="visible" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
            <TextView android:textSize="12sp" android:textColor="@color/colorPrimaryDark" android:paddingTop="5dp" android:paddingBottom="5dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="无法识别当前账单，您可以手动指定账单文件中的列属性。当前仅支持指定分类、金额、日期、账户、账本、备注。如您想导入更多数据，建议您使用模板导入" android:layout_centerVertical="true" android:lineSpacingExtra="3dp" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" />
        </RelativeLayout>
        <RelativeLayout android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="15dp" android:paddingStart="15dp" android:paddingEnd="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
            <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="一级分类" android:layout_centerVertical="true" />
            <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@mipmap/ic_arrow_right" android:layout_centerInParent="true" />
            <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/parent_category_layout" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_alignParentEnd="true">
                <TextView android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:gravity="end" android:id="@+id/parent_category_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:hint="选择列" />
                <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@mipmap/ic_book_more" android:layout_marginStart="5dp" />
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="15dp" android:paddingStart="15dp" android:paddingEnd="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
            <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="二级分类" android:layout_centerVertical="true" />
            <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@mipmap/ic_arrow_right" android:layout_centerInParent="true" />
            <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/child_category_layout" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_alignParentEnd="true">
                <TextView android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:gravity="end" android:id="@+id/child_category_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:hint="选择列" />
                <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@mipmap/ic_book_more" android:layout_marginStart="5dp" />
            </LinearLayout>
        </RelativeLayout>
        <TextView android:textSize="12sp" android:textColor="@color/darkGrey" android:paddingTop="5dp" android:paddingBottom="5dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="如您的账单文件不含二级分类，您可以不选择二级分类，或者不选择一级分类，我们会自动创建临时一级分类，方便数据整理" android:paddingStart="15sp" android:paddingEnd="15dp" />
        <RelativeLayout android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:paddingStart="15dp" android:paddingEnd="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
            <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="收支类型" android:layout_centerVertical="true" />
            <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@mipmap/ic_arrow_right" android:layout_centerInParent="true" />
            <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/type_layout" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_alignParentEnd="true">
                <TextView android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:gravity="end" android:id="@+id/type_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:hint="选择列" />
                <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@mipmap/ic_book_more" android:layout_marginStart="5dp" />
            </LinearLayout>
        </RelativeLayout>
        <TextView android:textSize="12sp" android:textColor="@color/darkGrey" android:paddingTop="5dp" android:paddingBottom="5dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="如您的账单文件不含收支类型（标有“收入”或“支出”），您可以不指定该列，但需确保金额列中的数字含有正负号±" android:paddingStart="15sp" android:paddingEnd="15dp" />
        <RelativeLayout android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:paddingStart="15dp" android:paddingEnd="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
            <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="金额" android:layout_centerVertical="true" />
            <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@mipmap/ic_arrow_right" android:layout_centerInParent="true" />
            <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/num_layout" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_alignParentEnd="true">
                <TextView android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:gravity="end" android:id="@+id/num_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:hint="选择列" />
                <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@mipmap/ic_book_more" android:layout_marginStart="5dp" />
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:paddingStart="15dp" android:paddingEnd="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
            <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="日期" android:layout_centerVertical="true" />
            <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@mipmap/ic_arrow_right" android:layout_centerInParent="true" />
            <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/date_layout" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_alignParentEnd="true">
                <TextView android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:gravity="end" android:id="@+id/date_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:hint="选择列" />
                <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@mipmap/ic_book_more" android:layout_marginStart="5dp" />
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="15dp" android:paddingStart="15dp" android:paddingEnd="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
            <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="账本" android:layout_centerVertical="true" />
            <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@mipmap/ic_arrow_right" android:layout_centerInParent="true" />
            <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/account_book_layout" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_alignParentEnd="true">
                <TextView android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:gravity="end" android:id="@+id/account_book_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:hint="选择列，可不选" />
                <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@mipmap/ic_book_more" android:layout_marginStart="5dp" />
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="15dp" android:paddingStart="15dp" android:paddingEnd="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
            <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="账户" android:layout_centerVertical="true" />
            <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@mipmap/ic_arrow_right" android:layout_centerInParent="true" />
            <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/asset_layout" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_alignParentEnd="true">
                <TextView android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:gravity="end" android:id="@+id/asset_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:hint="选择列，可不选" />
                <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@mipmap/ic_book_more" android:layout_marginStart="5dp" />
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="15dp" android:paddingStart="15dp" android:paddingEnd="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
            <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="备注" android:layout_centerVertical="true" />
            <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@mipmap/ic_arrow_right" android:layout_centerInParent="true" />
            <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/remark_layout" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_alignParentEnd="true">
                <TextView android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:gravity="end" android:id="@+id/remark_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:hint="选择列， 可不选" />
                <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@mipmap/ic_book_more" android:layout_marginStart="5dp" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</ScrollView>