<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:id="@+id/tool_bar" android:background="@color/white" android:layout_width="match_parent" android:layout_height="50dp">
        <ImageView android:id="@+id/btn_back" android:background="@drawable/selectable_item_circle" android:padding="16dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_back" android:scaleType="fitCenter" android:tint="@color/black" />
        <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="50dp" android:maxWidth="180dp" android:text="账本隐藏" android:singleLine="true" android:layout_toEndOf="@+id/btn_back" />
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/account_book_list" android:paddingBottom="15dp" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@+id/tool_bar" android:overScrollMode="never" />
</RelativeLayout>