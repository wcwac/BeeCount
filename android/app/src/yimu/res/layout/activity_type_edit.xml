<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:id="@+id/tool_bar" android:background="@color/white" android:layout_width="match_parent" android:layout_height="50dp">
        <ImageView android:id="@+id/btn_back" android:background="@drawable/selectable_item_circle" android:padding="16dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_back" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" />
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_centerVertical="true" android:layout_toEndOf="@+id/btn_back">
            <TextView android:textSize="16dp" android:textColor="@color/black" android:gravity="center" android:id="@+id/pay_btn" android:layout_width="60dp" android:layout_height="match_parent" android:text="@string/income" />
            <TextView android:textSize="13dp" android:textColor="@color/grey" android:gravity="center" android:id="@+id/income_btn" android:layout_width="60dp" android:layout_height="match_parent" android:text="@string/pay" />
        </LinearLayout>
        <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/textColorPrimary" android:gravity="center" android:id="@+id/share_center" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="分享中心" android:layout_centerVertical="true" android:layout_toStartOf="@+id/menu_layout" />
        <RelativeLayout android:id="@+id/menu_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_alignParentEnd="true">
            <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/exit_delete" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="退出" android:paddingStart="15dp" android:paddingEnd="15dp" />
            <ImageView android:id="@+id/right_icon" android:background="@drawable/selectable_item_circle" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_bar_more" android:scaleType="centerInside" android:tint="@color/black" />
        </RelativeLayout>
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@+id/tool_bar">
        <LinearLayout android:orientation="vertical" android:paddingTop="15dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RelativeLayout android:id="@+id/text_tip_layout" android:background="@drawable/selectable_item_light_primary_background" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                <TextView android:textSize="12sp" android:textColor="@color/colorPrimaryDark" android:paddingTop="5dp" android:paddingBottom="5dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="长按可排序，右上角可设置不同账本显示不同分类" android:layout_centerVertical="true" android:lineSpacingExtra="3dp" android:layout_marginStart="10dp" android:layout_marginEnd="30dp" />
                <ImageView android:id="@+id/tip_close" android:padding="3dp" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_tip_close" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/category_type_tip" android:clipChildren="false" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="0dp" app:layout_constraintDimensionRatio="1319:210" app:layout_constraintLeft_toLeftOf="parent" app:layout_constraintRight_toRightOf="parent">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@mipmap/banner_category_type" android:scaleType="fitXY" />
                    <ImageView android:id="@+id/category_type_close" android:padding="3dp" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_tip_close" android:layout_alignParentEnd="true" />
                </RelativeLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout android:gravity="center_vertical" android:id="@+id/add_btn" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginBottom="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@mipmap/ic_category_add" android:tint="@color/textColorPrimary" android:layout_marginStart="15dp" />
                <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/textColorPrimary" android:id="@+id/type_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="新增分类" android:layout_marginStart="8dp" android:layout_marginEnd="50dp" />
            </LinearLayout>
            <LinearLayout android:gravity="center_vertical" android:background="@drawable/shape_bg_setting" android:visibility="gone" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginBottom="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="50dp">
                    <ImageView android:id="@+id/recent_arrow" android:padding="2dp" android:layout_width="20dp" android:layout_height="20dp" android:src="@mipmap/ic_right" android:tint="@color/black" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
                    <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="最近使用" android:layout_centerVertical="true" android:layout_marginStart="8dp" android:layout_marginEnd="50dp" android:layout_toEndOf="@+id/recent_arrow" />
                    <Switch android:id="@+id/switch_recent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true" />
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout android:gravity="center_vertical" android:background="@drawable/shape_bg_setting" android:visibility="gone" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginBottom="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="50dp">
                    <ImageView android:id="@+id/common_arrow" android:padding="2dp" android:layout_width="20dp" android:layout_height="20dp" android:src="@mipmap/ic_right" android:tint="@color/black" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
                    <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="常用分类" android:layout_centerVertical="true" android:layout_marginStart="8dp" android:layout_marginEnd="50dp" android:layout_toEndOf="@+id/common_arrow" />
                    <Switch android:id="@+id/switch_common" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true" />
                </RelativeLayout>
            </LinearLayout>
            <RelativeLayout android:gravity="center_vertical" android:id="@+id/parent_layout" android:background="@drawable/shape_bg_setting" android:visibility="gone" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginBottom="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                <ImageView android:id="@+id/arrow" android:padding="2dp" android:layout_width="20dp" android:layout_height="20dp" android:src="@mipmap/ic_right" android:tint="@color/textColorPrimary" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
                <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/textColorPrimary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="常用分类" android:layout_centerVertical="true" android:layout_marginStart="8dp" android:layout_marginEnd="50dp" android:layout_toStartOf="@+id/edit" android:layout_toEndOf="@+id/arrow" />
                <ImageView android:id="@+id/edit" android:background="@drawable/selectable_item_circle" android:padding="13dp" android:layout_width="45dp" android:layout_height="45dp" android:src="@mipmap/ic_edit" android:tint="@color/textColorPrimary" android:layout_centerVertical="true" android:layout_marginEnd="3dp" android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/pay_type_list" android:paddingBottom="50dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:overScrollMode="never" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/income_type_list" android:paddingBottom="50dp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:overScrollMode="never" />
            </RelativeLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>