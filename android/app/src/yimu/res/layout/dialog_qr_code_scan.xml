<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:id="@+id/layout_bg" android:background="@drawable/dialog_user_agreement_bg" android:layout_width="350dp" android:layout_height="wrap_content">
    <ImageView android:layout_gravity="center_horizontal" android:id="@+id/qr_code" android:layout_width="200dp" android:layout_height="200dp" android:layout_marginTop="20dp" />
    <CheckBox android:textSize="15sp" android:textColor="@color/black" android:layout_gravity="center_horizontal" android:id="@+id/checkbox" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:checked="false" android:text="转移本地附件" style="@style/commonCheckBox" />
    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="center_horizontal" android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp" android:text="两台设备连接至同一WIFI或热点后扫码迁移" android:lineSpacingExtra="5dp" />
</LinearLayout>