<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:paddingBottom="15dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:paddingStart="15dp" android:paddingEnd="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
            <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/banner_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp">
                <LinearLayout android:gravity="center_vertical" android:orientation="vertical" android:id="@+id/home_background" android:background="@mipmap/bg_main" android:layout_width="match_parent" android:layout_height="0dp" android:paddingStart="15dp" android:paddingEnd="15dp" app:layout_constraintDimensionRatio="980:376" app:layout_constraintLeft_toLeftOf="parent" app:layout_constraintRight_toRightOf="parent">
                    <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
                        <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
                            <TextView android:textSize="12sp" android:textColor="@color/textGray" android:id="@+id/month_income_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="本月收入" android:singleLine="true" />
                            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/darkGrey" android:id="@+id/month_income" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:singleLine="true" />
                        </LinearLayout>
                        <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="25dp">
                            <TextView android:textSize="12sp" android:textColor="@color/textGray" android:id="@+id/month_balance_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="本月结余" android:singleLine="true" />
                            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/darkGrey" android:id="@+id/month_balance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:singleLine="true" />
                        </LinearLayout>
                        <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="25dp">
                            <TextView android:textSize="12sp" android:textColor="@color/textGray" android:id="@+id/month_budget_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="剩余预算" android:singleLine="true" />
                            <TextView android:textSize="12sp" android:textColor="@color/darkGrey" android:id="@+id/month_budget" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/click_to_setting" android:singleLine="true" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:textSize="12sp" android:textColor="@color/textGray" android:id="@+id/month_pay_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="本月支出" />
                    <TextView android:textSize="25dp" android:textStyle="bold" android:textColor="@color/textColorPrimary" android:id="@+id/month_pay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:singleLine="true" android:includeFontPadding="false" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/choice_primary_color" android:background="@drawable/selectable_item_primary_background" android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginTop="15dp">
                <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@mipmap/ic_add_bill" />
                <TextView android:textSize="15sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="添加一条新账单" android:layout_marginStart="10dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/home_color_layout" android:background="@drawable/shape_bg_setting" android:paddingBottom="15dp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
            <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/home_color_primary_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:textSize="12sp" android:textColor="@color/textColorBlack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="主题色" />
                <View android:id="@+id/home_color_primary" android:background="@color/colorPrimary" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginTop="5dp" />
            </LinearLayout>
            <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/home_color_title_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:textSize="12sp" android:textColor="@color/textColorBlack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="标题色" />
                <View android:id="@+id/home_color_title" android:background="@color/colorPrimary" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginTop="5dp" />
            </LinearLayout>
            <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/home_color_main_num_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:textSize="12sp" android:textColor="@color/textColorBlack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="主数值色" />
                <View android:id="@+id/home_color_main_num" android:background="@color/colorPrimary" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginTop="5dp" />
            </LinearLayout>
            <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/home_color_num_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:textSize="12sp" android:textColor="@color/textColorBlack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="普通数值色" />
                <View android:id="@+id/home_color_num" android:background="@color/colorPrimary" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginTop="5dp" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:textSize="13sp" android:textColor="@color/black" android:id="@+id/tip_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:text="选择一张图片作为你首页的主封面，我们会自动帮你生成最合适的主色调" android:lineSpacingExtra="5dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
    </LinearLayout>
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="40dp" android:layout_alignParentBottom="true" android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
        <TextView android:textSize="15sp" android:textColor="@color/textColorWhite" android:gravity="center" android:id="@+id/choice_main_image" android:background="@drawable/selectable_item_primary_background" android:layout_width="match_parent" android:layout_height="45dp" android:text="选择主封面" />
        <TextView android:textSize="15sp" android:textColor="@color/textColorWhite" android:gravity="center" android:id="@+id/next_btn" android:background="@drawable/selectable_item_primary_background" android:visibility="gone" android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginTop="20dp" android:text="下一步" />
    </LinearLayout>
</RelativeLayout>