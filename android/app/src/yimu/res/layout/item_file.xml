<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="55dp" android:paddingStart="15dp" android:paddingEnd="15dp">
    <ImageView android:id="@+id/icon" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_excel_item" android:layout_centerVertical="true" />
    <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_toEndOf="@+id/icon">
        <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="首发申请表格.csv" android:singleLine="true" />
        <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp">
            <TextView android:textSize="12sp" android:textColor="@color/grey" android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1天前" android:singleLine="true" />
            <TextView android:textSize="12sp" android:textColor="@color/grey" android:id="@+id/from" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="来自 QQ" android:singleLine="true" android:layout_marginStart="18dp" />
        </LinearLayout>
    </LinearLayout>
    <View android:background="@color/divider" android:layout_width="match_parent" android:layout_height="1px" android:layout_alignParentBottom="true" android:layout_marginStart="15dp" android:layout_toEndOf="@+id/icon" />
</RelativeLayout>