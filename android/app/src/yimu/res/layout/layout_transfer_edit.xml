<?xml version='1.0' encoding='utf-8'?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="60dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="0dp" app:cardElevation="8dp">
    <RelativeLayout android:layout_width="match_parent" android:layout_height="60dp">
        <TextView android:textSize="16sp" android:textColor="@color/textColorPrimary" android:gravity="center" android:id="@+id/choice_all" android:background="?android:attr/selectableItemBackgroundBorderless" android:layout_width="wrap_content" android:layout_height="50dp" android:text="全选" android:layout_centerVertical="true" android:paddingStart="15dp" android:paddingEnd="15dp" />
        <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="50dp" android:layout_centerVertical="true" android:layout_alignParentEnd="true">
            <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/delete_layout" android:background="@drawable/selectable_item_circle" android:layout_width="50dp" android:layout_height="50dp">
                <ImageView android:id="@+id/ic_delete" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_edit_delete" android:tint="@color/iconTint" />
                <TextView android:textSize="11sp" android:textColor="@color/darkGrey" android:id="@+id/delete_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="删除" />
            </LinearLayout>
            <ImageView android:layout_gravity="center_vertical" android:id="@+id/complete" android:background="@drawable/selectable_item_circle" android:padding="15dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_edit_complete" android:tint="@color/iconTint" />
        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>