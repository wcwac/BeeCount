<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/parent_layout" android:background="@drawable/shape_bg_theme_content_10" android:layout_width="match_parent" android:layout_height="130dp" android:layout_marginTop="15dp" android:layout_marginEnd="15dp">
    <ImageView android:id="@+id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" app:corner_radius="@dimen/common_radius" app:oval="false" />
    <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/title_layout" android:paddingTop="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="10dp">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_custom_module_week" />
        <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="本周支出" android:layout_marginStart="5dp" />
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@mipmap/ic_checkout" android:tint="@color/black" android:layout_marginStart="3dp" />
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@+id/title_layout">
        <FrameLayout android:id="@+id/week_info_view" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="15dp" android:layout_marginEnd="8dp" />
    </LinearLayout>
</RelativeLayout>