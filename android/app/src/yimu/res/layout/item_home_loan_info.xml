<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="horizontal" android:id="@+id/parent_layout" android:paddingTop="15dp" android:paddingBottom="15dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/periods" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="第1期" android:singleLine="true" />
            <TextView android:textSize="11sp" android:textColor="@color/darkGrey" android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="2020年11月19日" android:singleLine="true" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <LinearLayout android:orientation="vertical" android:id="@+id/commercial_loan_layout" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:textSize="12sp" android:textStyle="bold" android:textColor="@color/black" android:layout_gravity="center_horizontal" android:id="@+id/commercial_loan_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="3dp" android:text="商业贷款" android:singleLine="true" />
                <TextView android:textSize="12sp" android:textColor="@color/black" android:id="@+id/commercial_loan_number" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="还款：9263.45" android:singleLine="true" />
                <TextView android:textSize="12sp" android:textColor="@color/black" android:id="@+id/commercial_loan_principal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="本金：3263.45" android:singleLine="true" />
                <TextView android:textSize="12sp" android:textColor="@color/black" android:id="@+id/commercial_loan_interest" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="利息：5263.45" android:singleLine="true" />
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:id="@+id/provident_fund_loan_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                <TextView android:textSize="12sp" android:textStyle="bold" android:textColor="@color/black" android:layout_gravity="center_horizontal" android:id="@+id/provident_fund_loan_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="3dp" android:text="公积金贷款" android:singleLine="true" />
                <TextView android:textSize="12sp" android:textColor="@color/black" android:id="@+id/provident_fund_loan_number" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="还款：9263.45" android:singleLine="true" />
                <TextView android:textSize="12sp" android:textColor="@color/black" android:id="@+id/provident_fund_loan_principal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="本金：3263.45" android:singleLine="true" />
                <TextView android:textSize="12sp" android:textColor="@color/black" android:id="@+id/provident_fund_loan_interest" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="利息：5263.45" android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <LinearLayout android:orientation="vertical" android:id="@+id/commercial_loan_interest_layout" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:textSize="12sp" android:textStyle="bold" android:textColor="@color/black" android:layout_gravity="center_horizontal" android:id="@+id/commercial_loan_interest_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="3dp" android:text="商业贷款" android:singleLine="true" />
                <TextView android:textSize="12sp" android:textColor="@color/black" android:id="@+id/commercial_loan_interest_rate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="利率：4.96%" android:singleLine="true" />
                <TextView android:textSize="12sp" android:textColor="@color/black" android:id="@+id/commercial_loan_remainder" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="剩余：275.66万" android:singleLine="true" />
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:id="@+id/provident_fund_loan_interest_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                <TextView android:textSize="12sp" android:textStyle="bold" android:textColor="@color/black" android:layout_gravity="center_horizontal" android:id="@+id/provident_fund_loan_interest_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="3dp" android:text="公积金贷款" android:singleLine="true" />
                <TextView android:textSize="12sp" android:textColor="@color/black" android:id="@+id/provident_fund_loan_interest_rate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="利率：4.96%" android:singleLine="true" />
                <TextView android:textSize="12sp" android:textColor="@color/black" android:id="@+id/provident_fund_loan_remainder" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="剩余：275.66万" android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>