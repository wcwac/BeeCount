<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:id="@+id/tool_bar" android:background="@color/white" android:layout_width="match_parent" android:layout_height="50dp">
        <ImageView android:id="@+id/btn_back" android:background="@drawable/selectable_item_circle" android:padding="17dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_close" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" />
        <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="180dp" android:text="新增愿望" android:singleLine="true" android:layout_centerVertical="true" android:layout_toEndOf="@+id/btn_back" />
        <ImageView android:id="@+id/btn_delete" android:background="@drawable/selectable_item_circle" android:padding="14dp" android:visibility="gone" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_delete" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" android:layout_toStartOf="@+id/btn_complete" />
        <ImageView android:id="@+id/btn_complete" android:background="@drawable/selectable_item_circle" android:padding="12dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_tick" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:orientation="horizontal" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp">
                <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="15dp" android:layout_marginEnd="15dp">
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:id="@+id/dream_name_title" android:layout_width="match_parent" android:layout_height="50dp" android:text="愿望名称" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:id="@+id/dream_total_num_title" android:layout_width="match_parent" android:layout_height="50dp" android:text="目标金额" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:id="@+id/dream_start_num_title" android:layout_width="match_parent" android:layout_height="50dp" android:text="已攒金额" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:id="@+id/dream_remark_title" android:layout_width="match_parent" android:layout_height="50dp" android:text="备注" />
                </LinearLayout>
                <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginEnd="15dp">
                        <EditText android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/dream_name" android:background="@color/translate" android:layout_width="match_parent" android:layout_height="50dp" android:hint="请输入愿望名称" android:singleLine="true" />
                    </RelativeLayout>
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginEnd="15dp">
                        <EditText android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/dream_total_num" android:background="@color/translate" android:layout_width="match_parent" android:layout_height="50dp" android:hint="请输入目标金额" android:singleLine="true" android:inputType="numberDecimal" />
                    </RelativeLayout>
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginEnd="15dp">
                        <EditText android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/dream_start_num" android:background="@color/translate" android:layout_width="match_parent" android:layout_height="50dp" android:hint="请输入已攒金额，默认为0" android:singleLine="true" android:inputType="numberDecimal" />
                    </RelativeLayout>
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginEnd="15dp">
                        <EditText android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/dream_remark" android:background="@color/translate" android:layout_width="match_parent" android:layout_height="50dp" android:hint="请输入备注" android:singleLine="true" />
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                <RelativeLayout android:id="@+id/dream_icon_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="56dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="愿望图标" android:layout_centerVertical="true" />
                    <ImageView android:id="@+id/dream_icon" android:layout_width="25dp" android:layout_height="25dp" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/dream_start_time_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="56dp" android:paddingStart="15dp">
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="开始日期" android:layout_centerVertical="true" />
                    <TextView android:textSize="13sp" android:textColor="@color/black" android:gravity="end" android:id="@+id/dream_start_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="未设置" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/ic_start_time_more" />
                    <ImageView android:id="@+id/ic_start_time_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/dream_end_time_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="56dp" android:paddingStart="15dp">
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="预期达成" android:layout_centerVertical="true" />
                    <TextView android:textSize="13sp" android:textColor="@color/black" android:gravity="end" android:id="@+id/dream_end_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="无期限" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/ic_dream_time_more" />
                    <ImageView android:id="@+id/ic_dream_time_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/dream_type_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="56dp" android:paddingStart="15dp">
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="储蓄方式" android:layout_centerVertical="true" />
                    <TextView android:textSize="13sp" android:textColor="@color/black" android:gravity="end" android:id="@+id/dream_type" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="定期自动存入" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/ic_dream_type_more" />
                    <ImageView android:id="@+id/ic_dream_type_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/add_cycle_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="56dp" android:paddingStart="15dp">
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="储蓄周期" android:layout_centerVertical="true" />
                    <TextView android:textSize="13sp" android:textColor="@color/black" android:gravity="end" android:id="@+id/add_cycle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="每天" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/ic_add_cycle_more" />
                    <ImageView android:id="@+id/ic_add_cycle_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/add_num_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="56dp" android:paddingStart="15dp">
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="储蓄金额" android:layout_centerVertical="true" />
                    <LinearLayout android:gravity="end" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_toStartOf="@+id/ic_add_num_more">
                        <TextView android:textSize="15dp" android:textColor="@color/black" android:id="@+id/add_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:singleLine="true" android:layout_marginEnd="10dp" />
                        <TextView android:textSize="12dp" android:textColor="@color/grey" android:id="@+id/add_num_tip" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="共储蓄10次，建议每次储蓄19.1元" android:singleLine="true" android:layout_marginEnd="10dp" />
                    </LinearLayout>
                    <ImageView android:id="@+id/ic_add_num_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/income_category_layout" android:background="@drawable/selectable_item_expand_mask" android:visibility="gone" android:layout_width="match_parent" android:layout_height="56dp" android:paddingStart="15dp">
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="收入指定" android:layout_centerVertical="true" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end" android:id="@+id/income_category" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="所有收入" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/ic_income_category_more" />
                    <ImageView android:id="@+id/ic_income_category_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/pay_category_layout" android:background="@drawable/selectable_item_expand_mask" android:visibility="gone" android:layout_width="match_parent" android:layout_height="56dp" android:paddingStart="15dp">
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="支出指定" android:layout_centerVertical="true" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end" android:id="@+id/pay_category" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="所有支出" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/ic_pay_category_more" />
                    <ImageView android:id="@+id/ic_pay_category_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/asset_layout" android:background="@drawable/selectable_item_expand_mask" android:visibility="gone" android:layout_width="match_parent" android:layout_height="56dp" android:paddingStart="15dp">
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="资产指定" android:layout_centerVertical="true" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end" android:id="@+id/asset_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="净资产" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/asset_info_more" />
                    <ImageView android:id="@+id/asset_info_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/ratio_layout" android:background="@drawable/selectable_item_expand_mask" android:visibility="gone" android:layout_width="match_parent" android:layout_height="56dp" android:paddingStart="15dp">
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="计入比例" android:layout_centerVertical="true" />
                    <LinearLayout android:gravity="end" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_toStartOf="@+id/ic_ratio_more">
                        <TextView android:textSize="15dp" android:textColor="@color/black" android:id="@+id/ratio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="30%" android:singleLine="true" android:layout_marginEnd="10dp" />
                        <TextView android:textSize="12dp" android:textColor="@color/grey" android:id="@+id/ratio_tip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="(收入 - 支出) * 0.3" android:singleLine="true" android:layout_marginEnd="10dp" />
                    </LinearLayout>
                    <ImageView android:id="@+id/ic_ratio_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>