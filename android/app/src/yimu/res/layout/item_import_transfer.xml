<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/total_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingEnd="15dp">
    <CheckBox android:id="@+id/radio_button" android:background="@color/transparent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="10dp" android:layout_marginEnd="5dp" />
    <LinearLayout android:gravity="center_vertical" android:orientation="vertical" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_toEndOf="@+id/radio_button">
        <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/from_asset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="转出账户：支付宝(未创建)" android:singleLine="true" />
        <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/to_asset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="转入账户：现金" android:singleLine="true" />
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp">
            <TextView android:textSize="12sp" android:textColor="@color/darkGrey" android:ellipsize="end" android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="今日" android:singleLine="true" />
            <TextView android:textSize="12sp" android:textColor="@color/darkGrey" android:ellipsize="end" android:id="@+id/remark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:layout_marginStart="10dp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:gravity="end" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_alignParentEnd="true">
        <TextView android:textSize="15sp" android:textColor="@color/black" android:id="@+id/cost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" />
        <TextView android:textSize="12sp" android:textColor="@color/grey" android:id="@+id/service_charge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="手续费：0.00" />
    </LinearLayout>
    <View android:id="@+id/line" android:background="@color/divider" android:layout_width="match_parent" android:layout_height="1px" android:layout_marginStart="15dp" />
</RelativeLayout>