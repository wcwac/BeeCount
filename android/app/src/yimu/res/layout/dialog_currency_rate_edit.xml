<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@drawable/dialog_user_agreement_bg" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
    <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="@color/black" android:layout_gravity="center_horizontal" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="5dp" android:text="汇率设置" />
    <RelativeLayout android:id="@+id/number_asset_layout" android:background="@drawable/shape_edit_frame" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="15dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
        <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/rate_symbol" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 CNY = " android:layout_centerVertical="true" android:layout_marginStart="10dp" />
        <EditText android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/number_rate" android:background="@color/transparent" android:layout_width="match_parent" android:layout_height="match_parent" android:hint="请输入金额" android:inputType="numberDecimal" android:layout_marginStart="5dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/btn_clear_number_asset" android:layout_toEndOf="@+id/cny_symbol" />
        <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_gravity="center_vertical" android:id="@+id/cny_symbol" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="¥" android:layout_centerVertical="true" android:layout_toEndOf="@+id/rate_symbol" />
        <ImageView android:id="@+id/btn_clear_number_asset" android:background="@drawable/selectable_item_circle" android:padding="8dp" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_clear" android:tint="@color/iconTint" android:layout_centerVertical="true" android:layout_marginEnd="5dp" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <TextView android:textSize="11sp" android:textColor="@color/grey" android:layout_gravity="center_vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="手动设置的汇率有效期至第二天早8点" android:layout_marginStart="25dp" />
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="20dp">
        <TextView android:textSize="15sp" android:textColor="@color/textGray" android:gravity="center" android:id="@+id/cancel" android:background="@drawable/selectable_item_expand_mask" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/cancel" android:layout_weight="1" />
        <TextView android:textSize="15sp" android:textColor="@color/colorPrimaryText" android:gravity="center" android:id="@+id/confirm" android:background="@drawable/selectable_item_expand_mask" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/confirm" android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>