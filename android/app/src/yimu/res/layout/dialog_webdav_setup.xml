<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@drawable/dialog_user_agreement_bg" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
    <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="@color/black" android:layout_gravity="center_horizontal" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="WebDAV配置" />
    <LinearLayout android:background="@drawable/shape_edit_frame" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="20dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
        <ImageView android:layout_gravity="center_vertical" android:layout_width="22dp" android:layout_height="22dp" android:src="@mipmap/ic_webdav_address" android:tint="@color/black" android:layout_marginStart="10dp" />
        <View android:background="@color/divider" android:layout_width="1px" android:layout_height="match_parent" android:layout_marginTop="15dp" android:layout_marginBottom="15dp" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" />
        <EditText android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/url" android:background="@color/transparent" android:layout_width="match_parent" android:layout_height="match_parent" android:hint="请输入WebDAV地址" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" />
    </LinearLayout>
    <LinearLayout android:background="@drawable/shape_edit_frame" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="15dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
        <ImageView android:layout_gravity="center_vertical" android:layout_width="22dp" android:layout_height="22dp" android:src="@mipmap/ic_webdav_account" android:tint="@color/black" android:layout_marginStart="10dp" />
        <View android:background="@color/divider" android:layout_width="1px" android:layout_height="match_parent" android:layout_marginTop="15dp" android:layout_marginBottom="15dp" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" />
        <EditText android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/user_name" android:background="@color/transparent" android:layout_width="match_parent" android:layout_height="match_parent" android:hint="请输入授权账号" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" />
    </LinearLayout>
    <LinearLayout android:background="@drawable/shape_edit_frame" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="15dp" android:layout_marginBottom="15dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
        <ImageView android:layout_gravity="center_vertical" android:layout_width="22dp" android:layout_height="22dp" android:src="@mipmap/ic_webdav_passowrd" android:tint="@color/black" android:layout_marginStart="10dp" />
        <View android:background="@color/divider" android:layout_width="1px" android:layout_height="match_parent" android:layout_marginTop="15dp" android:layout_marginBottom="15dp" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" />
        <EditText android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/password" android:background="@color/transparent" android:layout_width="match_parent" android:layout_height="match_parent" android:hint="授权密码，非登录密码" android:inputType="textPassword" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" />
    </LinearLayout>
    <TextView android:textColor="@color/textColorPrimary" android:id="@+id/webdav_config" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/webdav_config_link" android:layout_marginStart="20dp" />
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="20dp">
        <TextView android:textSize="15sp" android:textColor="@color/textGray" android:gravity="center" android:id="@+id/cancel" android:background="@drawable/selectable_item_expand_mask" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/cancel" android:layout_weight="1" />
        <TextView android:textSize="15sp" android:textColor="@color/colorPrimaryText" android:gravity="center" android:id="@+id/confirm" android:background="@drawable/selectable_item_expand_mask" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/confirm" android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>