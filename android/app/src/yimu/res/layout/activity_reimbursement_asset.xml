<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:orientation="vertical" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:id="@+id/tool_bar" android:background="@color/white" android:layout_width="match_parent" android:layout_height="50dp">
        <ImageView android:id="@+id/btn_back" android:background="@drawable/selectable_item_circle" android:padding="16dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_back" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" />
        <ImageView android:id="@+id/right_icon" android:background="@drawable/selectable_item_circle" android:padding="15dp" android:visibility="gone" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_more_setting" android:tint="@color/colorPrimary" android:layout_toStartOf="@+id/right_text" />
        <TextView android:textSize="15sp" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/right_text" android:background="@drawable/selectable_item_circle" android:layout_width="wrap_content" android:layout_height="50dp" android:text="新增" android:singleLine="true" android:paddingStart="10dp" android:paddingEnd="15dp" android:layout_alignParentEnd="true" />
        <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="180dp" android:text="报销账户" android:singleLine="true" android:layout_centerVertical="true" android:layout_toEndOf="@+id/btn_back" />
    </RelativeLayout>
    <FrameLayout android:id="@+id/pull_layout" android:layout_width="match_parent" android:layout_height="match_parent" app:headerHeight="56dp" app:pullHeight="128dp" app:triggerHeight="96dp">
        <androidx.core.widget.NestedScrollView android:scrollbars="none" android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                <RelativeLayout android:id="@+id/text_tip_layout" android:background="@drawable/selectable_item_light_primary_background" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                    <TextView android:textSize="12sp" android:textColor="@color/colorPrimaryDark" android:paddingTop="5dp" android:paddingBottom="5dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="下拉可进入报销隐藏设置页面" android:layout_centerVertical="true" android:lineSpacingExtra="3dp" android:layout_marginStart="10dp" android:layout_marginEnd="30dp" />
                    <ImageView android:id="@+id/tip_close" android:padding="3dp" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_tip_close" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <RelativeLayout android:background="@drawable/shape_bg_budget" android:paddingTop="20dp" android:paddingBottom="20dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/not_reimbursement_num_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1">
                            <TextView android:textSize="13sp" android:textColor="@color/textColorBudget" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="待报销" />
                            <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/textColorBudget" android:id="@+id/not_reimbursement_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="0.00" />
                        </LinearLayout>
                        <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/reimbursement_num_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1">
                            <TextView android:textSize="13sp" android:textColor="@color/textColorBudget" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="已报销" />
                            <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/textColorBudget" android:id="@+id/reimbursement_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="0.00" />
                        </LinearLayout>
                    </LinearLayout>
                </RelativeLayout>
                <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
                    <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/tip_layout" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="150dp" android:layout_alignParentBottom="true" android:layout_centerHorizontal="true">
                        <include android:layout_width="150dp" android:layout_height="150dp" android:layout_marginBottom="10dp" layout="@layout/layout_home_tip" />
                        <TextView android:textSize="14sp" android:textColor="@color/textGray" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="你还没有任何报销账户" />
                        <TextView android:textSize="13sp" android:textColor="@color/grey" android:gravity="center" android:id="@+id/tip_text" android:layout_width="180dp" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="点击右上角新增按钮添加你的第一个报销账户" android:lineSpacingExtra="3dp" />
                    </LinearLayout>
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/asset_list" android:paddingBottom="50dp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:overScrollMode="never" />
                </RelativeLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>