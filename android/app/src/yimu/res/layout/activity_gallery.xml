<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/gallery_info" android:background="@color/white" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@+id/gallery_choice" android:overScrollMode="never" android:paddingStart="10dp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/gallery_list" android:background="@color/white" android:visibility="invisible" android:layout_width="match_parent" android:layout_height="400dp" android:layout_below="@+id/gallery_choice" android:overScrollMode="never" />
    <RelativeLayout android:id="@+id/gallery_choice" android:background="@color/white" android:layout_width="match_parent" android:layout_height="50dp">
        <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_centerHorizontal="true" android:layout_centerVertical="true" android:layout_marginStart="20dp">
            <ImageView android:layout_gravity="center_vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@mipmap/ic_close_image_dialog" android:tint="@color/black" android:layout_marginEnd="8dp" />
            <TextView android:textSize="14sp" android:textColor="@color/darkGrey" android:gravity="center" android:id="@+id/gallery_name" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="@string/all_image" />
        </LinearLayout>
        <View android:background="@color/divider" android:layout_width="match_parent" android:layout_height="1px" android:layout_alignParentBottom="true" />
        <ImageView android:id="@+id/btn_back" android:background="?android:attr/selectableItemBackgroundBorderless" android:padding="16dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_back" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" />
        <TextView android:textSize="14sp" android:textColor="@color/darkGrey" android:gravity="center" android:id="@+id/complete" android:background="@drawable/selectable_item_circle" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="@string/complete" android:layout_centerVertical="true" android:paddingStart="15dp" android:paddingEnd="15dp" android:layout_alignParentEnd="true" />
    </RelativeLayout>
</RelativeLayout>