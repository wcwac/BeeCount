<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp">
        <RelativeLayout android:id="@+id/mould_type_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="55dp">
            <ImageView android:id="@+id/mould_type_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
            <TextView android:textSize="13sp" android:textColor="@color/darkGrey" android:id="@+id/mould_type" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="账单模板" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/mould_type_more" />
            <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="模板类型" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/export_path_layout" android:background="@drawable/selectable_item_expand_mask" android:visibility="gone" android:layout_width="match_parent" android:layout_height="55dp">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" android:layout_toStartOf="@+id/share_to">
                <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="导出路径" />
                <TextView android:textSize="12sp" android:textColor="@color/grey" android:id="@+id/export_path" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:singleLine="true" />
            </LinearLayout>
            <TextView android:textSize="13sp" android:textColor="@color/darkGrey" android:id="@+id/share_to" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="分享至" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/export_path_more" />
            <ImageView android:id="@+id/export_path_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
    </LinearLayout>
    <TextView android:textSize="12sp" android:textColor="@color/grey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="提示：\n1.日期，收支类型，金额列必填\n2.收支类型仅支持“支出”和“收入”\n3.复制金额和日期数据后，建议统一格式化一下金额和日期列数据\n4.多个标签请用空格隔开\n5.建议使用Office编辑文档" android:lineSpacingExtra="5dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
    <TextView android:textSize="15sp" android:textColor="@color/textColorLight" android:gravity="center" android:id="@+id/start_export" android:background="@drawable/selectable_item_primary_background" android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginTop="50dp" android:text="生成模板" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" />
</LinearLayout>