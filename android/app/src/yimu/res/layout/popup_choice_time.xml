<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/parent_layout" android:layout_width="wrap_content" android:layout_height="wrap_content">
    <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/background_layout" android:background="@drawable/background_home_popup" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <FrameLayout android:id="@+id/hour_picker" android:layout_width="80dp" android:layout_height="160dp" android:layout_marginStart="20dp" />
        <TextView android:textSize="30dp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/hour_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=":" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
        <FrameLayout android:id="@+id/minute_picker" android:layout_width="80dp" android:layout_height="160dp" android:layout_marginEnd="20dp" />
    </LinearLayout>
</RelativeLayout>