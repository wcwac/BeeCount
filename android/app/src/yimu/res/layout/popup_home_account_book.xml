<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/parent_layout" android:layout_width="wrap_content" android:layout_height="wrap_content">
    <LinearLayout android:orientation="vertical" android:id="@+id/background_layout" android:background="@drawable/background_home_popup" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <RelativeLayout android:id="@+id/add_account_book" android:background="@drawable/selectable_item_expand_mask" android:layout_width="200dp" android:layout_height="50dp" android:paddingStart="12dp">
            <ImageView android:id="@+id/add_icon" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_search_add" android:tint="@color/textColorPrimary" android:layout_centerVertical="true" android:layout_marginEnd="5dp" />
            <TextView android:textSize="15sp" android:textColor="@color/textColorPrimary" android:gravity="center_vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="新增账本" android:singleLine="true" android:layout_centerVertical="true" android:layout_toEndOf="@+id/add_icon" />
            <ImageView android:id="@+id/account_book_manager" android:padding="16.5dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_account_book_edit" android:tint="@color/iconTint" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/data_list" android:layout_width="200dp" android:layout_height="wrap_content" android:adjustViewBounds="true" app:maxHeight="500dp" />
    </LinearLayout>
</RelativeLayout>