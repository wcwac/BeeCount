<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/total_layout" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
    <LinearLayout android:gravity="center" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true">
        <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:textSize="14dp" android:textColor="@color/black" android:id="@+id/budget_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="本月预算" />
            <TextView android:textSize="11dp" android:textColor="@color/grey" android:id="@+id/budget_remark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="我是备注" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>