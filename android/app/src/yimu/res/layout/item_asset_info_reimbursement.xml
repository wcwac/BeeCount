<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_asset_header" android:padding="15dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp">
        <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="待报销" />
        <TextView android:textSize="22sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/number" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9999999" />
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/already_reimb_layout" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="已报销：" />
                <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/already_reimb_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9999999" />
            </LinearLayout>
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="总报销：" />
                <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/total_reimb_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9999999" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:gravity="center" android:orientation="horizontal" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginTop="15dp">
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/add_bill_btn" android:background="@drawable/selectable_item_expand_mask" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2">
            <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@mipmap/ic_add_bill" android:tint="@color/black" />
            <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="添加一条报销" android:layout_marginStart="10dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>