<?xml version='1.0' encoding='utf-8'?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/drawer_layout" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:background="@color/white" android:layout_width="match_parent" android:layout_height="match_parent">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="50dp">
            <EditText android:textSize="14sp" android:textColorHint="@color/grey" android:id="@+id/search_input" android:background="@color/white" android:layout_width="match_parent" android:layout_height="match_parent" android:hint="搜索账单、标签(输入#触发，空格结束)" android:singleLine="true" android:imeOptions="actionDone" android:layout_toStartOf="@+id/btn_layout" android:layout_toEndOf="@+id/btn_back" />
            <ImageView android:id="@+id/btn_back" android:background="@drawable/selectable_item_circle" android:padding="16dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_search_back" android:scaleType="fitCenter" android:tint="@color/black" />
            <LinearLayout android:orientation="horizontal" android:id="@+id/btn_layout" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_alignParentEnd="true">
                <ImageView android:id="@+id/btn_clear" android:background="@drawable/selectable_item_circle" android:padding="17dp" android:visibility="gone" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_close" android:scaleType="fitCenter" android:tint="@color/black" />
                <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/btn_filter" android:background="@drawable/selectable_item_circle" android:layout_width="wrap_content" android:layout_height="50dp" android:text="筛选" android:singleLine="true" android:paddingStart="10dp" android:paddingEnd="10dp" android:layout_marginEnd="5dp" />
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <LinearLayout android:orientation="vertical" android:id="@+id/search_history" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent">
                    <TextView android:textSize="13sp" android:textColor="@color/grey" android:gravity="center" android:layout_gravity="center_horizontal" android:id="@+id/clear_history_btn" android:background="?android:attr/selectableItemBackground" android:layout_width="wrap_content" android:layout_height="40dp" android:text="清空历史记录" />
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/search_history_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:overScrollMode="never" />
                </LinearLayout>
                <LinearLayout android:orientation="vertical" android:id="@+id/search_action_layout" android:background="@color/backgroundLight" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent">
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/search_action_list" android:background="@color/white" android:layout_width="match_parent" android:layout_height="wrap_content" android:overScrollMode="never" />
                </LinearLayout>
                <LinearLayout android:orientation="vertical" android:id="@+id/search_result_layout" android:background="@color/backgroundLight" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent">
                    <RelativeLayout android:background="@color/white" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <ImageView android:id="@+id/sort_bill" android:background="@drawable/selectable_item_circle" android:padding="8dp" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_sort" android:tint="@color/iconTint" android:layout_marginEnd="7dp" android:layout_alignParentEnd="true" />
                        <TextView android:textSize="12sp" android:textColor="@color/darkGrey" android:gravity="center_vertical" android:layout_width="wrap_content" android:layout_height="30dp" android:text="提示：长按账单可进入批量编辑模式" android:paddingStart="15sp" />
                    </RelativeLayout>
                    <RelativeLayout android:background="@color/white" android:layout_width="match_parent" android:layout_height="30dp">
                        <TextView android:textSize="12dp" android:textColor="@color/darkGrey" android:id="@+id/result_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="共找到3条记录" android:layout_centerVertical="true" android:layout_marginStart="15sp" />
                        <TextView android:textSize="12dp" android:textColor="@color/darkGrey" android:id="@+id/result_balance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="余 200.0" android:layout_centerVertical="true" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true" />
                        <TextView android:textSize="12dp" android:textColor="@color/darkGrey" android:id="@+id/result_pay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="支 200.0" android:layout_centerVertical="true" android:layout_marginEnd="15dp" android:layout_toStartOf="@+id/result_balance" />
                        <TextView android:textSize="12dp" android:textColor="@color/darkGrey" android:id="@+id/result_income" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="收 200.0" android:layout_centerVertical="true" android:layout_marginEnd="15dp" android:layout_toStartOf="@+id/result_pay" />
                    </RelativeLayout>
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/search_result_list" android:paddingBottom="80dp" android:clipChildren="false" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:overScrollMode="never" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout android:id="@+id/search_no_tip_layout" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
                    <include android:layout_width="150dp" android:layout_height="150dp" android:layout_marginBottom="10dp" android:layout_above="@+id/search_no_tip" android:layout_centerHorizontal="true" layout="@layout/layout_common_tip" />
                    <TextView android:textSize="14sp" android:textColor="@color/textGray" android:id="@+id/search_no_tip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="没有找到你想要的" android:layout_centerInParent="true" />
                </RelativeLayout>
            </RelativeLayout>
            <RelativeLayout android:id="@+id/search_tip_layout" android:layout_width="match_parent" android:layout_height="match_parent">
                <include android:layout_width="150dp" android:layout_height="150dp" android:layout_marginBottom="20dp" android:layout_above="@+id/search_tip" android:layout_centerHorizontal="true" layout="@layout/layout_search_tip" />
                <TextView android:textSize="12sp" android:textColor="@color/grey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="通过你能想到的所有条件来进行搜索" android:layout_below="@+id/search_tip" android:layout_centerInParent="true" />
                <TextView android:textSize="14sp" android:textColor="@color/darkGrey" android:id="@+id/search_tip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="账单太多？搜索一下" android:layout_centerInParent="true" />
            </RelativeLayout>
            <include android:id="@+id/edit_layout" android:visibility="invisible" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true" layout="@layout/layout_bill_edit" />
        </RelativeLayout>
        <View android:background="@color/divider" android:layout_width="match_parent" android:layout_height="1px" />
    </LinearLayout>
    <include android:layout_gravity="end" android:id="@+id/right_drawer_layout" android:layout_width="match_parent" android:layout_height="match_parent" layout="@layout/layout_right_drawer_layout" />
</androidx.drawerlayout.widget.DrawerLayout>