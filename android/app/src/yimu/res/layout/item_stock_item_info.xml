<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:id="@+id/total_layout" android:background="@drawable/selectable_item_expand_mask" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="15dp" android:paddingEnd="15dp">
    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:gravity="center_vertical" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/total_num">
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:textSize="13sp" android:textColor="@color/black" android:id="@+id/name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="易方达消费行业股票" android:singleLine="true" />
                <TextView android:textSize="12sp" android:textColor="@color/darkGrey" android:ellipsize="end" android:id="@+id/code" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="110022" android:singleLine="true" android:layout_marginStart="10dp" />
            </LinearLayout>
            <TextView android:textSize="12sp" android:textColor="@color/darkGrey" android:ellipsize="end" android:id="@+id/remark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="哈哈哈哈哈" android:singleLine="true" />
        </LinearLayout>
        <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/textColorBlack" android:id="@+id/total_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="888.88" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <LinearLayout android:orientation="horizontal" android:id="@+id/current_num_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp">
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:textSize="9sp" android:textColor="@color/grey" android:id="@+id/current_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="最新价：" />
            <TextView android:textSize="11sp" android:id="@+id/current_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+888.88" />
            <TextView android:textSize="11sp" android:id="@+id/current_num_add" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+1.9%" android:layout_marginStart="10dp" />
            <TextView android:textSize="11sp" android:id="@+id/current_num_rate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+1.9%" android:layout_marginStart="10dp" />
            <TextView android:textSize="11sp" android:id="@+id/current_num_arrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↑" android:layout_marginStart="2dp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp">
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:textSize="9sp" android:textColor="@color/grey" android:id="@+id/last_day_income_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="昨日收益：" />
            <TextView android:textSize="11sp" android:id="@+id/last_day_income" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+888.88" />
        </LinearLayout>
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="15dp">
            <TextView android:textSize="9sp" android:textColor="@color/grey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="累计盈亏：" />
            <TextView android:textSize="11sp" android:id="@+id/up_down_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+888.88" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>