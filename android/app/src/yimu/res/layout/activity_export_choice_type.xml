<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:background="@color/white" android:layout_width="match_parent" android:layout_height="wrap_content">
        <RelativeLayout android:id="@+id/save_local_layout" android:layout_width="match_parent" android:layout_height="55dp">
            <TextView android:textSize="15sp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/save_to_local" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
            <ImageView android:id="@+id/save_local_tick" android:layout_width="23dp" android:layout_height="23dp" android:src="@mipmap/ic_tick" android:tint="@color/textColorPrimary" android:layout_centerVertical="true" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/send_email_layout" android:layout_width="match_parent" android:layout_height="55dp">
            <TextView android:textSize="15sp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/send_to_email" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
            <ImageView android:id="@+id/send_email_tick" android:layout_width="23dp" android:layout_height="23dp" android:src="@mipmap/ic_tick" android:tint="@color/textColorPrimary" android:layout_centerVertical="true" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout android:orientation="vertical" android:id="@+id/email_set_layout" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:textSize="13sp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="10dp" android:text="邮箱地址" android:layout_marginStart="15dp" />
        <EditText android:textSize="15sp" android:textColor="@color/darkGrey" android:textColorHint="@color/grey" android:id="@+id/email_address" android:background="@color/white" android:layout_width="match_parent" android:layout_height="55dp" android:hint="请输入邮箱地址" android:singleLine="true" android:inputType="textEmailAddress" android:paddingStart="15dp" />
    </LinearLayout>
</LinearLayout>