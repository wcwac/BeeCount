<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:background="@drawable/dialog_user_agreement_bg" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="horizontal" android:id="@+id/choice_date" android:layout_width="match_parent" android:layout_height="50dp">
            <LinearLayout android:gravity="center" android:orientation="horizontal" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:paddingStart="20dp" android:paddingEnd="20dp">
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_book_more" android:tint="@color/black" />
                <TextView android:textSize="15sp" android:textColor="@color/black" android:id="@+id/date_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="所有时间" android:singleLine="true" />
            </LinearLayout>
            <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/choice_book" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:paddingStart="20dp" android:paddingEnd="20dp">
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_book_more" android:tint="@color/black" />
                <TextView android:textSize="15sp" android:textColor="@color/black" android:id="@+id/book_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="日常账本" android:singleLine="true" />
            </LinearLayout>
            <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/choice_asset" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:paddingStart="20dp" android:paddingEnd="20dp">
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_book_more" android:tint="@color/black" />
                <TextView android:textSize="15sp" android:textColor="@color/black" android:id="@+id/asset_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="所有账户" android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <EditText android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/search_layout" android:background="@drawable/bg_search_filter" android:layout_width="match_parent" android:layout_height="40dp" android:hint="输入关键词" android:paddingStart="15dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" />
            <ImageView android:id="@+id/btn_clear" android:background="@drawable/selectable_item_circle" android:padding="8dp" android:visibility="gone" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_clear" android:tint="@color/iconTint" android:layout_centerVertical="true" android:layout_marginEnd="25dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
    </LinearLayout>
    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="100dp" android:layout_marginBottom="60dp" android:layout_marginStart="10dp" android:layout_marginEnd="10dp">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/bill_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="200dp" />
        <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/tip_layout" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="20dp" android:layout_centerInParent="true">
            <include android:id="@+id/tip_image" android:layout_width="120dp" android:layout_height="120dp" android:layout_marginBottom="5dp" layout="@layout/layout_home_tip" />
            <TextView android:textSize="12sp" android:textColor="@color/textGray" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="没有任何账单" />
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout android:layout_gravity="bottom" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="20dp">
        <TextView android:textSize="15sp" android:textColor="@color/textGray" android:gravity="center" android:id="@+id/cancel" android:background="@drawable/selectable_item_expand_mask" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/cancel" android:layout_weight="1" />
        <TextView android:textSize="15sp" android:textColor="@color/colorPrimaryText" android:gravity="center" android:id="@+id/confirm" android:background="@drawable/selectable_item_expand_mask" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/confirm" android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>