<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="horizontal" android:background="@color/white" android:layout_width="match_parent" android:layout_height="70dp">
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="70dp">
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/periods" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="第1期" android:singleLine="true" />
            <TextView android:textSize="12sp" android:textColor="@color/darkGrey" android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="2020年11月19日" android:singleLine="true" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/number_layout" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:textSize="15sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/number" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15.99" android:singleLine="true" />
                <ImageView android:id="@+id/edit_image" android:layout_width="17dp" android:layout_height="17dp" android:src="@mipmap/ic_edit" android:layout_marginStart="5dp" />
            </LinearLayout>
            <TextView android:textSize="11sp" android:textColor="@color/grey" android:gravity="center" android:id="@+id/service" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="含利息0.95元" android:singleLine="true" />
        </LinearLayout>
        <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/repayment_day" android:layout_width="0dp" android:layout_height="match_parent" android:text="3.74" android:singleLine="true" android:layout_weight="1" />
    </LinearLayout>
</RelativeLayout>