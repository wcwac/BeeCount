<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:background="@color/white" android:layout_width="match_parent" android:layout_height="match_parent">
        <RelativeLayout android:id="@+id/tool_bar" android:layout_width="match_parent" android:layout_height="50dp">
            <ImageView android:id="@+id/btn_back" android:background="@drawable/selectable_item_circle" android:padding="17dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_close" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" />
            <TextView android:textSize="18sp" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/month" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="4月" android:layout_toEndOf="@+id/btn_back" />
            <ImageView android:id="@+id/btn_complete" android:background="@drawable/selectable_item_circle" android:padding="12dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_tick" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <com.wangc.bill.reference.ui.ReferenceCalendar android:id="@+id/calendarView" android:layout_width="match_parent" android:layout_height="wrap_content" app:calendar_padding="10dp" app:current_day_lunar_text_color="@color/colorPrimary" app:current_day_text_color="@color/colorPrimary" app:current_month_lunar_text_color="@color/grey" app:current_month_text_color="@color/darkGrey" app:max_year="2099" app:min_year="1980" app:month_view="com.wangc.bill.calendar.CustomMonthView" app:month_view_show_mode="mode_only_current" app:selected_lunar_text_color="@color/white" app:selected_text_color="@color/white" app:selected_theme_color="@color/colorPrimary" />
        <RelativeLayout android:orientation="horizontal" android:id="@+id/start_date_layout" android:background="@drawable/selectable_item_expand" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp">
            <TextView android:textSize="15sp" android:textColor="@color/textColorPrimary" android:id="@+id/start_date_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="起始日期" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
            <TextView android:textSize="15sp" android:textColor="@color/textColorPrimary" android:id="@+id/start_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2021年8月9日" android:layout_centerVertical="true" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true" />
            <View android:background="@color/divider" android:layout_width="match_parent" android:layout_height="1px" android:layout_alignParentBottom="true" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
        </RelativeLayout>
        <RelativeLayout android:orientation="horizontal" android:id="@+id/end_date_layout" android:background="@drawable/selectable_item_expand" android:layout_width="match_parent" android:layout_height="50dp">
            <TextView android:textSize="15sp" android:textColor="@color/grey" android:id="@+id/end_date_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="结束日期" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
            <TextView android:textSize="15sp" android:textColor="@color/grey" android:id="@+id/end_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2021年8月9日" android:layout_centerVertical="true" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true" />
            <View android:background="@color/divider" android:layout_width="match_parent" android:layout_height="1px" android:layout_alignParentBottom="true" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
        </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/date_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>