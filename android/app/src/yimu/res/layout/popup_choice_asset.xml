<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/parent_layout" android:layout_width="wrap_content" android:layout_height="wrap_content">
    <LinearLayout android:orientation="vertical" android:background="@drawable/background_translate_view" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="35dp" android:paddingStart="10dp">
            <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="35dp" android:layout_alignParentEnd="true">
                <TextView android:textSize="12sp" android:textStyle="bold" android:textColor="@color/textColorPrimary" android:gravity="center_vertical" android:id="@+id/group_asset" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="组合支付" android:layout_centerVertical="true" android:paddingStart="5dp" android:layout_marginEnd="5dp" />
                <ImageView android:id="@+id/change_mode" android:background="@drawable/selectable_item_circle" android:padding="11dp" android:layout_width="35dp" android:layout_height="35dp" android:src="@mipmap/ic_asset_choice_one" android:tint="@color/black" />
                <ImageView android:id="@+id/add_asset" android:background="@drawable/selectable_item_circle" android:padding="10dp" android:visibility="gone" android:layout_width="35dp" android:layout_height="35dp" android:src="@mipmap/ic_add" android:tint="@color/black" />
            </LinearLayout>
            <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="选择账户" android:layout_centerVertical="true" />
        </RelativeLayout>
        <FrameLayout android:id="@+id/background_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" app:maxHeight="300dp">
            <LinearLayout android:orientation="horizontal" android:id="@+id/group_list_layout" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <View android:background="@color/divider" android:layout_width="1px" android:layout_height="match_parent" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/group_list" android:layout_width="80dp" android:layout_height="wrap_content" android:overScrollMode="never" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/asset_list" android:layout_width="170dp" android:layout_height="wrap_content" android:overScrollMode="never" />
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/data_list" android:visibility="gone" android:layout_width="250dp" android:layout_height="wrap_content" android:overScrollMode="never" />
        </FrameLayout>
    </LinearLayout>
</RelativeLayout>