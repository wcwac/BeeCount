<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/white" android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:id="@+id/tool_bar" android:background="@color/white" android:layout_width="match_parent" android:layout_height="50dp">
        <ImageView android:id="@+id/btn_back" android:background="@drawable/selectable_item_circle" android:padding="16dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_back" android:scaleType="fitCenter" android:tint="@color/black" />
        <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="50dp" android:maxWidth="180dp" android:text="主题分享" android:singleLine="true" android:layout_toEndOf="@+id/btn_back" />
        <ImageView android:id="@+id/btn_delete" android:background="@drawable/selectable_item_circle" android:padding="14dp" android:visibility="gone" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_delete" android:scaleType="fitCenter" android:tint="@color/black" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <RelativeLayout android:id="@+id/cover_custom" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="50dp" android:layout_below="@+id/tool_bar" />
    <CheckBox android:textSize="15sp" android:textColor="@color/black" android:id="@+id/use_current_book" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="仅应用到当前账本" android:layout_above="@+id/use_theme" android:layout_centerHorizontal="true" style="@style/commonCheckBox" />
    <TextView android:textSize="15sp" android:textColor="@color/textColorWhite" android:gravity="center" android:id="@+id/use_theme" android:background="@drawable/selectable_item_primary_background" android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginBottom="10dp" android:text="使用此主题" android:layout_above="@+id/report" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" />
    <TextView android:textSize="13sp" android:textColor="@color/textColorPrimary" android:gravity="center" android:id="@+id/report" android:layout_width="match_parent" android:layout_height="35dp" android:layout_marginBottom="20dp" android:text="主题侵权举报" android:layout_alignParentBottom="true" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" />
</RelativeLayout>