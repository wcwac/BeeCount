<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
    <RelativeLayout android:id="@+id/time_layout" android:paddingTop="8dp" android:paddingBottom="3dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:textSize="10sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/date_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="10dp" />
        <TextView android:textSize="10sp" android:textColor="@color/darkGrey" android:id="@+id/week_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="星期二" android:layout_toEndOf="@+id/date_info" />
        <TextView android:textSize="10sp" android:textColor="@color/darkGrey" android:id="@+id/num_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0笔" android:layout_marginStart="10dp" android:layout_toEndOf="@+id/week_info" />
    </RelativeLayout>
    <RelativeLayout android:id="@+id/bill_layout" android:background="@drawable/selectable_item_expand" android:layout_width="match_parent" android:layout_height="35dp" android:paddingEnd="8dp">
        <LinearLayout android:gravity="center_vertical" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_centerVertical="true" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:layout_toStartOf="@+id/cost_layout">
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:textSize="11sp" android:textColor="@color/black" android:id="@+id/category" android:layout_width="0dp" android:layout_height="wrap_content" android:singleLine="true" android:layout_weight="1" />
                <TextView android:textSize="7sp" android:textColor="@color/reimbursement_text" android:id="@+id/reimbursement" android:background="@drawable/bg_reimbursement" android:paddingTop="1dp" android:paddingBottom="1dp" android:visibility="invisible" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="待报销" android:singleLine="true" android:paddingStart="2dp" android:paddingEnd="2dp" android:layout_marginStart="3dp" />
                <TextView android:textSize="7sp" android:textColor="@color/refund_text" android:id="@+id/refund" android:background="@drawable/bg_refund" android:paddingTop="1dp" android:paddingBottom="1dp" android:visibility="invisible" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="退" android:singleLine="true" android:paddingStart="2dp" android:paddingEnd="2dp" android:layout_marginStart="3dp" />
                <TextView android:textSize="7sp" android:textColor="@color/discount_text" android:id="@+id/discount" android:background="@drawable/bg_discount" android:paddingTop="1dp" android:paddingBottom="1dp" android:visibility="invisible" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="惠" android:singleLine="true" android:paddingStart="2dp" android:paddingEnd="2dp" android:layout_marginStart="3dp" />
            </LinearLayout>
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/second_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp">
                <ImageView android:id="@+id/has_file_tag" android:visibility="gone" android:layout_width="8dp" android:layout_height="8dp" android:src="@mipmap/ic_bill_has_file" android:tint="@color/darkGrey" android:layout_marginEnd="3dp" />
                <TextView android:textSize="8sp" android:ellipsize="end" android:gravity="center" android:id="@+id/tag_one" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="13dp" android:maxWidth="50dp" android:text="旅游账单" android:singleLine="true" android:paddingStart="3dp" android:paddingEnd="3dp" android:layout_marginEnd="3dp" />
                <TextView android:textSize="8sp" android:ellipsize="end" android:gravity="center" android:id="@+id/tag_two" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="13dp" android:maxWidth="50dp" android:text="旅游账单" android:singleLine="true" android:paddingStart="3dp" android:paddingEnd="3dp" android:layout_marginEnd="3dp" />
                <TextView android:textSize="8sp" android:ellipsize="end" android:gravity="center" android:id="@+id/tag_three" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="13dp" android:maxWidth="50dp" android:text="旅游账单" android:singleLine="true" android:paddingStart="3dp" android:paddingEnd="3dp" android:layout_marginEnd="3dp" />
                <TextView android:textSize="8sp" android:textColor="@color/colorPrimaryDark" android:ellipsize="end" android:id="@+id/create_user" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" />
                <TextView android:textSize="8sp" android:textColor="@color/darkGrey" android:ellipsize="end" android:id="@+id/remark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:gravity="end" android:orientation="vertical" android:id="@+id/cost_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_alignParentEnd="true">
            <TextView android:textSize="12sp" android:id="@+id/cost" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:textSize="8sp" android:textColor="@color/darkGrey" android:id="@+id/asset" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:maxWidth="120dp" android:text="支付宝" android:singleLine="true" />
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>