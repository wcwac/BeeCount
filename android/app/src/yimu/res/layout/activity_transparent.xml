<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/parent_layout" android:background="@color/blackAlpha25" android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:id="@+id/content_layout" android:background="@drawable/background_translate_view" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="200dp" android:layout_marginBottom="10dp" android:layout_alignParentBottom="true" android:layout_marginStart="10dp" android:layout_marginEnd="10dp">
        <LinearLayout android:orientation="horizontal" android:id="@+id/top_menu" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp">
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/book_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="wrap_content" android:layout_height="45dp" android:paddingStart="10dp" android:paddingEnd="10dp">
                <ImageView android:layout_gravity="center_vertical" android:id="@+id/book_icon" android:layout_width="17dp" android:layout_height="17dp" android:src="@mipmap/ic_account_book" android:scaleType="fitXY" />
                <TextView android:textSize="12sp" android:textColor="@color/black" android:id="@+id/book_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="70dp" android:text="日常账本" android:singleLine="true" android:includeFontPadding="false" android:layout_marginStart="5dp" />
            </LinearLayout>
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/asset_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="wrap_content" android:layout_height="45dp" android:paddingStart="10dp" android:paddingEnd="10dp">
                <ImageView android:layout_gravity="center_vertical" android:id="@+id/asset_icon" android:layout_width="17dp" android:layout_height="17dp" android:src="@mipmap/ic_no_asset" android:scaleType="fitXY" />
                <TextView android:textSize="12sp" android:textColor="@color/black" android:id="@+id/asset_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="70dp" android:text="无账户" android:singleLine="true" android:includeFontPadding="false" android:layout_marginStart="5dp" />
            </LinearLayout>
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/reimbursement_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="wrap_content" android:layout_height="45dp" android:paddingStart="10dp" android:paddingEnd="10dp">
                <ImageView android:layout_gravity="center_vertical" android:id="@+id/reimbursement_icon" android:layout_width="17dp" android:layout_height="17dp" android:src="@mipmap/ic_data_no_baoxiao" />
                <TextView android:textSize="12sp" android:textColor="@color/black" android:id="@+id/reimbursement_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="70dp" android:text="不报销" android:singleLine="true" android:includeFontPadding="false" android:layout_marginStart="5dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:id="@+id/top_transfer_menu" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp">
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/from_asset_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="wrap_content" android:layout_height="45dp" android:paddingStart="10dp" android:paddingEnd="10dp">
                <ImageView android:layout_gravity="center_vertical" android:id="@+id/from_asset_icon" android:layout_width="17dp" android:layout_height="17dp" android:src="@mipmap/ic_asset" android:scaleType="fitXY" />
                <TextView android:textSize="12sp" android:textColor="@color/black" android:id="@+id/from_asset_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="70dp" android:text="无账户" android:singleLine="true" android:includeFontPadding="false" android:layout_marginStart="5dp" />
            </LinearLayout>
            <ImageView android:layout_gravity="center_vertical" android:layout_width="17dp" android:layout_height="17dp" android:src="@mipmap/ic_arrow_right" android:scaleType="fitXY" android:tint="@color/black" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" />
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/to_asset_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="wrap_content" android:layout_height="45dp" android:paddingStart="10dp" android:paddingEnd="10dp">
                <ImageView android:layout_gravity="center_vertical" android:id="@+id/to_asset_icon" android:layout_width="17dp" android:layout_height="17dp" android:src="@mipmap/ic_asset" android:scaleType="fitXY" />
                <TextView android:textSize="12sp" android:textColor="@color/black" android:id="@+id/to_asset_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="70dp" android:text="无账户" android:singleLine="true" android:includeFontPadding="false" android:layout_marginStart="5dp" />
            </LinearLayout>
        </LinearLayout>
        <ImageView android:id="@+id/btn_expand" android:background="@drawable/selectable_item_circle" android:padding="14dp" android:layout_width="45dp" android:layout_height="45dp" android:src="@mipmap/ic_expand" android:tint="@color/black" android:layout_marginEnd="4dp" android:layout_alignParentEnd="true" />
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="45dp">
            <View android:background="@color/grey" android:layout_width="match_parent" android:layout_height="1px" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
            <EditText android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:gravity="start" android:id="@+id/word_edit" android:background="@color/translate" android:paddingTop="20dp" android:paddingBottom="20dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="试试“工资卡收入100元”、“昨天打车20元”\10“支付宝转到微信15元”、“长按可再记" android:singleLine="true" android:lineSpacingExtra="5dp" android:imeOptions="actionDone" android:layout_marginStart="15dp" android:layout_toStartOf="@+id/send_btn" />
            <ImageView android:id="@+id/send_btn" android:background="@drawable/selectable_item_circle" android:padding="12dp" android:layout_width="45dp" android:layout_height="45dp" android:src="@mipmap/ic_send" android:tint="@color/black" android:layout_centerVertical="true" android:layout_marginEnd="4dp" android:layout_alignParentEnd="true" />
            <RelativeLayout android:id="@+id/speech_content_layout" android:background="@color/white" android:padding="15dp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent">
                <TextView android:textSize="16sp" android:textColor="@color/textColorPrimary" android:id="@+id/speech_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="说出你要记录的账单" android:layout_centerHorizontal="true" android:layout_marginStart="10dp" android:layout_toEndOf="@+id/spin_kit" />
                <ProgressBar android:id="@+id/spin_kit" android:padding="10dp" android:layout_width="45dp" android:layout_height="45dp" app:SpinKit_Color="@color/colorPrimary" />
                <TextView android:textSize="13sp" android:textColor="@color/grey" android:id="@+id/cancel_tip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="手指上滑，取消输入" android:layout_below="@+id/speech_status" android:layout_alignStart="@+id/speech_status" />
            </RelativeLayout>
        </RelativeLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:layout_marginStart="5dp">
            <RelativeLayout android:id="@+id/calendar_btn" android:background="@drawable/selectable_item_circle" android:layout_width="40dp" android:layout_height="40dp">
                <ImageView android:padding="10dp" android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_calendar" android:tint="@color/black" />
                <TextView android:textSize="7sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/date_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="11" android:layout_centerInParent="true" />
            </RelativeLayout>
            <ImageView android:id="@+id/tag_btn" android:background="@drawable/selectable_item_circle" android:padding="10dp" android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_tag" android:tint="@color/black" />
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/category_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="wrap_content" android:layout_height="40dp" android:paddingStart="10dp" android:paddingEnd="10dp">
                <ImageView android:layout_gravity="center_vertical" android:id="@+id/category_icon" android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_category" android:tint="@color/black" />
                <TextView android:textSize="12sp" android:textColor="@color/black" android:id="@+id/category_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="暂无分类" android:singleLine="true" android:includeFontPadding="false" android:layout_marginStart="5dp" />
            </LinearLayout>
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/money_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="wrap_content" android:layout_height="40dp" android:paddingStart="10dp" android:paddingEnd="10dp">
                <ImageView android:layout_gravity="center_vertical" android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_money" android:tint="@color/black" />
                <TextView android:textSize="12sp" android:textColor="@color/black" android:id="@+id/money_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="70dp" android:text="0.00" android:singleLine="true" android:layout_marginStart="5dp" />
            </LinearLayout>
        </LinearLayout>
        <ImageView android:id="@+id/speech_layout" android:background="@drawable/selectable_item_circle" android:padding="13dp" android:layout_width="45dp" android:layout_height="45dp" android:src="@mipmap/ic_speech" android:tint="@color/black" android:layout_alignParentBottom="true" android:layout_marginEnd="4dp" android:layout_alignParentEnd="true" />
    </RelativeLayout>
</RelativeLayout>