<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:gravity="center_vertical" android:id="@+id/total_layout" android:background="@color/translate" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="wrap_content">
    <ImageView android:id="@+id/background" android:clickable="false" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:layout_alignBottom="@+id/content_layout" />
    <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/content_layout" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textSize="13sp" android:textColor="@color/white" android:id="@+id/budget_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="剩余预算" android:layout_centerVertical="true" />
            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/white" android:id="@+id/budget_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3500.6/5000" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <ImageView android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="8dp" />
        <RelativeLayout android:id="@+id/month_pay_layout" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
            <TextView android:textSize="13sp" android:textColor="@color/white" android:id="@+id/month_pay_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="预算支出" android:layout_centerVertical="true" />
            <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/white" android:id="@+id/month_pay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="350" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/day_average_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
            <TextView android:textSize="13sp" android:textColor="@color/white" android:id="@+id/day_average_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="日均支出" />
            <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/white" android:id="@+id/day_average" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="350" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/budget_day_surplus_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
            <TextView android:textSize="13sp" android:textColor="@color/white" android:id="@+id/budget_day_surplus_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="剩余日均" android:layout_centerVertical="true" />
            <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/white" android:id="@+id/budget_day_surplus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="350" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/budget_day_remain_layout" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
            <TextView android:textSize="13sp" android:textColor="@color/white" android:id="@+id/budget_day_remain_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="今日剩余" android:layout_centerVertical="true" />
            <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/white" android:id="@+id/budget_day_remain" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="350" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
        </RelativeLayout>
    </LinearLayout>
    <RelativeLayout android:id="@+id/open_vip_layout" android:background="@drawable/shape_bg_black25_15" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent">
        <TextView android:textSize="15sp" android:textColor="@color/white" android:gravity="center" android:id="@+id/open_vip" android:background="@drawable/shape_bg_open_vip_btn" android:layout_width="150dp" android:layout_height="50dp" android:layout_marginBottom="30dp" android:text="立即开通" android:layout_alignParentBottom="true" android:layout_centerHorizontal="true" />
    </RelativeLayout>
</RelativeLayout>