<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/background" android:background="@color/whiteAlpha95" android:layout_width="match_parent" android:layout_height="match_parent">
    <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="60dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" app:cardBackgroundColor="@color/colorPrimary" app:cardCornerRadius="10dp">
        <RelativeLayout android:paddingTop="20dp" android:paddingBottom="20dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="15dp" android:paddingEnd="15dp">
            <RelativeLayout android:id="@+id/title_layout" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:textSize="18sp" android:textColor="@color/textColorWhite" android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="高级自定义统计" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginEnd="15dp" android:layout_toStartOf="@+id/btn_layout" />
                <androidx.cardview.widget.CardView android:id="@+id/btn_layout" android:layout_width="100dp" android:layout_height="30dp" android:layout_centerVertical="true" android:layout_alignParentEnd="true" app:cardBackgroundColor="@color/white" app:cardCornerRadius="5dp">
                    <TextView android:textSize="13sp" android:textColor="@color/textColorPrimary" android:gravity="center" android:id="@+id/confirm" android:layout_width="match_parent" android:layout_height="match_parent" android:text="升级为会员" />
                </androidx.cardview.widget.CardView>
            </RelativeLayout>
            <TextView android:textSize="13sp" android:textColor="@color/textColorWhite" android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="vip功能的描述" android:layout_below="@+id/title_layout" android:lineSpacingExtra="5dp" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>