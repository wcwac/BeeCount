<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:id="@+id/total_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
    <RelativeLayout android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="35dp">
        <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/textColorPrimary" android:id="@+id/group_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="哦哦哦" android:singleLine="true" android:layout_centerVertical="true" />
        <ImageView android:id="@+id/arrow" android:padding="3dp" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more_down" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/child_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:overScrollMode="never" />
</LinearLayout>