<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="50dp">
    <ImageView android:id="@+id/cover" android:padding="5dp" android:layout_width="35dp" android:layout_height="35dp" android:src="@mipmap/ic_file_dir" android:tint="@color/colorPrimary" android:layout_centerVertical="true" android:layout_marginStart="10dp" />
    <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="10dp" android:layout_toEndOf="@+id/cover">
        <TextView android:textSize="13sp" android:textColor="@color/darkGrey" android:id="@+id/name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="全部图片" android:singleLine="true" />
    </LinearLayout>
    <View android:background="@color/divider" android:layout_width="match_parent" android:layout_height="1px" android:layout_alignParentBottom="true" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
</RelativeLayout>