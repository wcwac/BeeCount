<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/parent_layout" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:id="@+id/calendarLayout" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@+id/tool_bar" app:calendar_content_view_id="@+id/data_all_layout" app:default_status="expand">
        <com.wangc.bill.reference.ui.ReferenceCalendar android:id="@+id/calendarView" android:layout_width="match_parent" android:layout_height="wrap_content" app:calendar_padding="10dp" app:current_day_lunar_text_color="@color/colorPrimary" app:current_day_text_color="@color/colorPrimary" app:current_month_lunar_text_color="@color/grey" app:current_month_text_color="@color/darkGrey" app:day_text_size="14sp" app:max_year="2099" app:min_year="1980" app:month_view="com.wangc.bill.calendar.ActivityMonthView" app:month_view_show_mode="mode_only_current" app:selected_lunar_text_color="@color/white" app:selected_text_color="@color/white" app:selected_theme_color="@color/colorPrimary" app:week_view="com.wangc.bill.calendar.CustomWeekView" />
        <RelativeLayout android:id="@+id/data_all_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@+id/calendarView">
            <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/tip_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="70dp" android:layout_centerHorizontal="true">
                <include android:layout_width="150dp" android:layout_height="150dp" layout="@layout/layout_calendar_tip" />
                <TextView android:textSize="13sp" android:textColor="@color/textGray" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="这一天你还没有任何记账" />
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:id="@+id/data_layout" android:layout_width="match_parent" android:layout_height="wrap_content">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="30dp">
                    <TextView android:textSize="12dp" android:textColor="@color/darkGrey" android:id="@+id/date_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
                    <TextView android:textSize="12dp" android:textColor="@color/darkGrey" android:id="@+id/date_lunar_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:layout_centerVertical="true" android:layout_marginStart="10dp" android:layout_toEndOf="@+id/date_text" />
                    <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/pay_layout">
                        <TextView android:textSize="12dp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="收" />
                        <TextView android:textSize="12dp" android:textColor="@color/moneyIncome" android:id="@+id/income" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="200.0" android:layout_marginStart="4dp" />
                    </LinearLayout>
                    <LinearLayout android:orientation="horizontal" android:id="@+id/pay_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/balance_layout">
                        <TextView android:textSize="12dp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="支" />
                        <TextView android:textSize="12dp" android:textColor="@color/moneyPay" android:id="@+id/pay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="200.0" android:layout_marginStart="4dp" />
                    </LinearLayout>
                    <LinearLayout android:orientation="horizontal" android:id="@+id/balance_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true">
                        <TextView android:textSize="12dp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="余" />
                        <TextView android:textSize="12dp" android:textColor="@color/black" android:id="@+id/balance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="200.0" android:layout_marginStart="4dp" />
                    </LinearLayout>
                </RelativeLayout>
                <androidx.core.widget.NestedScrollView android:id="@+id/scroll_layout" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="50dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <androidx.recyclerview.widget.RecyclerView android:id="@+id/repayment_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:overScrollMode="never" />
                        <androidx.recyclerview.widget.RecyclerView android:id="@+id/data_list" android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never" />
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
    <RelativeLayout android:id="@+id/tool_bar" android:layout_width="match_parent" android:layout_height="55dp">
        <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="15dp">
            <TextView android:textSize="17dp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/month" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="4月" />
            <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp">
                <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp">
                    <TextView android:textSize="11dp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="收" />
                    <TextView android:textSize="11dp" android:textColor="@color/moneyIncome" android:id="@+id/month_income" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="200.0" android:layout_marginStart="2dp" />
                </LinearLayout>
                <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp">
                    <TextView android:textSize="11dp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="支" />
                    <TextView android:textSize="11dp" android:textColor="@color/moneyPay" android:id="@+id/month_pay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="200.0" android:layout_marginStart="2dp" />
                </LinearLayout>
                <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
                    <TextView android:textSize="11dp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="余" />
                    <TextView android:textSize="11dp" android:textColor="@color/black" android:id="@+id/month_balance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="200.0" android:layout_marginStart="2dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <ImageView android:id="@+id/back_today" android:background="@drawable/selectable_item_circle" android:padding="10dp" android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_back_today" android:tint="@color/black" android:layout_centerVertical="true" android:layout_toStartOf="@+id/add_bill" />
        <ImageView android:id="@+id/add_bill" android:background="@drawable/selectable_item_circle" android:padding="10dp" android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_menu_add_bill" android:tint="@color/textColorPrimary" android:layout_centerVertical="true" android:layout_toStartOf="@+id/btn_more" />
        <ImageView android:id="@+id/btn_more" android:background="@drawable/selectable_item_circle" android:padding="10dp" android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_menu" android:tint="@color/textColorPrimary" android:layout_centerVertical="true" android:layout_marginEnd="5dp" android:layout_alignParentEnd="true" />
    </RelativeLayout>
</RelativeLayout>