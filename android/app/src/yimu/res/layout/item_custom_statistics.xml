<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/parent_layout" android:background="@drawable/shape_bg_theme_content_10" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="15dp" android:layout_marginEnd="15dp">
    <ImageView android:id="@+id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" app:corner_radius="@dimen/common_radius" app:oval="false" />
    <LinearLayout android:gravity="center" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginStart="10dp" android:layout_marginEnd="10dp">
        <ImageView android:id="@+id/icon" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_custom_module_statistics" />
        <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="本月收支" android:singleLine="true" android:layout_marginStart="5dp" />
    </LinearLayout>
    <LinearLayout android:gravity="end" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:layout_alignParentBottom="true" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true">
        <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="@color/moneyPay" android:id="@+id/pay_number" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-0.00" android:singleLine="true" />
        <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="@color/moneyIncome" android:id="@+id/income_number" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="+0.00" android:singleLine="true" />
    </LinearLayout>
</RelativeLayout>