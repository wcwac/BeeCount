<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="75dp" android:layout_marginTop="15dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
