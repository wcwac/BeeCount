<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
            <TextView android:textSize="12dp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:text="我们建议您至少开启「云备份」或「WebDAV备份」其中一项，以防止恢复出厂设置、手机损坏遗失而导致数据丢失。\n部分「换机助手」迁移数据时，不支持「金融类」数据的转移，如果您只开启了「本地备份」，请勿轻易将手机恢复出厂设置。" android:lineSpacingExtra="4dp" />
            <RelativeLayout android:id="@+id/local_status_layout" android:background="@drawable/shape_bg_setting" android:paddingTop="15dp" android:paddingBottom="15dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="15dp" android:paddingEnd="15dp">
                <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="15dp">
                    <LinearLayout android:gravity="center" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@mipmap/ic_backup_local" android:layout_marginEnd="8dp" />
                        <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="本地备份" />
                    </LinearLayout>
                    <TextView android:textSize="12sp" android:textColor="@color/grey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="将数据加密存储在本地。卸载重装后，前往「数据备份-恢复本地备份」即可恢复数据。恢复出厂设置或者手机无法开机时，会导致数据丢失" android:lineSpacingExtra="3dp" />
                </LinearLayout>
                <TextView android:textSize="13sp" android:textColor="@color/colorWechat" android:id="@+id/local_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="已开启" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <RelativeLayout android:id="@+id/remote_status_layout" android:background="@drawable/shape_bg_setting" android:paddingTop="15dp" android:paddingBottom="15dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="15dp">
                    <LinearLayout android:gravity="center" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@mipmap/ic_backup_cloud" android:layout_marginEnd="8dp" />
                        <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="云备份" />
                    </LinearLayout>
                    <TextView android:textSize="12sp" android:textColor="@color/grey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="将数据存储在服务器。卸载重装后，打开「数据备份-云备份」即可恢复数据，数据不会丢失" android:lineSpacingExtra="3dp" />
                </LinearLayout>
                <TextView android:textSize="13sp" android:textColor="@color/colorWechat" android:id="@+id/remote_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="已开启" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <RelativeLayout android:id="@+id/webdav_status_layout" android:background="@drawable/shape_bg_setting" android:paddingTop="15dp" android:paddingBottom="15dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="15dp">
                    <LinearLayout android:gravity="center" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@mipmap/ic_backup_webdav" android:layout_marginEnd="8dp" />
                        <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WebDAV备份" />
                    </LinearLayout>
                    <TextView android:textSize="12sp" android:textColor="@color/grey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="将数据存储在私有网盘，网盘需支持WebDAV协议。卸载重装后，前往「数据备份-恢复网盘备份」即可恢复数据，数据不会丢失" android:lineSpacingExtra="3dp" />
                </LinearLayout>
                <TextView android:textSize="13sp" android:textColor="@color/red" android:id="@+id/webdav_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="未开启" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>