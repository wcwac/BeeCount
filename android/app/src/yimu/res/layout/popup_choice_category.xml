<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/parent_layout" android:layout_width="match_parent" android:layout_height="wrap_content">
    <RelativeLayout android:id="@+id/background_layout" android:background="@drawable/dialog_user_agreement_bg" android:paddingBottom="20dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/menu_layout" android:layout_width="wrap_content" android:layout_height="50dp" android:layout_marginStart="20dp">
            <TextView android:textSize="15dp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" android:id="@+id/pay_btn" android:layout_width="60dp" android:layout_height="match_parent" android:text="@string/income" />
            <TextView android:textSize="13dp" android:textColor="@color/grey" android:gravity="center" android:id="@+id/income_btn" android:layout_width="60dp" android:layout_height="match_parent" android:text="@string/pay" />
        </LinearLayout>
        <TextView android:textSize="15dp" android:textColor="@color/textColorPrimary" android:gravity="center" android:id="@+id/confirm_btn" android:layout_width="70dp" android:layout_height="50dp" android:text="确定" android:layout_alignParentEnd="true" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/category_list" android:layout_width="wrap_content" android:layout_height="wrap_content" android:adjustViewBounds="true" android:layout_below="@+id/menu_layout" />
    </RelativeLayout>
</RelativeLayout>