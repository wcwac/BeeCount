<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:id="@+id/tool_bar" android:background="@color/white" android:layout_width="match_parent" android:layout_height="50dp">
        <ImageView android:id="@+id/btn_back" android:background="@drawable/selectable_item_circle" android:padding="16dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_back" android:scaleType="fitCenter" android:tint="@color/black" />
        <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="50dp" android:maxWidth="180dp" android:text="定存记录" android:singleLine="true" android:layout_toEndOf="@+id/btn_back" />
        <ImageView android:id="@+id/btn_add" android:background="@drawable/selectable_item_circle" android:padding="15dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_add_asset" android:scaleType="fitXY" android:tint="@color/black" android:layout_alignParentEnd="true" />
        <TextView android:textSize="15sp" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/btn_sort" android:background="@drawable/selectable_item_circle" android:layout_width="wrap_content" android:layout_height="50dp" android:text="排序" android:singleLine="true" android:paddingStart="10dp" android:paddingEnd="10dp" android:layout_toStartOf="@+id/btn_add" />
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/fixed_deposit_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:layout_below="@+id/tool_bar" android:overScrollMode="never" />
    <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/no_data_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true">
        <include android:layout_width="150dp" android:layout_height="150dp" android:layout_marginBottom="10dp" layout="@layout/layout_common_tip" />
        <TextView android:textSize="14sp" android:textColor="@color/textGray" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="当前账户没有任何记录" />
    </LinearLayout>
</RelativeLayout>