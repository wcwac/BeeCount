<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/parent_layout" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp" android:paddingStart="15dp" android:paddingEnd="15dp">
            <ImageView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" />
            <RelativeLayout android:id="@+id/change_type" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="55dp">
                <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="类型" android:layout_centerVertical="true" />
                <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_centerVertical="true" android:layout_marginStart="60dp" android:layout_alignParentEnd="true">
                    <ImageView android:id="@+id/type_icon" android:background="@drawable/shape_type_normal" android:padding="6dp" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_parent_alipay" android:layout_marginEnd="10dp" />
                    <TextView android:textSize="13sp" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/bill_type" android:background="@color/translate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="支付宝" />
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout android:layout_width="match_parent" android:layout_height="55dp">
                <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="金额" android:layout_centerVertical="true" />
                <EditText android:textSize="14sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:id="@+id/bill_num" android:background="@color/transparent" android:layout_width="match_parent" android:layout_height="match_parent" android:text="-11.33" android:singleLine="true" android:layout_centerVertical="true" android:inputType="numberDecimal" android:layout_marginStart="60dp" android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <RelativeLayout android:id="@+id/time_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="55dp">
                <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="时间" android:layout_centerVertical="true" />
                <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/bill_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2020.5.22" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="60dp" android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <RelativeLayout android:id="@+id/account_book_layout" android:background="@drawable/selectable_item_expand" android:layout_width="match_parent" android:layout_height="55dp">
                <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="账本" android:layout_centerVertical="true" />
                <TextView android:textSize="13sp" android:textColor="@color/black" android:id="@+id/account_book" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="日常账本" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <RelativeLayout android:id="@+id/asset_layout" android:background="@drawable/selectable_item_expand" android:layout_width="match_parent" android:layout_height="55dp">
                <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="账户" android:layout_centerVertical="true" />
                <TextView android:textSize="13sp" android:textColor="@color/black" android:id="@+id/asset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="无账户" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <RelativeLayout android:layout_width="match_parent" android:layout_height="55dp">
                <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="备注" android:layout_centerVertical="true" />
                <EditText android:textSize="13sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:id="@+id/bill_content" android:background="@color/transparent" android:layout_width="match_parent" android:layout_height="match_parent" android:singleLine="true" android:layout_centerVertical="true" android:imeOptions="actionDone" android:layout_marginStart="100dp" android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <RelativeLayout android:id="@+id/tag_layout" android:background="@drawable/selectable_item_expand" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="标签" android:layout_centerVertical="true" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/tag_list" android:paddingTop="5dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="50dp" android:layout_centerVertical="true" android:layout_marginStart="100dp" android:layout_alignParentEnd="true" />
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>