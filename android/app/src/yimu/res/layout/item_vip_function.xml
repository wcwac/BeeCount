<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="horizontal" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:textSize="13dp" android:textColor="@color/black" android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:text="多种日历视图" android:singleLine="true" android:layout_weight="3" />
    <RelativeLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2">
        <TextView android:textSize="12dp" android:textColor="@color/grey" android:id="@+id/vip_content" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="199个" android:singleLine="true" />
        <ImageView android:id="@+id/vip_icon" android:visibility="gone" android:layout_width="20dp" android:layout_height="20dp" android:src="@mipmap/ic_vip_right" />
    </RelativeLayout>
    <RelativeLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2">
        <TextView android:textSize="12dp" android:textColor="@color/grey" android:id="@+id/free_content" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3个" android:singleLine="true" />
        <ImageView android:id="@+id/free_icon" android:visibility="gone" android:layout_width="20dp" android:layout_height="20dp" android:src="@mipmap/ic_vip_no" />
    </RelativeLayout>
</LinearLayout>