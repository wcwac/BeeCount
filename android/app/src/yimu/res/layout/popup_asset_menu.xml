<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:id="@+id/parent_layout" android:background="@drawable/background_home_popup" android:layout_width="200dp" android:layout_height="wrap_content">
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/asset_search" android:background="@drawable/selectable_item_expand_mask" android:layout_width="200dp" android:layout_height="50dp" android:paddingStart="12dp" android:paddingEnd="15sp">
        <ImageView android:padding="4dp" android:layout_width="25dp" android:layout_height="25dp" android:src="@mipmap/ic_search" android:tint="@color/black" />
        <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="搜索账户" android:layout_marginStart="6dp" />
    </LinearLayout>
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/asset_book" android:background="@drawable/selectable_item_expand_mask" android:layout_width="200dp" android:layout_height="50dp" android:paddingStart="12dp" android:paddingEnd="15sp">
        <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@mipmap/ic_asset_book" android:tint="@color/black" />
        <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="生效账本" android:layout_marginStart="6dp" />
    </LinearLayout>
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/fixed_deposit" android:background="@drawable/selectable_item_expand_mask" android:layout_width="200dp" android:layout_height="50dp" android:paddingStart="12dp" android:paddingEnd="15sp">
        <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@mipmap/ic_asset_fixed" android:tint="@color/black" />
        <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="定期存款" android:layout_marginStart="6dp" />
    </LinearLayout>
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/asset_statistics" android:background="@drawable/selectable_item_expand_mask" android:visibility="gone" android:layout_width="200dp" android:layout_height="50dp" android:paddingStart="12dp" android:paddingEnd="15sp">
        <ImageView android:padding="4dp" android:layout_width="25dp" android:layout_height="25dp" android:src="@mipmap/ic_statistics" android:tint="@color/black" />
        <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="资产统计" android:layout_marginStart="6dp" />
    </LinearLayout>
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/more_data" android:background="@drawable/selectable_item_expand_mask" android:layout_width="200dp" android:layout_height="50dp" android:paddingStart="12dp" android:paddingEnd="15sp">
        <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@mipmap/ic_asset_more" android:tint="@color/black" />
        <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="更多数据" android:layout_marginStart="6dp" />
    </LinearLayout>
    <TextView android:textSize="15sp" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/assets_into_total" android:background="@drawable/selectable_item_expand_mask" android:visibility="gone" android:layout_width="200dp" android:layout_height="50dp" android:text="资产组成" android:singleLine="true" android:paddingStart="15dp" android:paddingEnd="15sp" />
</LinearLayout>