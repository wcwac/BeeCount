<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:id="@+id/parent_layout" android:background="@drawable/background_home_popup" android:layout_width="160dp" android:layout_height="wrap_content">
    <TextView android:textSize="15sp" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/add_fund" android:background="@drawable/selectable_item_expand_mask" android:layout_width="160dp" android:layout_height="50dp" android:text="基金" android:singleLine="true" android:paddingStart="15dp" android:paddingEnd="15sp" />
    <TextView android:textSize="15sp" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/add_monetary_fund" android:background="@drawable/selectable_item_expand_mask" android:layout_width="160dp" android:layout_height="50dp" android:text="基金（货币型）" android:singleLine="true" android:paddingStart="15dp" android:paddingEnd="15sp" />
    <TextView android:textSize="15sp" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/add_stock_cn_local" android:background="@drawable/selectable_item_expand_mask" android:layout_width="160dp" android:layout_height="50dp" android:text="股票（沪深）" android:singleLine="true" android:paddingStart="15dp" android:paddingEnd="15sp" />
    <TextView android:textSize="15sp" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/add_stock_hk" android:background="@drawable/selectable_item_expand_mask" android:layout_width="160dp" android:layout_height="50dp" android:text="港股" android:singleLine="true" android:paddingStart="15dp" android:paddingEnd="15sp" />
    <TextView android:textSize="15sp" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/add_stock_usa" android:background="@drawable/selectable_item_expand_mask" android:layout_width="160dp" android:layout_height="50dp" android:text="美股" android:singleLine="true" android:paddingStart="15dp" android:paddingEnd="15sp" />
    <TextView android:textSize="15sp" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/add_future" android:background="@drawable/selectable_item_expand_mask" android:layout_width="160dp" android:layout_height="50dp" android:text="期货/贵金属" android:singleLine="true" android:paddingStart="15dp" android:paddingEnd="15sp" />
    <TextView android:textSize="15sp" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/add_gold" android:background="@drawable/selectable_item_expand_mask" android:visibility="gone" android:layout_width="160dp" android:layout_height="50dp" android:text="黄金" android:singleLine="true" android:paddingStart="15dp" android:paddingEnd="15sp" />
    <TextView android:textSize="15sp" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/add_self" android:background="@drawable/selectable_item_expand_mask" android:layout_width="160dp" android:layout_height="50dp" android:text="自定义理财" android:singleLine="true" android:paddingStart="15dp" android:paddingEnd="15sp" />
</LinearLayout>