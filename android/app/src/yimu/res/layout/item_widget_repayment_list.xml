<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/total_layout" android:paddingTop="5dp" android:paddingBottom="5dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="10dp">
    <ImageView android:id="@+id/icon" android:layout_width="13dp" android:layout_height="13dp" android:layout_marginTop="2dp" android:src="@mipmap/ic_bank_anshan" />
    <RelativeLayout android:gravity="center_vertical" android:orientation="vertical" android:id="@+id/bill_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="5dp" android:layout_toEndOf="@+id/icon">
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/cost">
            <TextView android:textSize="12dp" android:textColor="@color/black" android:ellipsize="end" android:id="@+id/asset_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="招商银行信用卡" android:singleLine="true" />
            <TextView android:textSize="11dp" android:textColor="@color/grey" android:ellipsize="end" android:id="@+id/time_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="3天后待还300.00" android:singleLine="true" />
        </LinearLayout>
        <TextView android:textSize="12dp" android:textStyle="bold" android:textColor="@color/black" android:ellipsize="end" android:id="@+id/cost" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="300.00" android:singleLine="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
    </RelativeLayout>
</RelativeLayout>