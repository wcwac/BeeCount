<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:id="@+id/tool_bar" android:background="@color/white" android:layout_width="match_parent" android:layout_height="50dp">
        <ImageView android:id="@+id/btn_back" android:background="@drawable/selectable_item_circle" android:padding="17dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_close" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" />
        <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="180dp" android:text="买入基金" android:singleLine="true" android:layout_centerVertical="true" android:layout_toEndOf="@+id/btn_back" />
        <ImageView android:id="@+id/btn_delete" android:background="@drawable/selectable_item_circle" android:padding="14dp" android:visibility="gone" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_delete" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" android:layout_toStartOf="@+id/btn_complete" />
        <ImageView android:id="@+id/btn_complete" android:background="@drawable/selectable_item_circle" android:padding="12dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_tick" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never">
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:orientation="horizontal" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp">
                <LinearLayout android:gravity="end" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="15dp" android:layout_marginEnd="15dp">
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:id="@+id/cost_title" android:layout_width="wrap_content" android:layout_height="50dp" android:text="价格" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:id="@+id/num_title" android:layout_width="wrap_content" android:layout_height="50dp" android:text="数量" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:id="@+id/service_charge_title" android:layout_width="wrap_content" android:layout_height="50dp" android:text="手续费" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:id="@+id/remark_title" android:layout_width="wrap_content" android:layout_height="50dp" android:text="备注" />
                </LinearLayout>
                <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginEnd="15dp">
                        <EditText android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/cost" android:background="@color/translate" android:layout_width="match_parent" android:layout_height="50dp" android:hint="请输入买入的确认净值" android:singleLine="true" android:inputType="numberDecimal" />
                    </RelativeLayout>
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginEnd="15dp">
                        <EditText android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/num" android:background="@color/translate" android:layout_width="match_parent" android:layout_height="50dp" android:hint="请输入买入的确认份额" android:singleLine="true" android:inputType="numberDecimal" />
                    </RelativeLayout>
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginEnd="15dp">
                        <EditText android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/service_charge" android:background="@color/translate" android:layout_width="match_parent" android:layout_height="50dp" android:hint="请输入交易手续费" android:singleLine="true" android:inputType="numberDecimal" />
                    </RelativeLayout>
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginEnd="15dp">
                        <EditText android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/remark" android:background="@color/translate" android:layout_width="match_parent" android:layout_height="50dp" android:hint="请输入备注" android:singleLine="true" />
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                <RelativeLayout android:id="@+id/do_time_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="50dp" android:paddingEnd="10dp">
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/do_time_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="买入日期" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
                    <ImageView android:id="@+id/do_time_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                    <TextView android:textSize="13sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:gravity="center" android:id="@+id/do_time" android:layout_width="wrap_content" android:layout_height="50dp" android:text="选择日期" android:singleLine="true" android:layout_toStartOf="@+id/do_time_more" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/end_time_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="50dp" android:paddingEnd="10dp">
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/end_time_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="确认日期" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
                    <ImageView android:id="@+id/end_time_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                    <TextView android:textSize="13sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:gravity="center" android:id="@+id/end_time" android:layout_width="wrap_content" android:layout_height="50dp" android:text="选择日期" android:singleLine="true" android:layout_toStartOf="@+id/end_time_more" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/choice_asset_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="55dp">
                    <TextView android:textSize="13sp" android:textColor="@color/black" android:id="@+id/asset_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="付款账户" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
                    <TextView android:textSize="13sp" android:textColor="@color/black" android:gravity="end" android:id="@+id/asset_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="无账户" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_toStartOf="@+id/ic_more" android:layout_toEndOf="@+id/asset_title" />
                    <ImageView android:id="@+id/ic_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/total_num_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="55dp">
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/buy_total_cost_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="买入金额" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/buy_total_cost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/add_bill_layout" android:background="@drawable/selectable_item_expand_mask" android:visibility="gone" android:layout_width="match_parent" android:layout_height="56dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="20dp" android:layout_toStartOf="@+id/switch_add_bill">
                        <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="生成收益账单" />
                        <TextView android:textSize="12sp" android:textColor="@color/grey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="按照持仓成本价生成收益账单" android:singleLine="true" />
                    </LinearLayout>
                    <Switch android:id="@+id/switch_add_bill" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="false" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                </RelativeLayout>
            </LinearLayout>
            <TextView android:textSize="12sp" android:textColor="@color/grey" android:id="@+id/add_bill_tip" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="提示：\10打开“生成收益账单”后，只需编辑当前基金最后一条自动生成的收益账单，后续账单的分类、账本、标签、是否计入收支和预算，将自动沿用" android:lineSpacingExtra="5dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>