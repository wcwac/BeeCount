<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:id="@+id/tool_bar" android:background="@color/white" android:layout_width="match_parent" android:layout_height="50dp">
        <ImageView android:id="@+id/btn_back" android:background="@drawable/selectable_item_circle" android:padding="16dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_back" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" />
        <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="180dp" android:text="识别结果" android:singleLine="true" android:layout_centerVertical="true" android:layout_toEndOf="@+id/btn_back" />
        <ImageView android:id="@+id/tip" android:background="@drawable/selectable_item_circle" android:padding="16dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_tip" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_toStartOf="@+id/right_text" />
        <TextView android:textSize="15sp" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/right_text" android:background="@drawable/selectable_item_circle" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="导入" android:singleLine="true" android:layout_centerVertical="true" android:paddingStart="10dp" android:paddingEnd="15dp" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <RelativeLayout android:id="@+id/check_layout" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="55dp" android:layout_margin="15dp" android:paddingStart="15dp" android:paddingEnd="15dp">
        <Switch android:id="@+id/radio_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
        <TextView android:textSize="15sp" android:textColor="@color/black" android:id="@+id/check_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="自动修正" android:layout_centerVertical="true" />
    </RelativeLayout>
    <RelativeLayout android:id="@+id/check_all_layout" android:background="@drawable/shape_bg_setting" android:visibility="gone" android:layout_width="match_parent" android:layout_height="55dp" android:layout_margin="15dp" android:paddingStart="15dp" android:paddingEnd="15dp">
        <Switch android:id="@+id/all_radio_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true">
            <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="全选账单" />
            <TextView android:textSize="12sp" android:textColor="@color/grey" android:id="@+id/bill_num_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="共条账单" android:singleLine="true" />
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/data_list" android:paddingBottom="50dp" android:clipChildren="false" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:overScrollMode="never" />
    </RelativeLayout>
</LinearLayout>