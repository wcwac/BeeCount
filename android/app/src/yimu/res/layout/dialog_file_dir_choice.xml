<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:orientation="vertical" android:background="@drawable/dialog_user_agreement_bg" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
    <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="@color/black" android:layout_gravity="center_horizontal" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="目录选择" />
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="10dp" android:layout_marginStart="10dp" android:layout_marginEnd="15dp">
        <ImageView android:id="@+id/path_back" android:background="@drawable/selectable_item_circle" android:padding="10dp" android:layout_width="35dp" android:layout_height="35dp" android:src="@mipmap/ic_search_back" android:tint="@color/iconTint" />
        <TextView android:textSize="12sp" android:textColor="@color/darkGrey" android:id="@+id/current_path" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" />
    </LinearLayout>
    <View android:background="@color/divider" android:layout_width="match_parent" android:layout_height="1px" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/dir_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="200dp" app:maxHeight="500dp" />
    <RelativeLayout android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="20dp">
        <TextView android:textSize="15sp" android:textColor="@color/textColorBlack" android:gravity="center" android:id="@+id/create_dir" android:background="?android:attr/selectableItemBackground" android:layout_width="wrap_content" android:layout_height="50dp" android:text="新建" android:paddingStart="20dp" android:paddingEnd="20dp" />
        <TextView android:textSize="15sp" android:textColor="@color/textColorBlack" android:gravity="center" android:id="@+id/restore_path" android:background="?android:attr/selectableItemBackground" android:layout_width="wrap_content" android:layout_height="50dp" android:text="恢复默认" android:layout_centerVertical="true" android:paddingStart="20dp" android:paddingEnd="20dp" android:layout_toEndOf="@+id/create_dir" />
        <TextView android:textSize="15sp" android:textColor="@color/textGray" android:gravity="center" android:id="@+id/cancel" android:background="?android:attr/selectableItemBackground" android:layout_width="wrap_content" android:layout_height="50dp" android:text="取消" android:paddingStart="20dp" android:paddingEnd="20dp" android:layout_toStartOf="@+id/confirm" />
        <TextView android:textSize="15sp" android:textColor="@color/textColorPrimary" android:gravity="center" android:id="@+id/confirm" android:background="?android:attr/selectableItemBackground" android:layout_width="wrap_content" android:layout_height="50dp" android:text="确定" android:paddingStart="20dp" android:paddingEnd="20dp" android:layout_alignParentEnd="true" />
    </RelativeLayout>
</LinearLayout>