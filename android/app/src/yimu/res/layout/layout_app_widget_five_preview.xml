<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
    <ImageView android:id="@+id/total_layout" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignTop="@+id/top_layout" android:layout_alignBottom="@+id/preview_content" />
    <RelativeLayout android:id="@+id/top_layout" android:layout_width="match_parent" android:layout_height="30dp">
        <ImageView android:id="@+id/top_background" android:clickable="false" android:layout_width="match_parent" android:layout_height="30dp" android:scaleType="fitXY" />
        <LinearLayout android:orientation="horizontal" android:id="@+id/account_book_layout" android:layout_width="wrap_content" android:layout_height="match_parent" android:paddingStart="10dp">
            <TextView android:textSize="12sp" android:textStyle="bold" android:textColor="@color/textColorBlack" android:gravity="center" android:id="@+id/account_book_name" android:layout_width="wrap_content" android:layout_height="match_parent" android:maxWidth="120dp" android:text="日常账本" android:singleLine="true" />
            <ImageView android:layout_gravity="center_vertical" android:id="@+id/book_icon" android:layout_width="10dp" android:layout_height="10dp" android:src="@mipmap/ic_bottom" android:tint="@color/black" android:layout_marginStart="3dp" />
        </LinearLayout>
        <LinearLayout android:gravity="center_vertical" android:orientation="vertical" android:id="@+id/num_layout" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="10dp" android:layout_toEndOf="@+id/account_book_layout">
            <TextView android:textSize="8sp" android:textColor="@color/textColorBlack" android:id="@+id/pay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="支：0.00" android:singleLine="true" />
            <TextView android:textSize="8sp" android:textColor="@color/textColorBlack" android:id="@+id/income" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="收：0.00" android:singleLine="true" />
        </LinearLayout>
        <LinearLayout android:gravity="end|center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_toStartOf="@+id/btn_add">
            <ImageView android:id="@+id/pre_month" android:background="@drawable/selectable_item_circle" android:padding="9dp" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_more_left" android:tint="@color/black" />
            <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/textColorBlack" android:id="@+id/month" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7月" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" />
            <ImageView android:id="@+id/next_month" android:background="@drawable/selectable_item_circle" android:padding="9dp" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_more" android:tint="@color/black" />
        </LinearLayout>
        <ImageView android:id="@+id/btn_refresh" android:background="@drawable/selectable_item_circle" android:padding="8dp" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_refresh" android:tint="@color/black" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
        <ImageView android:id="@+id/btn_add" android:background="@drawable/selectable_item_circle" android:padding="3dp" android:layout_width="35dp" android:layout_height="35dp" android:src="@mipmap/ic_notify_add" android:tint="@color/black" android:layout_centerVertical="true" android:layout_toStartOf="@+id/btn_refresh" />
    </RelativeLayout>
    <ImageView android:id="@+id/preview_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:src="@mipmap/widget_white_month" android:scaleType="fitStart" android:layout_below="@+id/top_layout" />
</RelativeLayout>