<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:gravity="center" android:orientation="vertical" android:id="@+id/parent_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp">
    <RelativeLayout android:layout_width="150dp" android:layout_height="58dp">
        <ImageView android:id="@+id/cover" android:layout_width="150dp" android:layout_height="58dp" />
        <ImageView android:id="@+id/select_layout" android:background="@drawable/shape_circle_white" android:layout_width="15dp" android:layout_height="15dp" android:layout_margin="3dp" android:src="@mipmap/ic_select" android:tint="@color/textColorPrimary" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <LinearLayout android:gravity="center" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp">
        <TextView android:textSize="12sp" android:textColor="@color/grey" android:id="@+id/name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="春意" />
        <ImageView android:id="@+id/vip_icon" android:layout_width="13dp" android:layout_height="13dp" android:src="@mipmap/ic_vip" android:layout_marginStart="5dp" />
    </LinearLayout>
</LinearLayout>