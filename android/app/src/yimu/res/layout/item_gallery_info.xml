<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/total_layout" android:background="@drawable/shape_image_frame" android:padding="1px" android:layout_width="125dp" android:layout_height="125dp" android:layout_marginTop="8dp">
    <ImageView android:id="@+id/image_view" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="center" />
    <View android:id="@+id/frame" android:background="@color/blackAlpha8" android:layout_width="match_parent" android:layout_height="match_parent" />
    <RelativeLayout android:id="@+id/choice_layout" android:background="@mipmap/ic_choice" android:layout_width="40dp" android:layout_height="40dp" android:layout_alignParentEnd="true">
        <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/white" android:id="@+id/choice_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true" />
    </RelativeLayout>
</RelativeLayout>