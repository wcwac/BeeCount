<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@drawable/bg_add_bill_dialog" android:layout_width="match_parent" android:layout_height="wrap_content">
    <RelativeLayout android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginTop="10dp" android:paddingStart="15dp">
        <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="选择账本" android:layout_centerVertical="true" />
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/no_account_book" android:background="?android:attr/selectableItemBackground" android:layout_width="wrap_content" android:layout_height="45dp" android:layout_centerVertical="true" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true">
            <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="不选择" android:singleLine="true" android:layout_marginStart="5dp" />
        </LinearLayout>
        <TextView android:textSize="14sp" android:textColor="@color/textColorPrimary" android:gravity="center" android:id="@+id/choice_all" android:visibility="gone" android:layout_width="60dp" android:layout_height="45dp" android:text="全选" android:layout_centerVertical="true" android:layout_toStartOf="@+id/complete" />
        <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/complete" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="45dp" android:text="完成" android:layout_centerVertical="true" android:paddingStart="15dp" android:paddingEnd="15dp" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/account_book_list" android:paddingBottom="30dp" android:clipChildren="false" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="150dp" />
</LinearLayout>