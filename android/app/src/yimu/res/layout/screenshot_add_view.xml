<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:orientation="horizontal" android:id="@+id/content_layout" android:background="@drawable/shape_background_primary_left_circle" android:focusable="true" android:clickable="true" android:layout_width="wrap_content" android:layout_height="wrap_content">
    <RelativeLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/confirm" android:layout_width="35dp" android:layout_height="match_parent" android:layout_marginStart="10dp">
        <ProgressBar android:id="@+id/spin_kit" android:visibility="gone" android:layout_width="25dp" android:layout_height="25dp" android:layout_centerInParent="true" app:SpinKit_Color="@color/white" />
        <ImageView android:id="@+id/confirm_icon" android:padding="5dp" android:layout_width="35dp" android:layout_height="match_parent" android:src="@mipmap/ic_tick" android:tint="@color/white" />
    </RelativeLayout>
    <LinearLayout android:gravity="end" android:orientation="vertical" android:layout_width="90dp" android:layout_height="wrap_content">
        <TextView android:textSize="12dp" android:textColor="@color/white" android:id="@+id/status_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:layout_marginBottom="5dp" android:text="截图识别" android:singleLine="true" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" />
        <TextView android:textSize="11dp" android:textColor="@color/white" android:id="@+id/num_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="5dp" android:text="今日剩余：10" android:singleLine="true" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" />
    </LinearLayout>
    <ImageView android:id="@+id/cancel_btn" android:padding="11dp" android:layout_width="35dp" android:layout_height="match_parent" android:src="@mipmap/ic_close" android:tint="@color/white" />
</LinearLayout>