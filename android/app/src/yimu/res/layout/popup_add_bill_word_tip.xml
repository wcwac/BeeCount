<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:orientation="vertical" android:id="@+id/parent_layout" android:layout_width="wrap_content" android:layout_height="wrap_content">
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/tip_layout" android:layout_width="wrap_content" android:layout_height="25dp" android:layout_marginStart="15dp">
        <TextView android:textSize="12sp" android:textColor="@color/white" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="如不要此提示，可前往更多设置关闭“智能提示”" />
        <ImageView android:id="@+id/btn_close_tip" android:padding="3dp" android:layout_width="25dp" android:layout_height="25dp" android:src="@mipmap/ic_tip_close" android:layout_marginStart="10dp" />
    </LinearLayout>
    <RelativeLayout android:id="@+id/background_layout" android:background="@drawable/background_translate_view" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/tip_list" android:layout_width="wrap_content" android:layout_height="wrap_content" android:adjustViewBounds="true" android:layout_centerVertical="true" app:maxHeight="275dp" />
    </RelativeLayout>
</LinearLayout>