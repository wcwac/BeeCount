<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp">
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/total_layout" android:layout_width="match_parent" android:layout_height="wrap_content">
        <RelativeLayout android:layout_width="30dp" android:layout_height="30dp">
            <ImageView android:id="@+id/dream_image_night" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" />
            <ImageView android:id="@+id/dream_image" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_launcher_no_color" app:oval="true" />
        </RelativeLayout>
        <LinearLayout android:gravity="center_vertical" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="5dp">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginEnd="20dp" android:layout_toStartOf="@+id/progress_num">
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/dream_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="花呗" android:singleLine="true" />
                    <TextView android:textSize="14sp" android:textColor="@color/textColorPrimary" android:id="@+id/dream_finish" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="（达成）" android:singleLine="true" />
                </LinearLayout>
                <TextView android:textSize="13sp" android:textColor="@color/textColorPrimary" android:id="@+id/progress_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10711" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <RelativeLayout android:id="@+id/num_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:layout_marginBottom="3dp">
                <FrameLayout android:id="@+id/num_progress_one" android:layout_width="match_parent" android:layout_height="4dp" />
                <FrameLayout android:id="@+id/num_progress_two" android:layout_width="match_parent" android:layout_height="4dp" />
            </RelativeLayout>
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
                <TextView android:textSize="11sp" android:textColor="@color/darkGrey" android:ellipsize="end" android:id="@+id/dream_remark" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="11111" android:singleLine="true" android:layout_marginEnd="20dp" android:layout_toStartOf="@+id/total_num" />
                <TextView android:textSize="11sp" android:textColor="@color/black" android:id="@+id/total_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" />
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>