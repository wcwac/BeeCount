<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/tip_layout" android:paddingTop="30dp" android:paddingBottom="30dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true">
            <include android:id="@+id/tip_image" android:layout_width="100dp" android:layout_height="100dp" layout="@layout/layout_home_tip" />
            <TextView android:textSize="13sp" android:textColor="@color/textGray" android:id="@+id/tip_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="没有任何账单" />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/data_list" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp" android:overScrollMode="never" />
    </RelativeLayout>
</RelativeLayout>