<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/parent_layout" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="50dp">
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/book_layout" android:layout_width="wrap_content" android:layout_height="match_parent" android:paddingStart="15dp">
                <ImageView android:id="@+id/book_icon" android:layout_width="20dp" android:layout_height="20dp" android:scaleType="fitXY" android:layout_marginEnd="5dp" />
                <TextView android:textSize="14sp" android:textColor="@color/textColorWhite" android:id="@+id/book_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="日常账本" />
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_account_book_more" android:scaleType="fitXY" android:tint="@color/textColorWhite" />
            </LinearLayout>
            <ImageView android:id="@+id/expand_btn" android:background="@drawable/selectable_item_circle" android:padding="11dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_expand" android:tint="@color/textColorWhite" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <androidx.cardview.widget.CardView android:id="@+id/content_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="5dp" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" app:cardBackgroundColor="@color/transparent" app:cardCornerRadius="10dp" app:cardElevation="0dp">
            <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:textSize="14sp" android:textColor="@color/blackAlpha25" android:gravity="top" android:id="@+id/word_edit_tip" android:paddingTop="20dp" android:paddingBottom="20dp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:lineSpacingExtra="8dp" android:paddingStart="20dp" android:paddingEnd="20dp" android:layout_toStartOf="@+id/add_btn" />
                    <EditText android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/textGray" android:gravity="top" android:id="@+id/word_edit" android:background="@color/transparent" android:paddingTop="20dp" android:paddingBottom="20dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="试试“工资卡收入10元”、“昨天打车20元”\10“支付宝转到微信15元”、“长按可再记”" android:singleLine="true" android:lineSpacingExtra="8dp" android:imeOptions="actionDone" android:paddingStart="20dp" android:paddingEnd="20dp" android:layout_toStartOf="@+id/add_btn" />
                    <LinearLayout android:orientation="horizontal" android:id="@+id/analysis_layout" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignBottom="@+id/word_edit" android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
                        <LinearLayout android:orientation="horizontal" android:id="@+id/category_layout" android:layout_width="wrap_content" android:layout_height="wrap_content">
                            <TextView android:textSize="13sp" android:textColor="@color/grey" android:gravity="center_vertical" android:layout_width="wrap_content" android:layout_height="30dp" android:text="分类：" android:singleLine="true" />
                            <TextView android:textSize="13sp" android:textColor="@color/textColorPrimary" android:gravity="center_vertical" android:id="@+id/category_info" android:layout_width="wrap_content" android:layout_height="30dp" android:text="购物消费" android:singleLine="true" />
                        </LinearLayout>
                        <LinearLayout android:orientation="horizontal" android:id="@+id/from_layout" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content">
                            <TextView android:textSize="13sp" android:textColor="@color/grey" android:gravity="center_vertical" android:layout_width="wrap_content" android:layout_height="30dp" android:text="转出：" android:singleLine="true" />
                            <TextView android:textSize="13sp" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/from_info" android:layout_width="wrap_content" android:layout_height="30dp" android:text="购物消费" android:singleLine="true" />
                        </LinearLayout>
                        <LinearLayout android:orientation="horizontal" android:id="@+id/to_layout" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="30dp">
                            <TextView android:textSize="13sp" android:textColor="@color/grey" android:gravity="center_vertical" android:layout_width="wrap_content" android:layout_height="30dp" android:text="转入：" android:singleLine="true" />
                            <TextView android:textSize="13sp" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/to_info" android:layout_width="wrap_content" android:layout_height="30dp" android:text="购物消费" android:singleLine="true" />
                        </LinearLayout>
                        <LinearLayout android:orientation="horizontal" android:id="@+id/num_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="30dp">
                            <TextView android:textSize="13sp" android:textColor="@color/grey" android:gravity="center_vertical" android:layout_width="wrap_content" android:layout_height="30dp" android:text="金额：" android:singleLine="true" />
                            <TextView android:textSize="13sp" android:textColor="@color/moneyPay" android:gravity="center_vertical" android:id="@+id/num_info" android:layout_width="wrap_content" android:layout_height="30dp" android:text="15.00" android:singleLine="true" />
                        </LinearLayout>
                    </LinearLayout>
                    <RelativeLayout android:id="@+id/add_btn" android:layout_width="50dp" android:layout_height="50dp" android:layout_alignParentEnd="true">
                        <ImageView android:id="@+id/add_background" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_fast_add_bg" android:tint="@color/colorPrimaryAlpha30" />
                        <ImageView android:layout_width="19dp" android:layout_height="19dp" android:layout_marginTop="14dp" android:src="@mipmap/ic_fast_add" android:tint="@color/textColorWhite" android:layout_marginStart="19dp" />
                    </RelativeLayout>
                </RelativeLayout>
                <RelativeLayout android:layout_width="match_parent" android:layout_height="50dp">
                    <ImageView android:id="@+id/tag_btn" android:background="@drawable/selectable_item_circle" android:padding="13dp" android:layout_width="45dp" android:layout_height="45dp" android:src="@mipmap/ic_tag" android:tint="@color/black" android:layout_centerVertical="true" android:layout_toEndOf="@+id/calendar_btn" />
                    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/reimbursement_layout" android:background="@drawable/selectable_item_expand" android:layout_width="wrap_content" android:layout_height="50dp" android:layout_centerVertical="true" android:paddingStart="10dp" android:paddingEnd="10dp" android:layout_toEndOf="@+id/asset_layout">
                        <ImageView android:layout_gravity="center_vertical" android:id="@+id/reimbursement_icon" android:layout_width="19dp" android:layout_height="19dp" android:src="@mipmap/ic_data_no_baoxiao" />
                        <TextView android:textSize="12sp" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/reimbursement_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="70dp" android:text="不报销" android:singleLine="true" android:layout_marginStart="5dp" />
                    </LinearLayout>
                    <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/asset_layout" android:background="@drawable/selectable_item_expand" android:layout_width="wrap_content" android:layout_height="50dp" android:layout_alignParentBottom="true" android:paddingStart="10dp" android:paddingEnd="10dp" android:layout_toEndOf="@+id/tag_btn">
                        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
                            <ImageView android:layout_gravity="center_vertical" android:id="@+id/asset_icon" android:layout_width="19dp" android:layout_height="19dp" android:src="@mipmap/ic_no_asset" />
                            <TextView android:textSize="12sp" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/asset_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="70dp" android:text="无账户" android:singleLine="true" android:layout_marginStart="5dp" />
                        </LinearLayout>
                        <TextView android:textSize="11dp" android:textColor="@color/red" android:id="@+id/asset_num_tip" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="余额不足" />
                    </LinearLayout>
                    <RelativeLayout android:id="@+id/calendar_btn" android:background="@drawable/selectable_item_circle" android:layout_width="45dp" android:layout_height="45dp" android:layout_centerVertical="true" android:layout_marginStart="5dp">
                        <ImageView android:padding="13dp" android:layout_width="45dp" android:layout_height="45dp" android:src="@mipmap/ic_calendar" android:tint="@color/black" />
                        <TextView android:textSize="7sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/date_text" android:paddingTop="3dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="11" android:layout_centerInParent="true" />
                    </RelativeLayout>
                </RelativeLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</RelativeLayout>