<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/total_layout" android:layout_width="match_parent" android:layout_height="62dp">
    <LinearLayout android:gravity="center" android:orientation="vertical" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="match_parent">
        <ImageView android:id="@+id/icon" android:layout_width="20dp" android:layout_height="20dp" android:src="@mipmap/ic_shopping_baby" />
        <TextView android:textSize="12sp" android:textColor="@color/textColorBlack" android:id="@+id/type_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="文化教育" android:singleLine="true" />
    </LinearLayout>
    <ImageView android:id="@+id/delete" android:padding="8dp" android:visibility="gone" android:layout_width="25dp" android:layout_height="25dp" android:src="@mipmap/ic_close" android:tint="@color/black" android:layout_alignParentEnd="true" />
</RelativeLayout>