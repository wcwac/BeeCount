<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:gravity="bottom" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:weightSum="100">
    <LinearLayout android:gravity="bottom" android:orientation="vertical" android:background="@drawable/image_bg_bottom" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="20">
        <ImageButton android:id="@+id/ib_clip_rotate" android:background="@null" android:padding="15dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/image_btn_rotate" android:contentDescription="@string/image_rotate" />
        <FrameLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <ImageButton android:layout_gravity="center_vertical" android:id="@+id/ib_clip_cancel" android:background="@null" android:padding="15dp" android:layout_width="50dp" android:layout_height="50dp" android:layout_marginLeft="20dp" android:src="@drawable/image_btn_cancel" android:contentDescription="@string/image_cancel" />
            <TextView android:textSize="16sp" android:textColor="@color/image_color_text" android:gravity="center_vertical" android:layout_gravity="center" android:id="@+id/tv_clip_reset" android:focusable="true" android:clickable="true" android:layout_width="wrap_content" android:layout_height="50dp" android:text="@string/image_reset" android:paddingStart="15dp" android:paddingEnd="15dp" />
            <ImageButton android:layout_gravity="end|center_vertical" android:id="@+id/ib_clip_done" android:background="@null" android:padding="15dp" android:layout_width="50dp" android:layout_height="50dp" android:layout_marginRight="20dp" android:src="@drawable/image_btn_ok" android:contentDescription="@string/image_done" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>