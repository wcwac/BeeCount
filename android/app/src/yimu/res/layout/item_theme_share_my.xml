<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:gravity="center_horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp">
    <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/total_layout" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_marginEnd="10dp">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <ImageView android:id="@+id/share_cover" android:layout_width="150dp" android:layout_height="58dp" android:layout_marginTop="10dp" android:layout_centerHorizontal="true" />
        </RelativeLayout>
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:gravity="center_vertical" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginStart="10dp" android:layout_marginEnd="20dp" android:layout_toStartOf="@+id/collect_num_layout">
                <TextView android:textSize="13sp" android:textColor="@color/black" android:id="@+id/share_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="日常账本分类" android:singleLine="true" />
                <TextView android:textSize="12sp" android:textColor="@color/red" android:id="@+id/agree_info" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="等待审核中" android:singleLine="true" />
            </LinearLayout>
            <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/collect_num_layout" android:layout_width="wrap_content" android:layout_height="50dp" android:layout_centerVertical="true" android:paddingEnd="10dp" android:layout_toStartOf="@+id/btn_menu">
                <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@mipmap/ic_not_collect" android:tint="@color/iconTint" />
                <TextView android:textSize="10dp" android:typeface="monospace" android:textColor="@color/iconTint" android:id="@+id/collect_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9" android:includeFontPadding="false" android:layout_marginStart="3dp" />
            </LinearLayout>
            <ImageView android:id="@+id/btn_menu" android:background="@drawable/selectable_item_circle" android:padding="5dp" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginTop="10dp" android:src="@mipmap/ic_bar_more" android:tint="@color/textColorBlack" android:layout_alignParentEnd="true" />
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>