<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/total_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="55dp" android:paddingEnd="15dp">
    <ImageView android:id="@+id/icon" android:layout_width="20dp" android:layout_height="20dp" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" />
    <LinearLayout android:gravity="center_vertical" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/cost_layout" android:layout_toEndOf="@+id/icon">
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/category" android:layout_width="0dp" android:layout_height="wrap_content" android:singleLine="true" android:layout_weight="1" />
            <TextView android:textSize="10sp" android:textColor="@color/refund_text" android:id="@+id/refund" android:background="@drawable/bg_refund" android:paddingTop="2dp" android:paddingBottom="2dp" android:visibility="invisible" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="退" android:singleLine="true" android:paddingStart="3dp" android:paddingEnd="3dp" android:layout_marginStart="6dp" />
            <TextView android:textSize="10sp" android:textColor="@color/reimbursement_text" android:id="@+id/reimbursement" android:background="@drawable/bg_reimbursement" android:paddingTop="2dp" android:paddingBottom="2dp" android:visibility="invisible" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="报销" android:singleLine="true" android:paddingStart="3dp" android:paddingEnd="3dp" android:layout_marginStart="6dp" />
        </LinearLayout>
        <TextView android:textSize="11sp" android:textColor="@color/darkGrey" android:ellipsize="end" android:id="@+id/remark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:singleLine="true" />
    </LinearLayout>
    <LinearLayout android:gravity="end" android:orientation="vertical" android:id="@+id/cost_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_alignParentEnd="true">
        <TextView android:textSize="15sp" android:textColor="@color/black" android:id="@+id/cost" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:textSize="12sp" android:textColor="@color/grey" android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="12月11日" />
    </LinearLayout>
</RelativeLayout>