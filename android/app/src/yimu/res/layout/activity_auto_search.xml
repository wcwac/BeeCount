<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:orientation="vertical" android:background="@color/white" android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:layout_width="match_parent" android:layout_height="50dp">
        <EditText android:textSize="15sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/search_input" android:background="@color/white" android:layout_width="match_parent" android:layout_height="match_parent" android:hint="输入商户名称" android:singleLine="true" android:imeOptions="actionDone" android:layout_toStartOf="@+id/btn_layout" android:layout_toEndOf="@+id/btn_back" />
        <LinearLayout android:orientation="horizontal" android:id="@+id/btn_layout" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_alignParentEnd="true">
            <ImageView android:id="@+id/btn_clear" android:background="@drawable/selectable_item_circle" android:padding="17dp" android:visibility="gone" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_close" android:scaleType="fitCenter" android:tint="@color/black" />
        </LinearLayout>
        <ImageView android:id="@+id/btn_back" android:background="@drawable/selectable_item_circle" android:padding="16dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_search_back" android:scaleType="fitCenter" android:tint="@color/black" />
    </RelativeLayout>
    <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:orientation="vertical" android:id="@+id/search_result_layout" android:background="@color/backgroundLight" android:visibility="invisible" android:layout_width="match_parent" android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/search_result_list" android:paddingBottom="80dp" android:clipChildren="false" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:overScrollMode="never" />
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout android:id="@+id/search_no_tip_layout" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <include android:layout_width="150dp" android:layout_height="150dp" android:layout_marginBottom="10dp" android:layout_above="@+id/search_no_tip" android:layout_centerHorizontal="true" layout="@layout/layout_common_tip" />
                <TextView android:textSize="15sp" android:textColor="@color/textGray" android:id="@+id/search_no_tip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="没有找到你想要的" android:layout_centerInParent="true" />
            </RelativeLayout>
        </RelativeLayout>
        <RelativeLayout android:id="@+id/search_tip_layout" android:fitsSystemWindows="true" android:layout_width="match_parent" android:layout_height="match_parent">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <include android:layout_width="150dp" android:layout_height="150dp" android:layout_marginBottom="20dp" android:layout_above="@+id/search_tip" android:layout_centerHorizontal="true" layout="@layout/layout_search_tip" />
                <TextView android:textSize="15sp" android:textColor="@color/textGray" android:id="@+id/search_tip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="输入名称，搜索一下" android:layout_centerInParent="true" />
            </RelativeLayout>
        </RelativeLayout>
        <androidx.cardview.widget.CardView android:id="@+id/edit_layout" android:visibility="gone" android:layout_width="match_parent" android:layout_height="60dp" android:layout_alignParentBottom="true" app:cardBackgroundColor="@color/white" app:cardCornerRadius="0dp" app:cardElevation="8dp">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="60dp">
                <TextView android:textSize="16sp" android:textColor="@color/textColorPrimary" android:gravity="center" android:id="@+id/choice_all" android:background="?android:attr/selectableItemBackgroundBorderless" android:layout_width="wrap_content" android:layout_height="50dp" android:text="全选" android:layout_centerVertical="true" android:paddingStart="15dp" android:paddingEnd="15dp" />
                <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="50dp" android:layout_centerVertical="true" android:layout_alignParentEnd="true">
                    <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/bill_delete" android:background="@drawable/selectable_item_circle" android:layout_width="50dp" android:layout_height="50dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_edit_delete" android:tint="@color/iconTint" />
                        <TextView android:textSize="11sp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="删除" />
                    </LinearLayout>
                    <ImageView android:layout_gravity="center_vertical" android:id="@+id/complete" android:background="@drawable/selectable_item_circle" android:padding="15dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_edit_complete" android:tint="@color/iconTint" />
                </LinearLayout>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
    </RelativeLayout>
</LinearLayout>