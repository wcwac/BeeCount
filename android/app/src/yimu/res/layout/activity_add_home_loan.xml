<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:id="@+id/tool_bar" android:background="@color/white" android:layout_width="match_parent" android:layout_height="50dp">
        <ImageView android:id="@+id/btn_back" android:background="@drawable/selectable_item_circle" android:padding="17dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_close" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" />
        <ImageView android:id="@+id/btn_delete" android:background="@drawable/selectable_item_circle" android:padding="14dp" android:visibility="gone" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_delete" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" android:layout_toStartOf="@+id/btn_next" />
        <ImageView android:id="@+id/tip" android:background="@drawable/selectable_item_circle" android:padding="11dp" android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_tip" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_toStartOf="@+id/btn_next" />
        <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="180dp" android:text="新增房贷" android:singleLine="true" android:layout_centerVertical="true" android:layout_toEndOf="@+id/btn_back" />
        <TextView android:textSize="15sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/btn_next" android:background="?android:attr/selectableItemBackground" android:layout_width="wrap_content" android:layout_height="50dp" android:text="下一步" android:layout_centerVertical="true" android:paddingStart="15dp" android:paddingEnd="15dp" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never">
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                <RelativeLayout android:id="@+id/loan_type_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="50dp" android:paddingEnd="10dp">
                    <ImageView android:id="@+id/loan_type_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="贷款类型" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/loan_type" android:layout_width="wrap_content" android:layout_height="50dp" android:text="商业贷款" android:singleLine="true" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/loan_type_more" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/repayment_type_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="50dp" android:paddingEnd="10dp">
                    <ImageView android:id="@+id/repayment_type_tip" android:background="@drawable/selectable_item_circle" android:padding="12dp" android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_tip" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_toEndOf="@+id/repayment_type_title" />
                    <ImageView android:id="@+id/repayment_type_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end" android:id="@+id/repayment_type_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="还款方式" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/repayment_type" android:layout_width="wrap_content" android:layout_height="50dp" android:text="等额本息" android:singleLine="true" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/repayment_type_more" />
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                <RelativeLayout android:id="@+id/commercial_loan_num_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="50dp">
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="商业贷款金额" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/commercial_loan_num" android:layout_width="wrap_content" android:layout_height="50dp" android:text="--" android:singleLine="true" android:layout_toStartOf="@+id/commercial_loan_unit" />
                    <TextView android:textSize="13sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/commercial_loan_unit" android:layout_width="wrap_content" android:layout_height="50dp" android:text="万元" android:singleLine="true" android:layout_marginStart="5dp" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/provident_fund_loan_num_layout" android:background="@drawable/selectable_item_expand_mask" android:visibility="gone" android:layout_width="match_parent" android:layout_height="50dp">
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="公积金贷款金额" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/provident_fund_loan_num" android:layout_width="wrap_content" android:layout_height="50dp" android:text="--" android:singleLine="true" android:layout_toStartOf="@+id/provident_fund_loan_unit" />
                    <TextView android:textSize="13sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/provident_fund_loan_unit" android:layout_width="wrap_content" android:layout_height="50dp" android:text="万元" android:singleLine="true" android:layout_marginStart="5dp" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/periods_num_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="50dp">
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="贷款期数" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/periods_num" android:layout_width="wrap_content" android:layout_height="50dp" android:text="--" android:singleLine="true" android:layout_toStartOf="@+id/periods_num_unit" />
                    <TextView android:textSize="13sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/periods_num_unit" android:layout_width="wrap_content" android:layout_height="50dp" android:text="期" android:singleLine="true" android:layout_marginStart="5dp" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/provident_fund_loan_interest_layout" android:background="@drawable/selectable_item_expand_mask" android:visibility="gone" android:layout_width="match_parent" android:layout_height="50dp">
                    <LinearLayout android:gravity="end" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true">
                        <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
                            <TextView android:textSize="13sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/provident_fund_loan_interest" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:singleLine="true" />
                            <TextView android:textSize="13sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/provident_fund_loan_interest_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="%" android:singleLine="true" android:layout_marginStart="5dp" />
                        </LinearLayout>
                        <TextView android:textSize="12sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/provident_fund_loan_interest_desc" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="当前基准利率4.9%，上浮10%" android:singleLine="true" />
                    </LinearLayout>
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="公积金利率" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/commercial_loan_interest_type_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="50dp" android:paddingEnd="10dp">
                    <ImageView android:id="@+id/commercial_loan_interest_type_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="商贷利率方式" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/commercial_loan_interest_type" android:layout_width="wrap_content" android:layout_height="50dp" android:text="固定利率" android:singleLine="true" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/commercial_loan_interest_type_more" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/adjust_interest_date_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="50dp" android:paddingEnd="10dp">
                    <ImageView android:id="@+id/adjust_interest_date_tip" android:background="@drawable/selectable_item_circle" android:padding="12dp" android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_tip" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_toEndOf="@+id/adjust_interest_date_title" />
                    <ImageView android:id="@+id/adjust_interest_date_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end" android:id="@+id/adjust_interest_date_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="调息日期" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/adjust_interest_date" android:layout_width="wrap_content" android:layout_height="50dp" android:text="每年1月" android:singleLine="true" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/adjust_interest_date_more" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/commercial_loan_interest_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="50dp">
                    <LinearLayout android:gravity="end" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true">
                        <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
                            <TextView android:textSize="13sp" android:textColor="@color/black" android:id="@+id/commercial_loan_interest" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:singleLine="true" />
                            <TextView android:textSize="13sp" android:textColor="@color/black" android:id="@+id/commercial_loan_interest_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="%" android:singleLine="true" android:layout_marginStart="5dp" />
                        </LinearLayout>
                        <TextView android:textSize="12sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/commercial_loan_interest_desc" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="当前基准利率4.9%，上浮10%" android:singleLine="true" />
                    </LinearLayout>
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="商贷利率" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/lpr_add_num_layout" android:background="@drawable/selectable_item_expand_mask" android:visibility="gone" android:layout_width="match_parent" android:layout_height="50dp">
                    <LinearLayout android:gravity="end" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true">
                        <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
                            <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/lpr_add_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:singleLine="true" />
                            <TextView android:textSize="13sp" android:textColor="@color/black" android:id="@+id/lpr_add_num_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="%" android:singleLine="true" android:layout_marginStart="5dp" />
                        </LinearLayout>
                        <TextView android:textSize="12sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/lpr_add_num_desc" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="当前基准利率4.9%，上浮10%" android:singleLine="true" />
                    </LinearLayout>
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LPR利率" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/repricing_date_layout" android:background="@drawable/selectable_item_expand_mask" android:visibility="gone" android:layout_width="match_parent" android:layout_height="50dp" android:paddingEnd="10dp">
                    <ImageView android:id="@+id/repricing_date_tip" android:background="@drawable/selectable_item_circle" android:padding="12dp" android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_tip" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_toEndOf="@+id/repricing_date_title" />
                    <ImageView android:id="@+id/repricing_date_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end" android:id="@+id/repricing_date_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="重定价日" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/repricing_date" android:layout_width="wrap_content" android:layout_height="50dp" android:text="1月1日" android:singleLine="true" android:layout_toStartOf="@+id/repricing_date_more" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/repricing_cycle_layout" android:background="@drawable/selectable_item_expand_mask" android:visibility="gone" android:layout_width="match_parent" android:layout_height="50dp" android:paddingEnd="10dp">
                    <ImageView android:id="@+id/repricing_cycle_tip" android:background="@drawable/selectable_item_circle" android:padding="12dp" android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_tip" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_toEndOf="@+id/repricing_cycle_title" />
                    <ImageView android:id="@+id/repricing_cycle_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end" android:id="@+id/repricing_cycle_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="定价周期" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/repricing_cycle" android:layout_width="wrap_content" android:layout_height="50dp" android:text="5年" android:singleLine="true" android:layout_toStartOf="@+id/repricing_cycle_more" />
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                <RelativeLayout android:id="@+id/first_repayment_time_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="50dp" android:paddingEnd="10dp">
                    <ImageView android:id="@+id/first_repayment_time_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end" android:id="@+id/out_account_date_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="首次还款时间" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:gravity="center" android:id="@+id/first_repayment_time" android:layout_width="wrap_content" android:layout_height="50dp" android:hint="暂未填写" android:singleLine="true" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/first_repayment_time_more" />
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>