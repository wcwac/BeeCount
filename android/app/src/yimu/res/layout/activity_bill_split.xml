<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:id="@+id/tool_bar" android:background="@color/white" android:layout_width="match_parent" android:layout_height="50dp">
        <ImageView android:id="@+id/btn_back" android:background="@drawable/selectable_item_circle" android:padding="17dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_close" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" />
        <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="180dp" android:text="账单拆分" android:singleLine="true" android:layout_centerVertical="true" android:layout_toEndOf="@+id/btn_back" />
        <ImageView android:id="@+id/btn_delete" android:background="@drawable/selectable_item_circle" android:padding="14dp" android:visibility="gone" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_delete" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" android:layout_toStartOf="@+id/btn_complete" />
        <ImageView android:id="@+id/btn_complete" android:background="@drawable/selectable_item_circle" android:padding="12dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_tick" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never">
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RelativeLayout android:id="@+id/bill_layout" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp" android:paddingEnd="10dp">
                <RelativeLayout android:id="@+id/start_layout" android:layout_width="45dp" android:layout_height="55dp">
                    <ImageView android:id="@+id/icon" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginTop="10dp" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" />
                </RelativeLayout>
                <LinearLayout android:orientation="vertical" android:paddingBottom="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="5dp" android:layout_toEndOf="@+id/start_layout">
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/cost">
                            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
                                <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/category" android:layout_width="0dp" android:layout_height="wrap_content" android:singleLine="true" android:layout_weight="1" />
                                <TextView android:textSize="9sp" android:textColor="@color/reimbursement_text" android:id="@+id/reimbursement" android:background="@drawable/bg_reimbursement" android:paddingTop="2dp" android:paddingBottom="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="待报销" android:singleLine="true" android:paddingStart="3dp" android:paddingEnd="3dp" android:layout_marginStart="5dp" />
                                <TextView android:textSize="9sp" android:textColor="@color/refund_text" android:id="@+id/refund" android:background="@drawable/bg_refund" android:paddingTop="2dp" android:paddingBottom="2dp" android:visibility="invisible" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="退" android:singleLine="true" android:paddingStart="3dp" android:paddingEnd="3dp" android:layout_marginStart="5dp" />
                                <TextView android:textSize="9sp" android:textColor="@color/discount_text" android:id="@+id/discount" android:background="@drawable/bg_discount" android:paddingTop="2dp" android:paddingBottom="2dp" android:visibility="invisible" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="惠" android:singleLine="true" android:paddingStart="3dp" android:paddingEnd="3dp" android:layout_marginStart="5dp" />
                            </LinearLayout>
                        </LinearLayout>
                        <TextView android:textSize="15sp" android:textStyle="bold" android:id="@+id/cost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_alignParentEnd="true" />
                    </RelativeLayout>
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp">
                        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/start_info" android:layout_width="wrap_content" android:layout_height="wrap_content">
                            <TextView android:textSize="11sp" android:textColor="@color/darkGrey" android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                            <TextView android:textSize="11sp" android:textColor="@color/colorPrimaryDark" android:id="@+id/create_user" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="100dp" android:singleLine="true" android:layout_marginStart="5dp" />
                            <TextView android:textSize="11sp" android:gravity="center" android:id="@+id/not_into_total" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="16dp" android:text="不计收支" android:singleLine="true" android:paddingStart="6dp" android:paddingEnd="6dp" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" />
                            <TextView android:textSize="11sp" android:gravity="center" android:id="@+id/not_into_budget" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="16dp" android:text="不计预算" android:singleLine="true" android:paddingStart="6dp" android:paddingEnd="6dp" android:layout_marginEnd="5dp" />
                        </LinearLayout>
                        <RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="10dp" android:layout_toEndOf="@+id/start_info" android:layout_alignParentEnd="true">
                            <TextView android:textSize="11sp" android:textColor="@color/grey" android:gravity="end" android:id="@+id/asset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:layout_alignParentEnd="true" />
                        </RelativeLayout>
                    </RelativeLayout>
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/tag_list" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:textSize="12sp" android:textColor="@color/darkGrey" android:ellipsize="end" android:id="@+id/remark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:maxLines="2" android:lineSpacingExtra="3dp" />
                    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/address_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:layout_marginEnd="10dp">
                        <ImageView android:id="@+id/ic_task_address" android:layout_width="13dp" android:layout_height="13dp" android:src="@mipmap/ic_task_address" android:tint="@color/grey" />
                        <TextView android:textSize="11dp" android:textColor="@color/grey" android:id="@+id/address" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:layout_marginEnd="10dp" />
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/data_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:overScrollMode="never" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
            <TextView android:textColor="@color/textColorPrimary" android:gravity="center" android:id="@+id/add_split" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginBottom="400dp" android:text="新增拆分账单" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>