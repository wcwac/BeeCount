<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@drawable/dialog_user_agreement_bg" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
    <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="@color/black" android:layout_gravity="center_horizontal" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="标签" />
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="20dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
        <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:textSize="13sp" android:textColor="@color/black" android:id="@+id/tag_pay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="支：" />
            <TextView android:textSize="13sp" android:textColor="@color/black" android:id="@+id/tag_income" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="收：" android:layout_marginStart="15dp" />
            <TextView android:textSize="13sp" android:textColor="@color/black" android:id="@+id/tag_balance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="余：" android:layout_marginStart="15dp" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="15dp">
            <TextView android:textSize="13sp" android:textColor="@color/black" android:id="@+id/pay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="总支出(含二级标签)：" />
            <TextView android:textSize="13sp" android:textColor="@color/black" android:id="@+id/income" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:text="总收入(含二级标签)：" />
            <TextView android:textSize="13sp" android:textColor="@color/black" android:id="@+id/balance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:text="总收入(含二级标签)：" />
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="15dp">
            <TextView android:textSize="13sp" android:textColor="@color/black" android:id="@+id/num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="共123条数据" />
            <TextView android:textSize="13sp" android:textColor="@color/black" android:id="@+id/child" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="二级标签：" android:layout_marginStart="15dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>