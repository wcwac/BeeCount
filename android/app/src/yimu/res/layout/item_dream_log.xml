<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
    <RelativeLayout android:orientation="vertical" android:id="@+id/total_layout" android:background="@drawable/shape_bg_setting" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:textSize="15dp" android:textColor="@color/black" android:id="@+id/add_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="储蓄15元" />
        <TextView android:textSize="12dp" android:textColor="@color/darkGrey" android:id="@+id/time_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="2023年9月21日" android:singleLine="true" android:layout_below="@+id/add_info" />
        <TextView android:textSize="12dp" android:textColor="@color/darkGrey" android:id="@+id/num_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="已储蓄：200.00" android:singleLine="true" android:layout_below="@+id/add_info" android:layout_alignParentEnd="true" />
    </RelativeLayout>
</RelativeLayout>