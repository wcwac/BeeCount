<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/parent_layout" android:layout_width="match_parent" android:layout_height="match_parent">
    <FrameLayout android:id="@+id/file_pager" android:layout_width="match_parent" android:layout_height="match_parent" />
    <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/white" android:gravity="center" android:id="@+id/to_bill" android:background="@drawable/shape_circle_black_alpha" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginBottom="20dp" android:text="查看账单" android:layout_alignParentBottom="true" android:paddingStart="20dp" android:paddingEnd="20dp" android:layout_marginStart="15dp" />
    <TextView android:textSize="13sp" android:textColor="@color/black" android:id="@+id/image_index" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:layout_alignParentBottom="true" android:layout_centerHorizontal="true" />
    <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="15dp" android:layout_alignParentBottom="true" android:layout_alignParentEnd="true">
        <ImageView android:id="@+id/image_edit" android:padding="5dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_image_edit" />
        <ImageView android:id="@+id/save_local" android:padding="5dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_image_save_local" />
        <ImageView android:id="@+id/image_share" android:padding="5dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_image_share" android:layout_marginStart="5dp" />
    </LinearLayout>
</RelativeLayout>