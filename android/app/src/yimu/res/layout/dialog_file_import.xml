<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:background="@drawable/dialog_user_agreement_bg" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:orientation="vertical" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/camera_btn" android:background="@drawable/selectable_item_expand" android:layout_width="match_parent" android:layout_height="56dp" android:paddingStart="20dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@mipmap/ic_file_camera" android:tint="@color/iconTint" />
            <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="相机" android:layout_marginStart="20dp" />
        </LinearLayout>
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/image_btn" android:background="@drawable/selectable_item_expand" android:layout_width="match_parent" android:layout_height="56dp" android:paddingStart="20dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@mipmap/ic_file_image" android:tint="@color/iconTint" />
            <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="图片" android:layout_marginStart="20dp" />
        </LinearLayout>
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/record_btn" android:background="@drawable/selectable_item_expand" android:visibility="gone" android:layout_width="match_parent" android:layout_height="56dp" android:paddingStart="20dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@mipmap/ic_file_audio" android:tint="@color/iconTint" />
            <TextView android:textSize="15sp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="录音" android:layout_marginStart="20dp" />
        </LinearLayout>
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/file_btn" android:background="@drawable/selectable_item_expand" android:layout_width="match_parent" android:layout_height="56dp" android:paddingStart="20dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@mipmap/ic_file_other" android:tint="@color/iconTint" />
            <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="其他" android:layout_marginStart="20dp" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>