<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="55dp" android:paddingStart="10dp" android:paddingEnd="10dp">
    <ImageView android:id="@+id/icon" android:layout_width="18dp" android:layout_height="18dp" android:layout_centerVertical="true" />
    <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="10dp" android:layout_marginEnd="5dp" android:layout_toStartOf="@+id/cost_layout" android:layout_toEndOf="@+id/icon">
        <RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/category" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="居家生活" />
            <TextView android:textSize="11sp" android:textColor="@color/textGray" android:id="@+id/bill_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5笔" android:layout_centerVertical="true" android:layout_marginStart="5dp" android:layout_toEndOf="@+id/category" />
            <TextView android:textSize="11sp" android:textColor="@color/textGray" android:id="@+id/percent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100%" android:layout_centerVertical="true" android:layout_marginStart="5dp" android:layout_toEndOf="@+id/bill_num" />
        </RelativeLayout>
        <FrameLayout android:id="@+id/progress_view" android:layout_width="200dp" android:layout_height="5dp" android:layout_marginTop="5dp" />
    </LinearLayout>
    <LinearLayout android:gravity="end" android:orientation="vertical" android:id="@+id/cost_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_alignParentEnd="true">
        <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/cost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="111.00" />
        <TextView android:textSize="11sp" android:textColor="@color/moneyPay" android:gravity="end" android:id="@+id/rate_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="↑0.00%" />
    </LinearLayout>
    <View android:id="@+id/line" android:background="@color/divider" android:layout_width="match_parent" android:layout_height="1px" android:layout_alignParentBottom="true" android:layout_alignEnd="@+id/cost_layout" />
</RelativeLayout>