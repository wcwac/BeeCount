<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:background="@color/white" android:padding="15dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <ImageView android:id="@+id/photo" android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_launcher_no_color" android:layout_centerVertical="true" app:oval="true" />
    <TextView android:textSize="15sp" android:textColor="@color/black" android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="我" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_toStartOf="@+id/user_edit" android:layout_toEndOf="@+id/photo" />
    <ImageView android:id="@+id/user_edit" android:background="@drawable/selectable_item_circle" android:padding="5dp" android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_bill_edit" android:tint="@color/iconTint" android:layout_alignParentEnd="true" />
</RelativeLayout>