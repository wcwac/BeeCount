<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:background="@color/white" android:layout_width="match_parent" android:layout_height="wrap_content">
        <RelativeLayout android:id="@+id/tool_bar" android:layout_width="match_parent" android:layout_height="50dp">
            <ImageView android:id="@+id/btn_back" android:background="@drawable/selectable_item_circle" android:padding="17dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_back" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" />
            <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="180dp" android:text="分类名字" android:singleLine="true" android:layout_centerVertical="true" android:layout_toEndOf="@+id/btn_back" />
            <ImageView android:id="@+id/choice_book" android:background="@drawable/selectable_item_circle" android:padding="15dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_main_account_book" android:tint="@color/floatBallColor" android:layout_toStartOf="@+id/setting" />
            <ImageView android:id="@+id/setting" android:background="@drawable/selectable_item_circle" android:padding="15dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_more_setting" android:tint="@color/floatBallColor" android:layout_marginEnd="5dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:background="@color/white" android:layout_width="match_parent" android:layout_height="46dp">
            <LinearLayout android:gravity="center" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="46dp">
                <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/darkGrey" android:gravity="center" android:id="@+id/start_day" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="2020年5月11日" />
                <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/darkGrey" android:gravity="center" android:paddingBottom="2dp" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="—" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" />
                <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/darkGrey" android:gravity="center" android:id="@+id/end_day" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="2020年6月11日" />
            </LinearLayout>
            <ImageView android:id="@+id/date_setting" android:background="@drawable/selectable_item_circle" android:padding="14dp" android:layout_width="46dp" android:layout_height="46dp" android:src="@mipmap/ic_date_setting" android:tint="@color/iconTint" android:layout_marginEnd="7dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never">
        <LinearLayout android:orientation="vertical" android:paddingBottom="50dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/shape_bg_budget" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp">
                <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/cost_num_layout" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                    <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:id="@+id/cost_num_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="金额" />
                    <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/cost_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:singleLine="true" android:shadowColor="@color/colorPrimaryDark" />
                </LinearLayout>
                <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/bill_num_layout" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                    <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:id="@+id/bill_num_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="笔数" />
                    <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/bill_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" android:singleLine="true" android:shadowColor="@color/colorPrimaryDark" />
                </LinearLayout>
            </LinearLayout>
            <RelativeLayout android:id="@+id/bill_line_layout" android:background="@drawable/shape_bg_setting" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/line_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="支出走势" android:layout_marginStart="10dp" />
                <FrameLayout android:id="@+id/bill_line_chart" android:layout_width="match_parent" android:layout_height="150dp" android:layout_marginTop="10dp" android:layout_below="@+id/line_title" />
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:layout_below="@+id/bill_line_chart">
                    <TextView android:textSize="10sp" android:textColor="@color/darkGrey" android:id="@+id/bill_line_start_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2021.5.12" android:layout_marginStart="15dp" />
                    <TextView android:textSize="10sp" android:textColor="@color/darkGrey" android:id="@+id/bill_line_end_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2021.5.12" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true" />
                </RelativeLayout>
            </RelativeLayout>
            <RelativeLayout android:id="@+id/category_pie_layout" android:background="@drawable/shape_bg_setting" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/category_pie_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="二级分类占比" android:layout_marginStart="10dp" />
                <RelativeLayout android:layout_width="match_parent" android:layout_height="200dp" android:layout_below="@+id/category_pie_title">
                    <FrameLayout android:id="@+id/category_pie_chart" android:layout_width="match_parent" android:layout_height="200dp" />
                    <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/category_chart_check" android:layout_width="60dp" android:layout_height="wrap_content" android:layout_centerInParent="true">
                        <ImageView android:id="@+id/category_chart_check_icon" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp" android:src="@mipmap/ic_checkout" android:tint="@color/darkGrey" />
                        <TextView android:textSize="10sp" android:textColor="@color/darkGrey" android:id="@+id/category_chart_check_tip_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="金额数值" />
                    </LinearLayout>
                </RelativeLayout>
            </RelativeLayout>
            <LinearLayout android:orientation="vertical" android:id="@+id/asset_layout" android:background="@drawable/shape_bg_setting" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="255dp" android:layout_margin="15dp">
                <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/asset_pie_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="账户占比" android:layout_marginStart="10dp" />
                <RelativeLayout android:layout_width="match_parent" android:layout_height="200dp">
                    <FrameLayout android:id="@+id/asset_pie_chart" android:layout_width="match_parent" android:layout_height="200dp" />
                    <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/asset_chart_check" android:layout_width="60dp" android:layout_height="wrap_content" android:layout_centerInParent="true">
                        <ImageView android:id="@+id/asset_chart_check_icon" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp" android:src="@mipmap/ic_checkout" android:tint="@color/darkGrey" />
                        <TextView android:textSize="10sp" android:textColor="@color/darkGrey" android:id="@+id/asset_chart_check_tip_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="金额数值" />
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>