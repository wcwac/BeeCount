<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/pay_layout" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:id="@+id/choice_from_asset" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="15dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
            <ImageView android:id="@+id/from_asset_icon" android:background="@drawable/shape_background_light_10" android:padding="12dp" android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_no_asset" />
            <RelativeLayout android:background="@drawable/shape_background_light_10" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="10dp" android:paddingEnd="10dp" android:layout_marginStart="10dp">
                <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/reduce_num">
                    <TextView android:textSize="13sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/from_asset_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:hint="转出账户" android:singleLine="true" />
                    <TextView android:textSize="11sp" android:textColor="@color/grey" android:id="@+id/from_asset_num" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:hint="余额：1234.00" android:singleLine="true" />
                </LinearLayout>
                <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/moneyPay" android:id="@+id/reduce_num" android:background="@color/transparent" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-15.11" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
            </RelativeLayout>
        </LinearLayout>
        <ImageView android:layout_gravity="center_horizontal" android:id="@+id/check_asset" android:background="@drawable/selectable_item_circle" android:padding="8dp" android:layout_width="32dp" android:layout_height="32dp" android:src="@mipmap/ic_asset_check" android:tint="@color/iconTint" />
        <LinearLayout android:id="@+id/choice_to_asset" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginBottom="10dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
            <ImageView android:id="@+id/to_asset_icon" android:background="@drawable/shape_background_light_10" android:padding="12dp" android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_no_asset" />
            <RelativeLayout android:background="@drawable/shape_background_light_10" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="10dp" android:paddingEnd="10dp" android:layout_marginStart="10dp">
                <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/add_num">
                    <TextView android:textSize="13sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/to_asset_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:hint="转入账户" android:singleLine="true" />
                    <TextView android:textSize="11sp" android:textColor="@color/grey" android:id="@+id/to_asset_num" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:hint="余额：1234.00" android:singleLine="true" />
                </LinearLayout>
                <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/moneyIncome" android:id="@+id/add_num" android:background="@color/transparent" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-15.11" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/set_repayment_layout" android:visibility="invisible" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="20dp">
            <CheckBox android:id="@+id/set_repayment" android:layout_width="30dp" android:layout_height="30dp" style="@style/autoCheckBox" />
            <TextView android:textSize="12dp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="转入到信贷账户，设为还款" />
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:id="@+id/radio_layout" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
            <RadioGroup android:id="@+id/radio_group" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <RadioButton android:id="@+id/radio_one" android:layout_width="30dp" android:layout_height="30dp" style="@style/autoRadioButton" />
                <RadioButton android:id="@+id/radio_two" android:layout_width="30dp" android:layout_height="30dp" style="@style/autoRadioButton" />
            </RadioGroup>
            <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:textSize="12dp" android:textColor="@color/black" android:gravity="center" android:id="@+id/radio_one_text" android:layout_width="wrap_content" android:layout_height="30dp" android:text="扣款金额(10) = 到账金额(5) + 手续费(5)" />
                <TextView android:textSize="12dp" android:textColor="@color/black" android:gravity="center" android:id="@+id/radio_two_text" android:layout_width="wrap_content" android:layout_height="30dp" android:text="扣款金额(10) = 到账金额(5) + 手续费(5)" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>