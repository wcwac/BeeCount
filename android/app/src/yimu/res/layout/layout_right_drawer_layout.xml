<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_gravity="end" android:background="@color/white" android:layout_width="match_parent" android:layout_height="match_parent">
    <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:overScrollMode="never">
        <LinearLayout android:orientation="vertical" android:id="@+id/lv_right" android:paddingTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="15dp" android:paddingEnd="15dp">
            <LinearLayout android:gravity="center" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/data_title" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="日期" />
                <TextView android:textSize="13sp" android:textColor="@color/textColorPrimary" android:id="@+id/data_clear" android:padding="10dp" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="清除" />
            </LinearLayout>
            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp">
                <TextView android:textSize="13sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:gravity="center" android:id="@+id/start_data" android:background="@drawable/shape_edit_frame" android:layout_width="match_parent" android:layout_height="40dp" android:hint="起始日期" android:layout_weight="1" />
                <TextView android:textSize="10sp" android:textColor="@color/grey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" />
                <TextView android:textSize="13sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:gravity="center" android:id="@+id/end_data" android:background="@drawable/shape_edit_frame" android:layout_width="match_parent" android:layout_height="40dp" android:hint="截止日期" android:layout_weight="1" />
                <ImageView android:id="@+id/date_setting" android:background="@drawable/selectable_item_circle" android:padding="9dp" android:layout_width="35dp" android:layout_height="35dp" android:src="@mipmap/ic_date_setting" android:tint="@color/iconTint" android:layout_marginStart="5dp" />
            </LinearLayout>
            <LinearLayout android:gravity="center" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="15dp">
                <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/black" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="金额" />
                <TextView android:textSize="13sp" android:textColor="@color/textColorPrimary" android:id="@+id/num_clear" android:padding="10dp" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="清除" />
            </LinearLayout>
            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp">
                <EditText android:textSize="13sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:gravity="center" android:id="@+id/min_num" android:background="@drawable/shape_edit_frame" android:layout_width="match_parent" android:layout_height="40dp" android:hint="最低金额" android:layout_weight="1" android:inputType="numberDecimal" android:imeOptions="actionDone" />
                <TextView android:textSize="10sp" android:textColor="@color/grey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" />
                <EditText android:textSize="13sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:gravity="center" android:id="@+id/max_num" android:background="@drawable/shape_edit_frame" android:layout_width="match_parent" android:layout_height="40dp" android:hint="最高金额" android:layout_weight="1" android:inputType="numberDecimal" android:imeOptions="actionDone" />
            </LinearLayout>
            <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="25dp" android:text="备注" />
            <EditText android:textSize="13sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:gravity="center_vertical" android:id="@+id/remark" android:background="@drawable/shape_edit_frame" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="12dp" android:hint="多个关键词可用空格分隔" android:imeOptions="actionDone" android:paddingStart="10dp" android:paddingEnd="10dp" />
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/selectable_item_expand" android:layout_width="wrap_content" android:layout_height="45dp" android:layout_marginTop="15dp">
                <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="账本" />
                <LinearLayout android:orientation="horizontal" android:id="@+id/add_book" android:background="@drawable/selectable_item_expand" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginStart="20dp">
                    <ImageView android:layout_gravity="center_vertical" android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_search_add" android:tint="@color/darkGrey" />
                    <TextView android:textSize="13sp" android:textColor="@color/darkGrey" android:gravity="center_vertical" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="添加账本" android:layout_marginStart="6dp" />
                </LinearLayout>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/book_list" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/selectable_item_expand" android:layout_width="wrap_content" android:layout_height="45dp" android:layout_marginTop="15dp">
                <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="账户" />
                <LinearLayout android:orientation="horizontal" android:id="@+id/add_asset" android:background="@drawable/selectable_item_expand" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginStart="20dp">
                    <ImageView android:layout_gravity="center_vertical" android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_search_add" android:tint="@color/darkGrey" />
                    <TextView android:textSize="13sp" android:textColor="@color/darkGrey" android:gravity="center_vertical" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="添加账户" android:layout_marginStart="6dp" />
                </LinearLayout>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/asset_list" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/selectable_item_expand" android:layout_width="wrap_content" android:layout_height="45dp" android:layout_marginTop="15dp">
                <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="报销" />
                <LinearLayout android:orientation="horizontal" android:id="@+id/add_reimbursement" android:background="@drawable/selectable_item_expand" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginStart="20dp">
                    <ImageView android:layout_gravity="center_vertical" android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_search_add" android:tint="@color/darkGrey" />
                    <TextView android:textSize="13sp" android:textColor="@color/darkGrey" android:gravity="center_vertical" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="添加报销" android:layout_marginStart="6dp" />
                </LinearLayout>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/reimbursement_list" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/selectable_item_expand" android:layout_width="wrap_content" android:layout_height="45dp" android:layout_marginTop="15dp">
                <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="分类" />
                <LinearLayout android:orientation="horizontal" android:id="@+id/add_type" android:background="@drawable/selectable_item_expand" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginStart="20dp">
                    <ImageView android:layout_gravity="center_vertical" android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_search_add" android:tint="@color/darkGrey" />
                    <TextView android:textSize="13sp" android:textColor="@color/darkGrey" android:gravity="center_vertical" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="添加分类" android:layout_marginStart="6dp" />
                </LinearLayout>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/type_list" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/selectable_item_expand" android:layout_width="wrap_content" android:layout_height="45dp" android:layout_marginTop="15dp">
                <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="标签" />
                <LinearLayout android:orientation="horizontal" android:id="@+id/add_tag" android:background="@drawable/selectable_item_expand" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginStart="20dp">
                    <ImageView android:layout_gravity="center_vertical" android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_search_add" android:tint="@color/darkGrey" />
                    <TextView android:textSize="13sp" android:textColor="@color/darkGrey" android:gravity="center_vertical" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="添加标签" android:layout_marginStart="6dp" />
                </LinearLayout>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/tag_list" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/selectable_item_expand" android:layout_width="wrap_content" android:layout_height="45dp" android:layout_marginTop="15dp">
                <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="成员" />
                <LinearLayout android:orientation="horizontal" android:id="@+id/add_member" android:background="@drawable/selectable_item_expand" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginStart="20dp">
                    <ImageView android:layout_gravity="center_vertical" android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_search_add" android:tint="@color/darkGrey" />
                    <TextView android:textSize="13sp" android:textColor="@color/darkGrey" android:gravity="center_vertical" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="添加成员" android:layout_marginStart="6dp" />
                </LinearLayout>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/member_list" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" android:layout_width="wrap_content" android:layout_height="45dp" android:layout_marginTop="15dp" android:text="其他" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/other_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="100dp" />
        </LinearLayout>
    </ScrollView>
    <RelativeLayout android:background="@color/white" android:layout_width="match_parent" android:layout_height="70dp" android:layout_alignParentBottom="true">
        <View android:background="@color/divider" android:layout_width="match_parent" android:layout_height="1px" />
        <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true">
            <TextView android:textSize="15sp" android:textColor="@color/darkGrey" android:gravity="center" android:id="@+id/init" android:background="@drawable/selectable_item_white_rect_background" android:layout_width="120dp" android:layout_height="40dp" android:text="重置" />
            <TextView android:textSize="15sp" android:textColor="@color/textColorLight" android:gravity="center" android:id="@+id/confirm" android:background="@drawable/selectable_item_primary_background" android:layout_width="120dp" android:layout_height="40dp" android:text="确认" android:layout_marginStart="20dp" />
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>