<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:id="@+id/parent_layout" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:id="@+id/tool_bar" android:background="@color/white" android:layout_width="match_parent" android:layout_height="50dp">
        <ImageView android:id="@+id/btn_back" android:background="@drawable/selectable_item_circle" android:padding="17dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_close" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" />
        <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="180dp" android:singleLine="true" android:layout_centerVertical="true" android:layout_toEndOf="@+id/btn_back" />
        <ImageView android:id="@+id/delete_btn" android:background="@drawable/selectable_item_circle" android:padding="14dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_delete" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" android:layout_toStartOf="@+id/save_btn" />
        <ImageView android:id="@+id/save_btn" android:background="@drawable/selectable_item_circle" android:padding="12dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_tick" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
        <RelativeLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="60dp">
            <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/name_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="分类名称" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
            <EditText android:textSize="15sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/name" android:background="@color/white" android:layout_width="match_parent" android:layout_height="match_parent" android:hint="输入类别名称" android:singleLine="true" android:imeOptions="actionDone" android:paddingStart="30dp" android:layout_toEndOf="@+id/name_title" />
        </RelativeLayout>
        <RelativeLayout android:orientation="horizontal" android:id="@+id/choice_icon" android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="60dp">
            <LinearLayout android:orientation="vertical" android:id="@+id/icon_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="15dp">
                <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="分类图标" />
                <TextView android:textSize="12sp" android:textColor="@color/grey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="点击可搜索、自定义图标" />
            </LinearLayout>
            <ImageView android:id="@+id/icon" android:padding="12dp" android:layout_width="48dp" android:layout_height="48dp" android:src="@mipmap/ic_temp" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:orientation="horizontal" android:id="@+id/night_icon_layout" android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="60dp">
            <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="15dp">
                <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="夜间模式图标" />
                <TextView android:textSize="12sp" android:textColor="@color/grey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="为夜间模式设置专属图标，默认为分类图标" />
            </LinearLayout>
            <ImageView android:id="@+id/icon_night" android:background="@drawable/shape_type_normal_night" android:padding="7dp" android:layout_width="38dp" android:layout_height="38dp" android:layout_centerVertical="true" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/hide_layout" android:background="?android:attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="60dp" android:paddingStart="15dp" android:paddingEnd="15dp">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_toStartOf="@+id/switch_hide_account_book">
                <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="仅在当前账本显示" />
                <TextView android:textSize="12sp" android:textColor="@color/grey" android:id="@+id/hide_tip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="在其他账本隐藏此分类，仅显示在：" android:singleLine="true" />
            </LinearLayout>
            <Switch android:id="@+id/switch_hide_account_book" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="15dp">
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:gravity="center" android:id="@+id/type_line_layout" android:layout_width="0dp" android:layout_height="45dp" android:layout_weight="1">
                <ImageView android:id="@+id/line_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@mipmap/ic_parent_shopping" android:tint="@color/colorPrimary" />
                <TextView android:textSize="14sp" android:textColor="@color/colorPrimary" android:id="@+id/line_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="线条风格" android:layout_marginStart="10dp" />
            </LinearLayout>
            <LinearLayout android:gravity="center" android:id="@+id/type_color_layout" android:layout_width="0dp" android:layout_height="45dp" android:layout_weight="1">
                <ImageView android:id="@+id/color_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@mipmap/color_ic_parent_shopping" />
                <TextView android:textSize="14sp" android:textColor="@color/darkGrey" android:id="@+id/color_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="多彩风格" android:layout_marginStart="10dp" />
            </LinearLayout>
        </LinearLayout>
        <View android:background="@color/colorPrimaryAlpha30" android:layout_width="match_parent" android:layout_height="1px" />
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/menu_list" android:paddingBottom="10dp" android:layout_width="70dp" android:layout_height="match_parent" android:overScrollMode="never" android:paddingStart="5dp" android:paddingEnd="5dp" />
            <View android:background="@color/colorPrimaryAlpha30" android:layout_width="1px" android:layout_height="match_parent" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/icon_list" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never" android:paddingStart="5dp" android:paddingEnd="5dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>