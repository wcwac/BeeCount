<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:id="@+id/parent_layout" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp">
    <RelativeLayout android:id="@+id/total_layout" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="15dp">
        <ImageView android:id="@+id/icon" android:layout_width="20dp" android:layout_height="20dp" android:src="@mipmap/ic_parent_education" android:layout_centerVertical="true" />
        <RelativeLayout android:gravity="center_vertical" android:orientation="vertical" android:id="@+id/info_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="10dp" android:layout_toStartOf="@+id/arrow" android:layout_toEndOf="@+id/icon">
            <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/category" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="购物消费" />
            <RelativeLayout android:id="@+id/budget_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_below="@+id/category">
                <FrameLayout android:id="@+id/progress_view_one" android:layout_width="match_parent" android:layout_height="4dp" />
                <FrameLayout android:id="@+id/progress_view_two" android:layout_width="match_parent" android:layout_height="4dp" />
            </RelativeLayout>
            <TextView android:textSize="11sp" android:textColor="@color/grey" android:id="@+id/pay_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="支出：" android:layout_below="@+id/budget_progress" android:layout_alignParentEnd="true" />
            <TextView android:textSize="11sp" android:textColor="@color/darkGrey" android:id="@+id/budget_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="666.3 / 994" android:layout_below="@+id/budget_progress" />
        </RelativeLayout>
        <ImageView android:id="@+id/arrow" android:padding="10dp" android:layout_width="38dp" android:layout_height="38dp" android:src="@mipmap/ic_bottom_small" android:tint="@color/iconTint" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/child_category_budget" android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>