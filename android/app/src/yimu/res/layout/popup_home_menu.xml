<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:id="@+id/parent_layout" android:background="@drawable/background_home_popup" android:layout_width="250dp" android:layout_height="wrap_content">
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/btn_custom_module" android:background="@drawable/selectable_item_expand_mask" android:layout_width="250dp" android:layout_height="50dp" android:paddingStart="12dp" android:paddingEnd="15sp">
        <ImageView android:padding="3dp" android:layout_width="25dp" android:layout_height="25dp" android:src="@mipmap/ic_home_custom_module" android:tint="@color/black" />
        <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="数据小卡片" android:layout_marginStart="6dp" />
    </LinearLayout>
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/btn_screenshot" android:background="@drawable/selectable_item_expand_mask" android:layout_width="250dp" android:layout_height="50dp" android:paddingStart="12dp" android:paddingEnd="15sp">
        <ImageView android:padding="3dp" android:layout_width="25dp" android:layout_height="25dp" android:src="@mipmap/ic_home_screenshot" android:tint="@color/black" />
        <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="截图导入" android:layout_marginStart="6dp" />
    </LinearLayout>
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/btn_share_book" android:background="@drawable/selectable_item_expand_mask" android:layout_width="250dp" android:layout_height="50dp" android:paddingStart="12dp" android:paddingEnd="15sp">
        <ImageView android:padding="3dp" android:layout_width="25dp" android:layout_height="25dp" android:src="@mipmap/ic_home_share" android:tint="@color/black" />
        <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="共享账本" android:layout_marginStart="6dp" />
    </LinearLayout>
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/btn_module_bill" android:background="@drawable/selectable_item_expand_mask" android:layout_width="250dp" android:layout_height="50dp" android:paddingStart="12dp" android:paddingEnd="15sp">
        <ImageView android:padding="3dp" android:layout_width="25dp" android:layout_height="25dp" android:src="@mipmap/ic_home_module" android:tint="@color/black" />
        <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="模板记账" android:layout_marginStart="6dp" />
    </LinearLayout>
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/btn_budget_manager" android:background="@drawable/selectable_item_expand_mask" android:layout_width="250dp" android:layout_height="50dp" android:paddingStart="12dp" android:paddingEnd="15sp">
        <ImageView android:padding="3dp" android:layout_width="25dp" android:layout_height="25dp" android:src="@mipmap/ic_home_budget" android:tint="@color/black" />
        <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="预算管理" android:layout_marginStart="6dp" />
    </LinearLayout>
    <TextView android:textSize="12sp" android:textColor="@color/grey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="视图" android:layout_marginStart="15dp" />
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginBottom="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
        <LinearLayout android:gravity="center" android:id="@+id/btn_bill_mode_simple" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginTop="10dp" android:layout_weight="1">
            <ImageView android:id="@+id/mode_simple_icon" android:layout_width="20dp" android:layout_height="20dp" android:src="@mipmap/ic_home_mode_simple" />
            <TextView android:textSize="14sp" android:id="@+id/mode_simple_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="简约" android:layout_marginStart="10dp" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:id="@+id/btn_bill_mode_detail" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginTop="10dp" android:layout_weight="1" android:layout_marginStart="15dp">
            <ImageView android:id="@+id/mode_detail_icon" android:layout_width="20dp" android:layout_height="20dp" android:src="@mipmap/ic_home_mode_detail" />
            <TextView android:textSize="14sp" android:id="@+id/mode_detail_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="详细" android:layout_marginStart="10dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>