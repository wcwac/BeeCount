<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:gravity="center_vertical" android:id="@+id/total_layout" android:background="@color/translate" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="wrap_content">
    <ImageView android:id="@+id/background" android:clickable="false" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:layout_alignBottom="@+id/content_layout" />
    <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/content_layout" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <RelativeLayout android:layout_width="30dp" android:layout_height="30dp">
            <ImageView android:id="@+id/dream_image_night" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" />
            <ImageView android:id="@+id/dream_image" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_launcher_no_color" />
        </RelativeLayout>
        <LinearLayout android:gravity="center_vertical" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="5dp">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginEnd="20dp" android:layout_toStartOf="@+id/progress_num">
                    <TextView android:textSize="14sp" android:textColor="@color/white" android:id="@+id/dream_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="花呗" android:singleLine="true" />
                    <TextView android:textSize="14sp" android:textColor="@color/white" android:id="@+id/dream_finish" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="（达成）" android:singleLine="true" />
                </LinearLayout>
                <TextView android:textSize="13sp" android:textColor="@color/white" android:id="@+id/progress_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10711" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <ImageView android:id="@+id/num_progress" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="3dp" android:layout_marginBottom="3dp" />
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
                <TextView android:textSize="11sp" android:textColor="@color/white" android:ellipsize="end" android:id="@+id/dream_remark" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="11111" android:singleLine="true" android:layout_marginEnd="20dp" android:layout_toStartOf="@+id/total_num" />
                <TextView android:textSize="11sp" android:textColor="@color/white" android:id="@+id/total_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" />
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout android:id="@+id/open_vip_layout" android:background="@drawable/shape_bg_black25_15" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent">
        <TextView android:textSize="15sp" android:textColor="@color/white" android:gravity="center" android:id="@+id/open_vip" android:background="@drawable/shape_bg_open_vip_btn" android:layout_width="150dp" android:layout_height="50dp" android:layout_marginBottom="30dp" android:text="立即开通" android:layout_alignParentBottom="true" android:layout_centerHorizontal="true" />
    </RelativeLayout>
</RelativeLayout>