<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_gravity="bottom" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
    <FrameLayout android:id="@+id/top_layout" android:background="@drawable/image_bg_top" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="@color/image_color_primary" android:gravity="center_vertical" android:id="@+id/tv_cancel" android:focusable="true" android:clickable="true" android:layout_width="wrap_content" android:layout_height="50dp" android:text="@string/image_cancel" android:paddingStart="15dp" android:paddingEnd="15dp" />
        <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="@color/image_color_primary" android:gravity="center_vertical" android:layout_gravity="end" android:id="@+id/tv_done" android:focusable="true" android:clickable="true" android:layout_width="wrap_content" android:layout_height="50dp" android:text="@string/image_done" android:paddingStart="15dp" android:paddingEnd="15dp" />
    </FrameLayout>
    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/layout_op_sub" android:visibility="invisible" android:layout_width="match_parent" android:layout_height="wrap_content">
        <ViewSwitcher android:id="@+id/vs_op_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:measureAllChildren="true">
            <FrameLayout android:gravity="center" android:layout_gravity="center" android:orientation="horizontal" android:id="@+id/cg_colors" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkedButton="@+id/cr_red">
                <FrameLayout android:id="@+id/cr_red" android:layout_width="@dimen/image_color" android:layout_height="@dimen/image_color" android:layout_margin="@dimen/image_color_margin" android:button="@null" app:image_color="@color/image_color_red" />
                <FrameLayout android:layout_width="@dimen/image_color" android:layout_height="@dimen/image_color" android:layout_margin="@dimen/image_color_margin" app:image_color="@color/image_color_black" />
                <FrameLayout android:layout_width="@dimen/image_color" android:layout_height="@dimen/image_color" android:layout_margin="@dimen/image_color_margin" app:image_color="@color/image_color_white" />
                <FrameLayout android:layout_width="@dimen/image_color" android:layout_height="@dimen/image_color" android:layout_margin="@dimen/image_color_margin" app:image_color="@color/image_color_cyan" />
                <FrameLayout android:layout_width="@dimen/image_color" android:layout_height="@dimen/image_color" android:layout_margin="@dimen/image_color_margin" app:image_color="@color/image_color_yellow" />
                <FrameLayout android:layout_width="@dimen/image_color" android:layout_height="@dimen/image_color" android:layout_margin="@dimen/image_color_margin" app:image_color="@color/image_color_blue" />
            </FrameLayout>
            <TextView android:textSize="12sp" android:textColor="@color/image_color_white" android:layout_gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/image_mosaic_tip" />
        </ViewSwitcher>
        <ImageButton android:id="@+id/btn_undo" android:background="@null" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/image_btn_undo" android:contentDescription="@string/image_undo" />
    </LinearLayout>
    <RadioGroup android:gravity="center" android:orientation="horizontal" android:id="@+id/rg_modes" android:background="@drawable/image_bg_bottom" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <RadioButton android:textColor="#fff" android:gravity="center" android:id="@+id/rb_doodle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:button="@drawable/image_btn_doodle" />
        <Space android:layout_width="@dimen/image_mode_space" android:layout_height="wrap_content" />
        <ImageButton android:textColor="#fff" android:gravity="center" android:id="@+id/btn_text" android:background="@null" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/image_btn_text" android:contentDescription="@string/image_text" />
        <Space android:layout_width="@dimen/image_mode_space" android:layout_height="wrap_content" />
        <RadioButton android:textColor="#fff" android:gravity="center" android:id="@+id/rb_mosaic" android:layout_width="wrap_content" android:layout_height="wrap_content" android:button="@drawable/image_btn_mosaic" />
        <Space android:layout_width="@dimen/image_mode_space" android:layout_height="wrap_content" />
        <ImageButton android:textColor="#fff" android:gravity="center" android:id="@+id/btn_clip" android:background="@null" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/image_btn_clip" android:contentDescription="@string/image_clip" />
    </RadioGroup>
</LinearLayout>