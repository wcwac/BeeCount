<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/total_layout" android:background="@color/translate" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="55dp">
    <ImageView android:id="@+id/background" android:clickable="false" android:layout_width="match_parent" android:layout_height="55dp" android:scaleType="fitXY" />
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:clickable="false" android:layout_width="match_parent" android:layout_height="55dp">
        <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/one_layout" android:layout_width="0dp" android:layout_height="wrap_content" android:src="@mipmap/ic_launcher" android:layout_weight="1">
            <TextView android:textSize="18sp" android:textColor="@color/black" android:id="@+id/day_pay_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:singleLine="true" />
            <TextView android:textSize="12sp" android:textColor="@color/black" android:id="@+id/day_pay_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="今日支出" android:singleLine="true" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/two_layout" android:layout_width="0dp" android:layout_height="wrap_content" android:src="@mipmap/ic_launcher" android:layout_weight="1">
            <TextView android:textSize="18sp" android:textColor="@color/black" android:id="@+id/month_pay_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:singleLine="true" />
            <TextView android:textSize="12sp" android:textColor="@color/black" android:id="@+id/month_pay_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="本月支出" android:singleLine="true" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/three_layout" android:layout_width="0dp" android:layout_height="wrap_content" android:src="@mipmap/ic_launcher" android:layout_weight="1">
            <TextView android:textSize="18sp" android:textColor="@color/black" android:id="@+id/month_income_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:singleLine="true" />
            <TextView android:textSize="12sp" android:textColor="@color/black" android:id="@+id/month_income_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="本月收入" android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>