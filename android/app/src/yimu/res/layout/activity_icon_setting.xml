<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="horizontal" android:paddingTop="15dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="15dp" android:paddingEnd="15dp">
        <LinearLayout android:gravity="center" android:id="@+id/type_line_layout" android:background="@drawable/shape_bg_white_15" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1">
            <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@mipmap/ic_transfer_accounts" android:tint="@color/black" />
            <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="线条风格" android:layout_marginStart="10dp" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:id="@+id/type_color_layout" android:background="@drawable/shape_bg_white_15" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginStart="15dp">
            <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@mipmap/color_ic_transfer_accounts" />
            <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="多彩风格" android:layout_marginStart="10dp" />
        </LinearLayout>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/data_list" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp" android:overScrollMode="never" />
</LinearLayout>