<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <RelativeLayout android:id="@+id/tool_bar" android:background="@color/white" android:layout_width="match_parent" android:layout_height="50dp">
            <ImageView android:id="@+id/btn_back" android:background="@drawable/selectable_item_circle" android:padding="16dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_back" android:scaleType="fitCenter" android:tint="@color/black" />
            <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="50dp" android:maxWidth="180dp" android:text="主题外观" android:singleLine="true" android:layout_toEndOf="@+id/btn_back" />
            <ImageView android:id="@+id/right_icon" android:background="@drawable/selectable_item_circle" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_bar_more" android:scaleType="centerInside" android:tint="@color/black" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <androidx.core.widget.NestedScrollView android:id="@+id/scroll_layout" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:orientation="vertical" android:paddingBottom="50dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <RelativeLayout android:id="@+id/theme_share" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="55dp" android:layout_margin="15dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                    <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="主题分享中心" android:layout_centerVertical="true" />
                </RelativeLayout>
                <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                    <RelativeLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:textSize="13sp" android:textColor="@color/grey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginBottom="15dp" android:text="应用LOGO" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" />
                        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/more_logo" android:padding="15dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true">
                            <TextView android:textSize="13sp" android:textColor="@color/textColorPrimary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="更多LOGO" />
                            <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@mipmap/ic_more" android:tint="@color/textColorPrimary" android:layout_marginStart="3dp" />
                        </LinearLayout>
                    </RelativeLayout>
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/logo_list" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:overScrollMode="never" android:paddingStart="10dp" android:paddingEnd="10dp" />
                </LinearLayout>
                <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                    <LinearLayout android:gravity="center" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
                        <TextView android:textSize="13sp" android:textColor="@color/grey" android:id="@+id/name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginBottom="15dp" android:text="自定义背景" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" />
                    </LinearLayout>
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/theme_background_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:overScrollMode="never" />
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/theme_parent_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:overScrollMode="never" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</RelativeLayout>