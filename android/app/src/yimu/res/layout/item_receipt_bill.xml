<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="horizontal" android:paddingTop="5dp" android:paddingBottom="5dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:textSize="13sp" android:textColor="@color/blackNoChange" android:id="@+id/name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
    <TextView android:textSize="13sp" android:textColor="@color/blackNoChange" android:gravity="center_horizontal" android:id="@+id/num" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
    <TextView android:textSize="13sp" android:textColor="@color/blackNoChange" android:gravity="end" android:id="@+id/cost" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
</LinearLayout>