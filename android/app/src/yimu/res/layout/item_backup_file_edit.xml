<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:paddingEnd="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
    <RelativeLayout android:layout_width="wrap_content" android:layout_height="match_parent">
        <RadioButton android:id="@+id/radio_button" android:background="@color/transparent" android:focusable="false" android:clickable="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
        <View android:id="@+id/click_layout" android:layout_width="50dp" android:layout_height="match_parent" android:paddingStart="15dp" android:paddingEnd="5dp" />
    </RelativeLayout>
    <LinearLayout android:orientation="vertical" android:id="@+id/total_layout" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:textSize="15sp" android:textColor="@color/darkGrey" android:id="@+id/name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="首发申请表格.csv" android:singleLine="true" />
        <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp">
            <TextView android:textSize="13sp" android:textColor="@color/grey" android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1天前" android:singleLine="true" />
            <TextView android:textSize="13sp" android:textColor="@color/grey" android:id="@+id/size" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:layout_marginStart="18dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>