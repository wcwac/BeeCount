<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/total_layout" android:background="@drawable/shape_bg_setting" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginStart="10dp" android:layout_marginEnd="10dp">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/cost_layout">
        <RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
            <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/bill_layout" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <ImageView android:id="@+id/icon" android:layout_width="15dp" android:layout_height="15dp" />
                <TextView android:textSize="13sp" android:textColor="@color/black" android:id="@+id/name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="购物消费" android:singleLine="true" android:layout_marginStart="5dp" />
            </LinearLayout>
        </RelativeLayout>
        <LinearLayout android:orientation="horizontal" android:id="@+id/asset_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp">
            <TextView android:textSize="11sp" android:textColor="@color/grey" android:id="@+id/asset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="无账户" android:singleLine="true" />
            <TextView android:textSize="11sp" android:textColor="@color/grey" android:id="@+id/reimbursement" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="不报销" android:singleLine="true" android:layout_marginStart="15dp" />
        </LinearLayout>
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/remark_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp">
            <ImageView android:id="@+id/has_file_tag" android:visibility="gone" android:layout_width="12dp" android:layout_height="12dp" android:src="@mipmap/ic_bill_has_file" android:tint="@color/darkGrey" android:layout_marginEnd="5dp" />
            <TextView android:textSize="9sp" android:ellipsize="end" android:gravity="center" android:id="@+id/tag_one" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="16dp" android:maxWidth="60dp" android:text="旅游账单" android:singleLine="true" android:paddingStart="5dp" android:paddingEnd="5dp" android:layout_marginEnd="5dp" />
            <TextView android:textSize="9sp" android:ellipsize="end" android:gravity="center" android:id="@+id/tag_two" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="16dp" android:maxWidth="60dp" android:text="旅游账单" android:singleLine="true" android:paddingStart="5dp" android:paddingEnd="5dp" android:layout_marginEnd="5dp" />
            <TextView android:textSize="9sp" android:ellipsize="end" android:gravity="center" android:id="@+id/tag_three" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="16dp" android:maxWidth="60dp" android:text="旅游账单" android:singleLine="true" android:paddingStart="5dp" android:paddingEnd="5dp" android:layout_marginEnd="5dp" />
            <TextView android:textSize="11sp" android:textColor="@color/darkGrey" android:ellipsize="end" android:id="@+id/remark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:gravity="end" android:orientation="vertical" android:id="@+id/cost_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_alignParentEnd="true">
        <TextView android:textSize="15sp" android:id="@+id/cost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" />
        <TextView android:textSize="10sp" android:textColor="@color/grey" android:id="@+id/service_charge" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="手续费：0.00" />
    </LinearLayout>
</RelativeLayout>