<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/total_layout" android:background="@drawable/selectable_item_light_primary_background" android:layout_width="200dp" android:layout_height="40dp" android:layout_marginTop="5dp">
    <RelativeLayout android:id="@+id/content_layout" android:layout_width="match_parent" android:layout_height="match_parent">
        <ImageView android:id="@+id/cover" android:layout_width="30dp" android:layout_height="30dp" android:layout_centerVertical="true" android:layout_marginStart="12dp" />
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="8dp" android:layout_toStartOf="@+id/right_layout" android:layout_toEndOf="@+id/cover">
            <TextView android:textSize="13sp" android:textColor="@color/black" android:id="@+id/file_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" />
            <TextView android:textSize="11sp" android:textColor="@color/grey" android:id="@+id/file_size" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:singleLine="true" />
        </LinearLayout>
        <RelativeLayout android:id="@+id/right_layout" android:layout_width="35dp" android:layout_height="35dp" android:layout_centerVertical="true" android:layout_alignParentEnd="true">
            <ImageView android:id="@+id/upload" android:background="@drawable/selectable_item_circle" android:padding="6dp" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_upload" android:layout_centerInParent="true" android:layout_centerVertical="true" />
            <FrameLayout android:id="@+id/upload_progress" android:visibility="gone" android:layout_width="30dp" android:layout_height="30dp" android:layout_centerInParent="true" android:backgroundTintMode="add" app:adpgb_background_color="@android:color/transparent" app:adpgb_finished_color="@color/colorPrimary" app:adpgb_finished_stroke_width="4dp" app:adpgb_show_text="false" app:adpgb_unfinished_color="@android:color/white" app:adpgb_unfinished_stroke_width="3dp" />
        </RelativeLayout>
    </RelativeLayout>
    <LinearLayout android:orientation="horizontal" android:id="@+id/edit_layout" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_centerVertical="true" android:layout_alignParentEnd="true">
        <ImageView android:id="@+id/share" android:background="@drawable/selectable_item_circle" android:padding="5dp" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_file_share" />
        <ImageView android:id="@+id/delete" android:background="@drawable/selectable_item_circle" android:padding="6dp" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_file_delete" android:layout_marginStart="10dp" android:layout_marginEnd="5dp" />
    </LinearLayout>
</RelativeLayout>