<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:id="@+id/tool_bar" android:background="@color/white" android:layout_width="match_parent" android:layout_height="50dp">
        <ImageView android:id="@+id/btn_back" android:background="@drawable/selectable_item_circle" android:padding="17dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_close" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" />
        <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="180dp" android:text="设置智能标签" android:singleLine="true" android:layout_centerVertical="true" android:layout_toEndOf="@+id/btn_back" />
        <TextView android:textSize="15sp" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/clear_text" android:background="@drawable/selectable_item_circle" android:layout_width="wrap_content" android:layout_height="50dp" android:text="清除" android:singleLine="true" android:paddingStart="10dp" android:paddingEnd="10dp" android:layout_toStartOf="@+id/btn_complete" />
        <ImageView android:id="@+id/btn_complete" android:background="@drawable/selectable_item_circle" android:padding="12dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_tick" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <RelativeLayout android:id="@+id/text_tip_layout" android:background="@drawable/selectable_item_light_primary_background" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
        <TextView android:textSize="12sp" android:textColor="@color/colorPrimaryDark" android:id="@+id/auto_tip" android:paddingTop="5dp" android:paddingBottom="5dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="当账单满足以下所有条件时，会自动设置当前标签。备注、地点多关键词可用空格分隔，包含任意关键词即可触发。智能标签仅对新增的账单生效" android:layout_centerVertical="true" android:lineSpacingExtra="3dp" android:layout_marginStart="10dp" android:layout_marginEnd="30dp" />
        <ImageView android:id="@+id/tip_close" android:padding="3dp" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_tip_close" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginBottom="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
        <RelativeLayout android:id="@+id/choice_category" android:layout_width="match_parent" android:layout_height="55dp">
            <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="账单分类" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
            <TextView android:textSize="13sp" android:textColor="@color/darkGrey" android:gravity="end" android:id="@+id/category_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="200dp" android:text="所有" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/ic_category_more" />
            <ImageView android:id="@+id/ic_category_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/choice_num" android:layout_width="match_parent" android:layout_height="55dp">
            <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="账单金额" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
            <TextView android:textSize="13sp" android:textColor="@color/darkGrey" android:gravity="end" android:id="@+id/num_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="200dp" android:text="所有" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/ic_num_more" />
            <ImageView android:id="@+id/ic_num_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/choice_asset" android:layout_width="match_parent" android:layout_height="55dp">
            <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="收支账户" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
            <TextView android:textSize="13sp" android:textColor="@color/darkGrey" android:gravity="end" android:id="@+id/asset_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="200dp" android:text="所有" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/ic_asset_more" />
            <ImageView android:id="@+id/ic_asset_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/choice_reimbursement" android:layout_width="match_parent" android:layout_height="55dp">
            <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="报销账户" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
            <TextView android:textSize="13sp" android:textColor="@color/darkGrey" android:gravity="end" android:id="@+id/reimbursement_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="200dp" android:text="所有" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/ic_reimbursement_more" />
            <ImageView android:id="@+id/ic_reimbursement_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/choice_account_book" android:layout_width="match_parent" android:layout_height="55dp">
            <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="所属账本" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
            <TextView android:textSize="13sp" android:textColor="@color/darkGrey" android:gravity="end" android:id="@+id/account_book_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="200dp" android:text="所有" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/ic_account_book_more" />
            <ImageView android:id="@+id/ic_account_book_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/set_remark" android:layout_width="match_parent" android:layout_height="55dp">
            <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="账单备注" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
            <TextView android:textSize="13sp" android:textColor="@color/darkGrey" android:gravity="end" android:id="@+id/remark_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="200dp" android:text="所有" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/ic_remark_more" />
            <ImageView android:id="@+id/ic_remark_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/set_address" android:layout_width="match_parent" android:layout_height="55dp">
            <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="账单地点" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
            <TextView android:textSize="13sp" android:textColor="@color/darkGrey" android:gravity="end" android:id="@+id/address_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="200dp" android:text="所有" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/ic_address_more" />
            <ImageView android:id="@+id/ic_address_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/set_device" android:layout_width="match_parent" android:layout_height="55dp">
            <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="记录设备" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
            <TextView android:textSize="13sp" android:textColor="@color/darkGrey" android:gravity="end" android:id="@+id/device_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="200dp" android:text="所有" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/ic_device_more" />
            <ImageView android:id="@+id/ic_device_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>