<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:id="@+id/parent_layout" android:background="@drawable/bg_add_bill_dialog" android:layout_width="match_parent" android:layout_height="wrap_content">
    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="15dp" android:paddingStart="15dp">
        <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="选择账户" />
        <TextView android:textSize="12sp" android:textColor="@color/grey" android:id="@+id/tip_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="长按拖动可进行排序" android:layout_below="@+id/title" />
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/show_current_book_layout" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:layout_below="@+id/title">
            <ImageView android:id="@+id/show_current_book_icon" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_not_check" android:tint="@color/colorPrimary" />
            <TextView android:textSize="12sp" android:textColor="@color/grey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="仅显示当前账本账户" android:layout_marginStart="5dp" />
        </LinearLayout>
        <ImageView android:id="@+id/add_asset" android:background="@drawable/selectable_item_circle" android:padding="8dp" android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_add_asset" android:tint="@color/black" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
        <ImageView android:id="@+id/change_mode" android:background="@drawable/selectable_item_circle" android:padding="12dp" android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_asset_choice_one" android:tint="@color/black" android:layout_toStartOf="@+id/add_asset" />
        <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/textColorPrimary" android:gravity="center_vertical" android:id="@+id/group_asset" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="40dp" android:text="组合支付" android:paddingStart="10dp" android:paddingEnd="10dp" android:layout_toStartOf="@+id/change_mode" />
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RelativeLayout android:id="@+id/group_list_layout" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content">
                <View android:background="@color/divider" android:layout_width="match_parent" android:layout_height="1px" />
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="400dp">
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/group_list" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" android:overScrollMode="never" />
                    <View android:background="@color/divider" android:layout_width="1px" android:layout_height="match_parent" />
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/asset_list" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="150dp" android:layout_weight="7" android:overScrollMode="never" />
                </LinearLayout>
            </RelativeLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/data_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="400dp" android:overScrollMode="never" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>