<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/total_layout" android:background="@drawable/shape_bg_setting" android:padding="15dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
    <LinearLayout android:orientation="horizontal" android:id="@+id/name_layout" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <TextView android:textSize="15sp" android:textColor="@color/black" android:id="@+id/code" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AED" />
        <TextView android:textSize="15sp" android:textColor="@color/black" android:id="@+id/line" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" />
        <TextView android:textSize="15sp" android:textColor="@color/black" android:id="@+id/name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="阿联酋迪拜" />
    </LinearLayout>
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/rate_edit_one" android:paddingTop="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_below="@+id/name_layout">
        <TextView android:textSize="13sp" android:textColor="@color/grey" android:id="@+id/rate_one" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 AED=0.23694CNY" />
        <ImageView android:visibility="gone" android:layout_width="20dp" android:layout_height="20dp" android:src="@mipmap/ic_bill_edit" android:tint="@color/grey" android:layout_marginStart="5dp" />
    </LinearLayout>
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/rate_edit_two" android:paddingTop="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_below="@+id/rate_edit_one">
        <TextView android:textSize="13sp" android:textColor="@color/grey" android:id="@+id/rate_two" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 AED=0.23694CNY" />
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@mipmap/ic_bill_edit" android:tint="@color/grey" android:layout_marginStart="5dp" />
    </LinearLayout>
    <ImageView android:id="@+id/tick" android:layout_width="23dp" android:layout_height="23dp" android:src="@mipmap/ic_tick" android:tint="@color/iconTint" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
</RelativeLayout>