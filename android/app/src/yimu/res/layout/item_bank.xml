<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="45dp" android:paddingStart="15dp">
    <ImageView android:id="@+id/icon" android:layout_width="22dp" android:layout_height="22dp" android:layout_centerVertical="true" />
    <TextView android:textSize="15sp" android:textColor="@color/black" android:id="@+id/name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="中国银行" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_toEndOf="@+id/icon" />
    <View android:background="@color/divider" android:layout_width="match_parent" android:layout_height="1px" android:layout_alignParentBottom="true" />
</RelativeLayout>