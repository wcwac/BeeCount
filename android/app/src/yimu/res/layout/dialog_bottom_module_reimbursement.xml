<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:orientation="vertical" android:id="@+id/total_layout" android:background="@drawable/shape_background_light_top_10" android:paddingBottom="50dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="15dp" android:paddingEnd="15dp">
    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="模块设置" />
        <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/complete_btn" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="完成" android:paddingStart="10dp" android:layout_alignParentEnd="true" />
        <ImageView android:id="@+id/delete_btn" android:padding="10dp" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginTop="10dp" android:src="@mipmap/ic_delete" android:tint="@color/black" android:layout_toStartOf="@+id/complete_btn" />
    </RelativeLayout>
    <include android:layout_gravity="center_horizontal" android:layout_width="100dp" android:layout_height="100dp" android:layout_marginTop="15dp" layout="@layout/item_custom_reimbursement" />
    <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp">
        <RelativeLayout android:id="@+id/widget_layout" android:layout_width="match_parent" android:layout_height="60dp" android:paddingStart="15dp" android:paddingEnd="15dp">
            <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="模块尺寸" android:layout_centerVertical="true" />
            <TextView android:textSize="13sp" android:textColor="@color/black" android:id="@+id/widget" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="屏幕宽度 / 3" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/book_layout" android:layout_width="match_parent" android:layout_height="60dp" android:paddingStart="15dp" android:paddingEnd="15dp">
            <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="指定账本" android:layout_centerVertical="true" />
            <TextView android:textSize="13sp" android:textColor="@color/black" android:id="@+id/book_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="在所有账本显示" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/title_layout" android:layout_width="match_parent" android:layout_height="60dp" android:paddingStart="15dp" android:paddingEnd="5dp">
            <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="标题颜色" android:layout_centerVertical="true" />
            <RelativeLayout android:id="@+id/title_color_layout" android:layout_width="40dp" android:layout_height="40dp" android:layout_centerVertical="true" android:layout_alignParentEnd="true">
                <View android:id="@+id/title_color" android:background="@color/black" android:layout_width="20dp" android:layout_height="20dp" android:layout_centerInParent="true" app:oval="false" />
            </RelativeLayout>
        </RelativeLayout>
        <RelativeLayout android:id="@+id/mode_layout" android:layout_width="match_parent" android:layout_height="60dp" android:paddingStart="15dp" android:paddingEnd="5dp">
            <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="副标题颜色" android:layout_centerVertical="true" />
            <RelativeLayout android:id="@+id/mode_color_layout" android:layout_width="40dp" android:layout_height="40dp" android:layout_centerVertical="true" android:layout_alignParentEnd="true">
                <View android:id="@+id/mode_color" android:background="@color/grey" android:layout_width="20dp" android:layout_height="20dp" android:layout_centerInParent="true" />
            </RelativeLayout>
        </RelativeLayout>
        <RelativeLayout android:id="@+id/num_color_layout" android:layout_width="match_parent" android:layout_height="60dp" android:paddingStart="15dp" android:paddingEnd="15dp">
            <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="金额颜色" android:layout_centerVertical="true" />
            <View android:id="@+id/num_color" android:background="@color/moneyPay" android:layout_width="20dp" android:layout_height="20dp" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/background_layout" android:layout_width="match_parent" android:layout_height="60dp" android:paddingStart="15dp" android:paddingEnd="15dp">
            <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="设置背景" android:layout_centerVertical="true" />
            <ImageView android:id="@+id/background_image" android:layout_width="40dp" android:layout_height="40dp" android:scaleType="centerCrop" android:layout_centerVertical="true" android:layout_alignParentEnd="true" app:corner_radius="5dp" app:oval="false" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/alpha_layout" android:layout_width="match_parent" android:layout_height="60dp" android:paddingStart="15dp">
            <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="背景透明度" android:layout_centerVertical="true" />
            <SeekBar android:id="@+id/background_seek_bar" android:layout_width="200dp" android:layout_height="wrap_content" android:progress="100" android:layout_centerVertical="true" android:layout_alignParentEnd="true" style="@style/CustomSeekbarStyle" />
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>