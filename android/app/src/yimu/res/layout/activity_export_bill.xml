<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp">
        <RelativeLayout android:id="@+id/bill_date_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="55dp">
            <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="日期范围" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
            <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/bill_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="所有时间" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/bill_date_more" />
            <ImageView android:id="@+id/bill_date_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/bill_book_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="55dp">
            <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="账本" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
            <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/bill_book" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="所有账本" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/bill_book_more" />
            <ImageView android:id="@+id/bill_book_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/export_type_layout" android:background="@drawable/selectable_item_expand_mask" android:visibility="gone" android:layout_width="match_parent" android:layout_height="55dp">
            <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="导出方式" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
            <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/export_type" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="保存到本地" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/export_type_more" />
            <ImageView android:id="@+id/export_type_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/file_type_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="55dp">
            <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="文件格式" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
            <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/file_type" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Excel文件" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/file_type_more" />
            <ImageView android:id="@+id/file_type_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/export_path_layout" android:background="@drawable/selectable_item_expand_mask" android:visibility="gone" android:layout_width="match_parent" android:layout_height="55dp">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" android:layout_toStartOf="@+id/share_to">
                <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="导出路径" />
                <TextView android:textSize="12sp" android:textColor="@color/grey" android:id="@+id/export_path" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:singleLine="true" />
            </LinearLayout>
            <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/share_to" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="分享至" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/export_path_more" />
            <ImageView android:id="@+id/export_path_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
    </LinearLayout>
    <TextView android:textSize="12sp" android:textColor="@color/red" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="提示：\10如要备份或转移数据，请使用云同步或数据备份功能，请勿通过账单导出备份数据" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
    <TextView android:textSize="12sp" android:textColor="@color/grey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:layout_marginBottom="15dp" android:text="Excel文件仅支持上传云端的附件导出，且有效期为12小时\10Zip文件支持将账单和附件打包导出" android:lineSpacingExtra="5dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
    <TextView android:textSize="13sp" android:textColor="@color/grey" android:id="@+id/bill_size" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="共0条账单数据" android:layout_marginStart="15dp" />
    <TextView android:textSize="15sp" android:textColor="@color/textColorLight" android:gravity="center" android:id="@+id/start_export" android:background="@drawable/selectable_item_primary_background" android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginTop="50dp" android:text="开始导出" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" />
</LinearLayout>