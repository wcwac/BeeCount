<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_asset_header" android:padding="15dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp">
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:id="@+id/number_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="剩余欠款" />
                <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/number" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="9999999" />
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:id="@+id/give_num_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="已还金额" />
                <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/already_give_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="9999999" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:id="@+id/service_num_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="已还利息：" />
            <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/service_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9999999" android:singleLine="true" />
        </LinearLayout>
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:id="@+id/in_time_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="下次还款：" />
            <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/in_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9999999" android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:gravity="center" android:orientation="horizontal" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginTop="15dp">
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/add_borrow" android:background="@drawable/selectable_item_expand_mask" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@mipmap/ic_add_bill" android:tint="@color/black" />
            <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="追加借入" android:layout_marginStart="10dp" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/repayment_btn" android:background="@drawable/selectable_item_expand_mask" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@mipmap/ic_data_repayment" android:tint="@color/black" />
            <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="还款" android:layout_marginStart="10dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>