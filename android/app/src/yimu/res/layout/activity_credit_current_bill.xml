<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="vertical" android:paddingTop="15dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RelativeLayout android:id="@+id/instalment_layout" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/instalment_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="10dp" android:text="分期账单" />
                <LinearLayout android:gravity="center" android:orientation="horizontal" android:background="@color/white" android:layout_width="wrap_content" android:layout_height="15dp" android:layout_margin="10dp" android:layout_alignParentEnd="true">
                    <TextView android:textSize="13dp" android:textColor="@color/darkGrey" android:id="@+id/instalment_number" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="分期金额 200.0" />
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/instalment_list" android:clipChildren="false" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@+id/instalment_title" android:overScrollMode="never" />
            </RelativeLayout>
            <RelativeLayout android:id="@+id/bill_layout" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/bill_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="10dp" android:text="收支账单" />
                <LinearLayout android:gravity="center" android:orientation="horizontal" android:background="@color/white" android:layout_width="wrap_content" android:layout_height="15dp" android:layout_margin="10dp" android:layout_alignParentEnd="true">
                    <TextView android:textSize="13dp" android:textColor="@color/darkGrey" android:id="@+id/bill_income" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="收入 200.0" android:layout_marginEnd="15dp" />
                    <TextView android:textSize="13dp" android:textColor="@color/darkGrey" android:id="@+id/bill_pay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="支出 200.0" />
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/bill_list" android:clipChildren="false" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@+id/bill_title" android:overScrollMode="never" />
            </RelativeLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>