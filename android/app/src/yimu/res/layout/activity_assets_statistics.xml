<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:id="@+id/tool_bar" android:background="@color/white" android:layout_width="match_parent" android:layout_height="50dp">
        <ImageView android:id="@+id/btn_back" android:background="@drawable/selectable_item_circle" android:padding="17dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_back" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" />
        <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="180dp" android:text="资产统计" android:singleLine="true" android:layout_centerVertical="true" android:layout_toEndOf="@+id/btn_back" />
        <ImageView android:id="@+id/choice_book" android:background="@drawable/selectable_item_circle" android:padding="15dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_main_account_book" android:tint="@color/floatBallColor" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RelativeLayout android:id="@+id/line_layout" android:background="@drawable/shape_bg_setting" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp">
                <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/asset_line_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="资产走势" android:layout_marginStart="10dp" />
                <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/date_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true">
                    <TextView android:textSize="13sp" android:textColor="@color/grey" android:id="@+id/line_time_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="近一月" />
                    <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@mipmap/ic_bottom_small" android:tint="@color/grey" />
                </LinearLayout>
                <FrameLayout android:id="@+id/asset_line_chart" android:layout_width="match_parent" android:layout_height="150dp" android:layout_marginTop="10dp" android:layout_below="@+id/asset_line_title" />
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:layout_below="@+id/asset_line_chart">
                    <TextView android:textSize="10sp" android:textColor="@color/darkGrey" android:id="@+id/line_start_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2021.5.12" android:layout_marginStart="15dp" />
                    <TextView android:textSize="10sp" android:textColor="@color/darkGrey" android:id="@+id/line_end_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2021.5.12" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true" />
                </RelativeLayout>
            </RelativeLayout>
            <LinearLayout android:orientation="vertical" android:id="@+id/pie_layout" android:background="@drawable/shape_bg_setting" android:paddingTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/asset_pie_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="资产分布" android:layout_marginStart="10dp" />
                    <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/pie_type_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true">
                        <TextView android:textSize="13sp" android:textColor="@color/grey" android:id="@+id/pie_type_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="总资产" />
                        <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@mipmap/ic_bottom_small" android:tint="@color/grey" />
                    </LinearLayout>
                </RelativeLayout>
                <RelativeLayout android:layout_width="match_parent" android:layout_height="200dp">
                    <FrameLayout android:id="@+id/pie_chart_detail" android:layout_width="match_parent" android:layout_height="200dp" />
                    <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/asset_check_detail" android:layout_width="60dp" android:layout_height="wrap_content" android:layout_centerInParent="true">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp" android:src="@mipmap/ic_checkout" android:tint="@color/darkGrey" />
                        <TextView android:textSize="10sp" android:textColor="@color/darkGrey" android:id="@+id/asset_check_text_detail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="资产占比" />
                    </LinearLayout>
                </RelativeLayout>
                <RelativeLayout android:visibility="gone" android:layout_width="match_parent" android:layout_height="200dp">
                    <FrameLayout android:id="@+id/pie_chart_group" android:layout_width="match_parent" android:layout_height="200dp" />
                    <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/asset_check_group" android:layout_width="60dp" android:layout_height="wrap_content" android:layout_centerInParent="true">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp" android:src="@mipmap/ic_checkout" android:tint="@color/darkGrey" />
                        <TextView android:textSize="10sp" android:textColor="@color/darkGrey" android:id="@+id/asset_check_text_group" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="资产占比" />
                    </LinearLayout>
                </RelativeLayout>
                <RelativeLayout android:id="@+id/pie_chart_type_layout" android:visibility="gone" android:layout_width="match_parent" android:layout_height="200dp">
                    <FrameLayout android:id="@+id/pie_chart_type" android:layout_width="match_parent" android:layout_height="200dp" />
                    <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/asset_check_type" android:layout_width="60dp" android:layout_height="wrap_content" android:layout_centerInParent="true">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp" android:src="@mipmap/ic_checkout" android:tint="@color/darkGrey" />
                        <TextView android:textSize="10sp" android:textColor="@color/darkGrey" android:id="@+id/asset_check_text_type" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="资产占比" />
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>
            <RelativeLayout android:id="@+id/stock_layout" android:background="@drawable/shape_bg_setting" android:paddingTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp">
                <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/stock_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="理财统计" android:layout_marginStart="10dp" />
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>