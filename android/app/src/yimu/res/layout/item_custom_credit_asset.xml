<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/parent_layout" android:background="@drawable/shape_bg_theme_content_10" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="15dp" android:layout_marginEnd="15dp">
    <ImageView android:id="@+id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" app:corner_radius="@dimen/common_radius" app:oval="false" />
    <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/title_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginStart="10dp" android:layout_marginEnd="10dp">
        <ImageView android:id="@+id/icon" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_custom_module_credit_card" />
        <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="信贷账户" android:singleLine="true" android:layout_marginStart="5dp" />
    </LinearLayout>
    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_below="@+id/title_layout" android:layout_marginStart="9dp" android:layout_marginEnd="9dp">
        <FrameLayout android:id="@+id/progress_view_one" android:layout_width="match_parent" android:layout_height="4dp" />
        <FrameLayout android:id="@+id/progress_view_two" android:layout_width="match_parent" android:layout_height="4dp" />
    </RelativeLayout>
    <TextView android:textSize="12sp" android:textColor="@color/grey" android:id="@+id/mode_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="5dp" android:text="14天后待还1.86" android:singleLine="true" android:layout_above="@+id/content" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
    <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="@color/moneyIncome" android:id="@+id/content" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="0.00" android:singleLine="true" android:layout_alignParentBottom="true" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
</RelativeLayout>