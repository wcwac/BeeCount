<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:background="@color/white" android:padding="15dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <ImageView android:id="@+id/photo" android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_launcher_no_color" android:layout_centerVertical="true" app:oval="true" />
    <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_toEndOf="@+id/photo">
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:textSize="15sp" android:textColor="@color/black" android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxWidth="100dp" android:text="我" android:singleLine="true" />
            <TextView android:textSize="12sp" android:textColor="@color/grey" android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="(已注册)" android:singleLine="true" android:layout_marginStart="6dp" />
        </LinearLayout>
        <TextView android:textSize="12sp" android:textColor="@color/textColorPrimary" android:id="@+id/copy_cdk" android:paddingTop="6dp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="点击复制邀请码" android:singleLine="true" />
    </LinearLayout>
</RelativeLayout>