<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:id="@+id/tool_bar" android:background="@color/white" android:layout_width="match_parent" android:layout_height="50dp">
        <ImageView android:id="@+id/btn_back" android:background="@drawable/selectable_item_circle" android:padding="17dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_close" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" />
        <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="180dp" android:text="转账" android:singleLine="true" android:layout_centerVertical="true" android:layout_toEndOf="@+id/btn_back" />
        <ImageView android:id="@+id/btn_complete" android:background="@drawable/selectable_item_circle" android:padding="12dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_tick" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <LinearLayout android:orientation="horizontal" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp">
        <RelativeLayout android:id="@+id/choice_asset_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="55dp">
            <LinearLayout android:orientation="vertical" android:id="@+id/choice_asset_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="15dp">
                <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="转入账户" />
                <TextView android:textSize="12sp" android:textColor="@color/grey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="金额将累加到该账户" />
            </LinearLayout>
            <LinearLayout android:gravity="end|center_vertical" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginStart="20dp" android:layout_toStartOf="@+id/ic_more" android:layout_toEndOf="@+id/choice_asset_title">
                <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end" android:id="@+id/asset_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="未选择" android:singleLine="true" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" />
                <TextView android:textSize="12sp" android:gravity="end" android:id="@+id/asset_number" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="可用：0.00" android:singleLine="true" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" />
            </LinearLayout>
            <ImageView android:id="@+id/ic_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="15dp" android:layout_marginEnd="15dp">
                <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:id="@+id/type_title" android:layout_width="match_parent" android:layout_height="50dp" android:text="金额" />
                <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:id="@+id/interest_title" android:layout_width="match_parent" android:layout_height="50dp" android:text="手续费" />
                <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:id="@+id/date_title" android:layout_width="match_parent" android:layout_height="50dp" android:text="日期" />
                <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:id="@+id/remark_title" android:layout_width="match_parent" android:layout_height="50dp" android:text="备注" />
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginEnd="15dp">
                    <EditText android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/type_number" android:background="@color/translate" android:layout_width="match_parent" android:layout_height="50dp" android:hint="到账金额（默认不含手续费）" android:singleLine="true" android:inputType="numberDecimal" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/currency_num_info" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/currency_num_info" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_alignParentEnd="true" />
                    <TextView android:textSize="13sp" android:textColor="@color/textColorPrimary" android:gravity="center" android:id="@+id/transfer_all" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="全部转出" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <RelativeLayout android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginEnd="15dp">
                    <EditText android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/type_interest" android:background="@color/translate" android:layout_width="match_parent" android:layout_height="50dp" android:hint="从本账户扣除，优惠输入负数" android:singleLine="true" android:inputType="numberDecimal" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/currency_interest_info" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/currency_interest_info" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_alignParentEnd="true" />
                    <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/to_num_info_layout" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_alignParentEnd="true">
                        <TextView android:textSize="13sp" android:textColor="@color/textColorPrimary" android:id="@+id/to_num_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="到账：0" />
                        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_checkout" android:tint="@color/textColorPrimary" android:layout_marginStart="5dp" />
                    </LinearLayout>
                </RelativeLayout>
                <RelativeLayout android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginEnd="15dp">
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:gravity="center_vertical" android:id="@+id/type_date" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="50dp" android:text="今日" android:singleLine="true" />
                </RelativeLayout>
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginEnd="15dp">
                    <EditText android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/type_remark" android:background="@color/translate" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp" android:hint="请输入备注" />
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="15dp">
                <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:id="@+id/temp" android:visibility="invisible" android:layout_width="wrap_content" android:layout_height="50dp" android:text="手续费" />
                <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:id="@+id/file_title" android:layout_width="wrap_content" android:layout_height="50dp" android:text="附件" android:layout_alignEnd="@+id/temp" />
            </RelativeLayout>
            <RelativeLayout android:id="@+id/file_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp" android:layout_marginStart="15dp">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/file_list" android:paddingBottom="5dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" />
                <TextView android:textSize="14sp" android:textColor="@color/grey" android:gravity="center_vertical" android:id="@+id/add_file_tip" android:layout_width="wrap_content" android:layout_height="50dp" android:text="点击添加" />
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
        <RelativeLayout android:id="@+id/bill_category" android:background="@drawable/selectable_item_expand_mask" android:visibility="gone" android:layout_width="match_parent" android:layout_height="55dp">
            <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/bill_category_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="手续费分类" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
            <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end" android:id="@+id/category_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="其他" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/bill_category_more" android:layout_toEndOf="@+id/bill_category_title" />
            <ImageView android:id="@+id/bill_category_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>