<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:gravity="center_horizontal" android:orientation="vertical" android:id="@+id/calendar_layout" android:paddingTop="2dp" android:paddingBottom="2dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <RelativeLayout android:layout_gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <ImageView android:id="@+id/current_day_bg" android:background="@drawable/shape_bg_primary_light_circle" android:layout_width="18dp" android:layout_height="18dp" android:layout_centerInParent="true" />
        <ImageView android:id="@+id/choice_day_bg" android:layout_width="18dp" android:layout_height="18dp" android:layout_centerInParent="true" />
        <TextView android:textSize="10dp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="30" android:layout_centerInParent="true" />
    </RelativeLayout>
</LinearLayout>