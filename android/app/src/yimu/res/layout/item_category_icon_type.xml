<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/total_layout" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
    <RelativeLayout android:id="@+id/parent_layout" android:layout_width="match_parent" android:layout_height="50dp">
        <ImageView android:id="@+id/icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@mipmap/ic_parent_education" android:layout_centerVertical="true" android:layout_marginStart="20dp" />
        <TextView android:textSize="15sp" android:textColor="@color/black" android:id="@+id/type_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="文化教育" android:layout_centerVertical="true" android:layout_marginStart="10dp" android:layout_marginEnd="50dp" android:layout_toStartOf="@+id/arrow" android:layout_toEndOf="@+id/icon" />
        <ImageView android:id="@+id/arrow" android:background="@drawable/selectable_item_circle" android:padding="10dp" android:layout_width="35dp" android:layout_height="35dp" android:src="@mipmap/ic_right" android:tint="@color/black" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/child_type" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@+id/parent_layout" android:overScrollMode="never" android:paddingStart="12dp" android:paddingEnd="12dp" />
</RelativeLayout>