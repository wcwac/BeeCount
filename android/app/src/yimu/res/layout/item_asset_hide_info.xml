<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:id="@+id/total_layout" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
    <RelativeLayout android:id="@+id/top_layout" android:layout_width="wrap_content" android:layout_height="45dp">
        <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center_vertical" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="45dp" android:text="资金账户" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
        <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/number" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:layout_centerVertical="true" android:layout_marginEnd="6dp" android:layout_toStartOf="@+id/arrow" />
        <ImageView android:id="@+id/arrow" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_bottom_small" android:tint="@color/iconTint" android:layout_centerVertical="true" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/data_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:overScrollMode="never" />
</LinearLayout>