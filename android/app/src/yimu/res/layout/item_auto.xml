<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/total_layout" android:background="@drawable/shape_bg_setting" android:paddingTop="12dp" android:paddingBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:paddingStart="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
    <RadioButton android:id="@+id/radio_button" android:focusable="false" android:visibility="gone" android:clickable="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="5dp" />
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_toEndOf="@+id/radio_button">
        <TextView android:textSize="15sp" android:textColor="@color/black" android:id="@+id/remark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="日常账本" />
        <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp">
            <TextView android:textSize="13sp" android:textColor="@color/grey" android:id="@+id/category" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="其他-其他" android:singleLine="true" />
            <TextView android:textSize="13sp" android:textColor="@color/grey" android:id="@+id/asset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="无账户" android:singleLine="true" android:layout_marginStart="15dp" />
            <TextView android:textSize="13sp" android:textColor="@color/grey" android:id="@+id/account_book" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="日常账本" android:singleLine="true" android:layout_marginStart="15dp" />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/tag_list" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginEnd="15dp" />
    </LinearLayout>
</RelativeLayout>