<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@drawable/bg_add_bill_dialog" android:layout_width="match_parent" android:layout_height="wrap_content">
    <RelativeLayout android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginTop="10dp" android:paddingStart="15dp">
        <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="选择分类" android:layout_centerVertical="true" />
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/account_book_manager" android:background="?android:attr/selectableItemBackground" android:layout_width="wrap_content" android:layout_height="45dp" android:layout_centerVertical="true" android:layout_alignParentEnd="true">
            <TextView android:textSize="14sp" android:textColor="@color/textColorBlack" android:gravity="center" android:id="@+id/show_hide_category" android:background="@drawable/selectable_item_expand_mask" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="显示隐藏分类" android:paddingStart="15dp" android:paddingEnd="15dp" />
            <TextView android:textSize="14sp" android:textColor="@color/textColorBlack" android:gravity="center" android:id="@+id/add_category" android:background="@drawable/selectable_item_expand_mask" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="编辑" android:paddingStart="15dp" android:paddingEnd="15dp" />
        </LinearLayout>
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/data_list" android:clipChildren="false" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="30dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>