<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/parent_layout" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:background="@drawable/bg_add_bill_dialog" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginTop="10dp" android:paddingStart="15dp">
            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="报销到账金额" android:layout_centerVertical="true" />
            <TextView android:textSize="15sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/save" android:background="@drawable/selectable_item_circle" android:layout_width="45dp" android:layout_height="45dp" android:text="保存" android:layout_centerVertical="true" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:layout_width="match_parent" android:layout_height="45dp">
            <EditText android:textSize="15sp" android:textColor="@color/black" android:textColorHint="@color/textGray" android:id="@+id/word_edit" android:background="@color/transparent" android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginBottom="5dp" android:hint="请输入报销到账金额" android:singleLine="true" android:inputType="numberDecimal" android:imeOptions="actionDone" android:paddingStart="20dp" android:paddingEnd="20dp" />
            <ImageView android:id="@+id/btn_clear" android:background="@drawable/selectable_item_circle" android:padding="8dp" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_clear" android:tint="@color/iconTint" android:layout_centerVertical="true" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:layout_marginStart="15dp">
            <CheckBox android:textSize="15sp" android:textColor="@color/black" android:id="@+id/checkbox" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="结束报销" style="@style/commonCheckBox" />
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/date_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="15dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@mipmap/ic_date_small" android:tint="@color/black" />
                <TextView android:textSize="13sp" android:textColor="@color/black" android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2021年8月9日" android:layout_marginStart="5dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>