<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:id="@+id/tool_bar" android:background="@color/white" android:layout_width="match_parent" android:layout_height="50dp">
        <ImageView android:id="@+id/btn_back" android:background="@drawable/selectable_item_circle" android:padding="17dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_close" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" />
        <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="180dp" android:text="账单组合" android:singleLine="true" android:layout_centerVertical="true" android:layout_toEndOf="@+id/btn_back" />
        <ImageView android:id="@+id/btn_delete" android:background="@drawable/selectable_item_circle" android:padding="14dp" android:visibility="gone" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_delete" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" android:layout_toStartOf="@+id/btn_complete" />
        <ImageView android:id="@+id/btn_complete" android:background="@drawable/selectable_item_circle" android:padding="12dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_tick" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never">
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp">
                <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="50dp">
                        <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:layout_width="wrap_content" android:layout_height="50dp" android:text="金额" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
                        <TextView android:textSize="15sp" android:id="@+id/total_number" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100.00" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginEnd="15dp" android:layout_alignParentEnd="true" />
                    </RelativeLayout>
                    <RelativeLayout android:id="@+id/choice_category_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="55dp">
                        <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="分类" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
                        <ImageView android:id="@+id/category_icon" android:layout_width="15dp" android:layout_height="15dp" android:src="@mipmap/ic_parent_other" android:layout_centerVertical="true" android:layout_toStartOf="@+id/category_name" />
                        <TextView android:textSize="13sp" android:textColor="@color/black" android:gravity="end" android:id="@+id/category_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="购物消费" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="10dp" android:layout_marginEnd="5dp" android:layout_toStartOf="@+id/ic_more" />
                        <ImageView android:id="@+id/ic_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
                    </RelativeLayout>
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginEnd="15dp">
                        <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:id="@+id/remark_title" android:layout_width="wrap_content" android:layout_height="50dp" android:text="备注" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
                        <EditText android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:gravity="end|center_vertical" android:id="@+id/remark" android:background="@color/translate" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp" android:hint="请输入备注" android:layout_toEndOf="@+id/remark_title" />
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/data_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:layout_marginBottom="15dp" android:overScrollMode="never" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/add_bill" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginBottom="15dp" android:paddingStart="20dp" android:paddingEnd="20dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_add" android:tint="@color/textColorPrimary" />
                <TextView android:textSize="14sp" android:textColor="@color/textColorPrimary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="新增账单" android:layout_marginStart="10dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>