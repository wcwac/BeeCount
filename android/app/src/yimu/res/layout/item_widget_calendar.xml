<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/calendar_layout" android:layout_width="match_parent" android:layout_height="wrap_content">
    <ImageView android:id="@+id/current_day_bg" android:background="@drawable/shape_bg_primary_light_5" android:layout_width="match_parent" android:layout_height="match_parent" />
    <ImageView android:id="@+id/current_day_bg_night" android:background="@drawable/shape_bg_primary_dark_5" android:layout_width="match_parent" android:layout_height="match_parent" />
    <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:textSize="12dp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="30" android:layout_centerHorizontal="true" />
            </RelativeLayout>
            <RelativeLayout android:id="@+id/repayment_layout" android:visibility="visible" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp">
                <ImageView android:id="@+id/repayment_bg" android:background="@drawable/shape_circle_primary" android:layout_width="14dp" android:layout_height="14dp" android:layout_centerInParent="true" />
                <TextView android:textSize="6sp" android:textColor="@color/white" android:id="@+id/repayment" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="还" android:layout_centerInParent="true" />
            </RelativeLayout>
            <TextView android:textSize="8dp" android:textColor="@color/darkGrey" android:id="@+id/lunar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="春节" android:layout_marginStart="3dp" />
        </LinearLayout>
        <TextView android:textSize="9dp" android:textColor="@color/moneyIncome" android:id="@+id/income" android:paddingTop="1dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+5.00" android:singleLine="true" />
        <TextView android:textSize="9dp" android:textColor="@color/moneyPay" android:id="@+id/pay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-3.00" android:singleLine="true" />
    </LinearLayout>
</RelativeLayout>