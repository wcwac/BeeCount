<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/total_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:layout_marginBottom="5dp">
    <ImageView android:id="@+id/icon" android:background="@drawable/shape_type_normal" android:padding="11dp" android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_temp" android:layout_centerHorizontal="true" />
    <ImageView android:id="@+id/icon_more" android:background="@drawable/shape_circle_white" android:padding="2dp" android:layout_width="15dp" android:layout_height="15dp" android:src="@mipmap/ic_more_category" android:tint="@color/colorPrimaryLightNoAlpha" android:layout_alignBottom="@+id/icon" android:layout_marginEnd="-3dp" android:layout_alignEnd="@+id/icon" />
    <TextView android:textSize="12sp" android:textColor="@color/darkGrey" android:ellipsize="end" android:id="@+id/name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="食品餐饮" android:singleLine="true" android:layout_below="@+id/icon" android:layout_centerHorizontal="true" />
</RelativeLayout>