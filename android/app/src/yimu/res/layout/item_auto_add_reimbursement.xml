<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/pay_layout" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:paddingTop="20dp" android:paddingBottom="30dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:textSize="13sp" android:textColor="@color/black" android:id="@+id/choice_bill_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="报销账单" android:layout_marginStart="15dp" />
        <RelativeLayout android:id="@+id/total_layout" android:background="@drawable/shape_background_light_10" android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="10dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
            <TextView android:textSize="13sp" android:textColor="@color/grey" android:gravity="center" android:id="@+id/choice_bill_tip" android:layout_width="wrap_content" android:layout_height="55dp" android:text="请选择报销账单" />
            <RelativeLayout android:id="@+id/bill_layout" android:layout_width="match_parent" android:layout_height="55dp">
                <ImageView android:id="@+id/icon" android:layout_width="20dp" android:layout_height="20dp" android:layout_centerVertical="true" android:layout_marginEnd="10dp" />
                <LinearLayout android:gravity="center_vertical" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="55dp" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/cost_layout" android:layout_toEndOf="@+id/icon">
                    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
                        <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/category" android:layout_width="0dp" android:layout_height="wrap_content" android:singleLine="true" android:layout_weight="1" />
                        <TextView android:textSize="9sp" android:textColor="@color/reimbursement_text" android:id="@+id/reimbursement" android:background="@drawable/bg_reimbursement" android:paddingTop="2dp" android:paddingBottom="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:singleLine="true" android:paddingStart="3dp" android:paddingEnd="3dp" android:layout_marginStart="5dp" />
                        <TextView android:textSize="9sp" android:textColor="@color/refund_text" android:id="@+id/refund" android:background="@drawable/bg_refund" android:paddingTop="2dp" android:paddingBottom="2dp" android:visibility="invisible" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="退" android:singleLine="true" android:paddingStart="3dp" android:paddingEnd="3dp" android:layout_marginStart="5dp" />
                        <TextView android:textSize="9sp" android:textColor="@color/discount_text" android:id="@+id/discount" android:background="@drawable/bg_discount" android:paddingTop="2dp" android:paddingBottom="2dp" android:visibility="invisible" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="惠" android:singleLine="true" android:paddingStart="3dp" android:paddingEnd="3dp" android:layout_marginStart="5dp" />
                    </LinearLayout>
                    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp">
                        <TextView android:textSize="11sp" android:textColor="@color/darkGrey" android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingEnd="5dp" />
                        <TextView android:textSize="9sp" android:ellipsize="end" android:gravity="center" android:id="@+id/tag_one" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="16dp" android:maxWidth="60dp" android:text="旅游账单" android:singleLine="true" android:paddingStart="5dp" android:paddingEnd="5dp" android:layout_marginEnd="5dp" />
                        <TextView android:textSize="9sp" android:ellipsize="end" android:gravity="center" android:id="@+id/tag_two" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="16dp" android:maxWidth="60dp" android:text="旅游账单" android:singleLine="true" android:paddingStart="5dp" android:paddingEnd="5dp" android:layout_marginEnd="5dp" />
                        <TextView android:textSize="9sp" android:ellipsize="end" android:gravity="center" android:id="@+id/tag_three" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="16dp" android:maxWidth="60dp" android:text="旅游账单" android:singleLine="true" android:paddingStart="5dp" android:paddingEnd="5dp" android:layout_marginEnd="5dp" />
                        <TextView android:textSize="11sp" android:textColor="@color/darkGrey" android:ellipsize="end" android:id="@+id/bill_remark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:gravity="end" android:orientation="vertical" android:id="@+id/cost_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_alignParentEnd="true">
                    <TextView android:textSize="15sp" android:id="@+id/bill_cost" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:textSize="10sp" android:textColor="@color/darkGrey" android:id="@+id/asset" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxWidth="100dp" android:text="支付宝" android:singleLine="true" />
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>
        <CheckBox android:textSize="13dp" android:textColor="@color/black" android:id="@+id/end_reimbursement" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="结束报销" android:singleLine="true" android:layout_marginStart="10dp" style="@style/commonCheckBox" />
    </LinearLayout>
</RelativeLayout>