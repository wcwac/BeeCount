<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:id="@+id/total_layout" android:background="@drawable/shape_bg_setting" android:padding="15dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
    <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <TextView android:textSize="15sp" android:textColor="@color/black" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="11月账单" />
        <TextView android:textSize="15sp" android:textColor="@color/colorPrimary" android:id="@+id/current_tag" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="（当月账单）" />
    </LinearLayout>
    <TextView android:textSize="13sp" android:textColor="@color/grey" android:id="@+id/number" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="账单金额：" />
    <TextView android:textSize="13sp" android:textColor="@color/grey" android:id="@+id/instalment_num" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="还款分期：" />
    <TextView android:textSize="13sp" android:textColor="@color/grey" android:id="@+id/remind_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="剩余待还：" />
    <TextView android:textSize="13sp" android:textColor="@color/grey" android:id="@+id/in_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="入账周期：" />
    <TextView android:textSize="13sp" android:textColor="@color/grey" android:id="@+id/repayment_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="还款日期：" />
</LinearLayout>