<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:orientation="vertical" android:background="@drawable/dialog_user_agreement_bg" android:paddingTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
    <LinearLayout android:gravity="center" android:layout_gravity="center_horizontal" android:orientation="horizontal" android:id="@+id/menu_layout" android:layout_width="wrap_content" android:layout_height="50dp">
        <TextView android:textSize="16dp" android:textColor="@color/black" android:gravity="center" android:id="@+id/pay_btn" android:layout_width="60dp" android:layout_height="match_parent" android:text="@string/income" />
        <TextView android:textSize="13dp" android:textColor="@color/grey" android:gravity="center" android:id="@+id/income_btn" android:layout_width="60dp" android:layout_height="match_parent" android:text="@string/pay" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/data_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="20dp" android:overScrollMode="never" app:maxHeight="500dp" />
    <RelativeLayout android:layout_width="match_parent" android:layout_height="50dp">
        <TextView android:textSize="15sp" android:textColor="@color/textGray" android:gravity="center" android:id="@+id/cancel" android:background="?android:attr/selectableItemBackground" android:layout_width="wrap_content" android:layout_height="50dp" android:text="取消" android:paddingStart="20dp" android:paddingEnd="20dp" android:layout_toStartOf="@+id/confirm" />
        <TextView android:textSize="15sp" android:textColor="@color/textColorPrimary" android:gravity="center" android:id="@+id/confirm" android:background="?android:attr/selectableItemBackground" android:layout_width="wrap_content" android:layout_height="50dp" android:text="确定" android:paddingStart="20dp" android:paddingEnd="20dp" android:layout_alignParentEnd="true" />
        <TextView android:textSize="14sp" android:textColor="@color/textColorBlack" android:gravity="center" android:id="@+id/show_hide" android:background="?android:attr/selectableItemBackground" android:layout_width="wrap_content" android:layout_height="50dp" android:text="显示隐藏分类" android:paddingStart="20dp" android:paddingEnd="20dp" />
    </RelativeLayout>
</LinearLayout>