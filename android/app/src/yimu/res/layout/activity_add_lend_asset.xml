<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:id="@+id/tool_bar" android:background="@color/white" android:layout_width="match_parent" android:layout_height="50dp">
        <ImageView android:id="@+id/btn_back" android:background="@drawable/selectable_item_circle" android:padding="17dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_close" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" />
        <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="180dp" android:text="新增智能分类" android:singleLine="true" android:layout_centerVertical="true" android:layout_toEndOf="@+id/btn_back" />
        <ImageView android:id="@+id/btn_complete" android:background="@drawable/selectable_item_circle" android:padding="12dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_tick" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never">
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:orientation="horizontal" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp">
                <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="15dp" android:layout_marginEnd="15dp">
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:id="@+id/content_title" android:layout_width="match_parent" android:layout_height="50dp" android:text="姓名" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:id="@+id/asset_num_title" android:visibility="gone" android:layout_width="match_parent" android:layout_height="50dp" android:text="剩余待还" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:id="@+id/type_title" android:layout_width="match_parent" android:layout_height="50dp" android:text="金额" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:id="@+id/remark_title" android:layout_width="match_parent" android:layout_height="50dp" android:text="备注" />
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:id="@+id/file_title" android:layout_width="match_parent" android:layout_height="50dp" android:text="附件" />
                </LinearLayout>
                <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginEnd="15dp">
                        <EditText android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/type_content" android:background="@color/translate" android:layout_width="match_parent" android:layout_height="50dp" android:hint="请输入出借人姓名" android:singleLine="true" />
                        <ImageView android:id="@+id/icon" android:layout_width="20dp" android:layout_height="20dp" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                    </RelativeLayout>
                    <RelativeLayout android:id="@+id/asset_number_layout" android:visibility="gone" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginEnd="15dp">
                        <EditText android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/type_asset_number" android:background="@color/translate" android:layout_width="match_parent" android:layout_height="50dp" android:hint="请输入借款金额" android:singleLine="true" android:inputType="numberDecimal" />
                    </RelativeLayout>
                    <RelativeLayout android:id="@+id/number_layout" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginEnd="15dp">
                        <EditText android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/type_number" android:background="@color/translate" android:layout_width="match_parent" android:layout_height="50dp" android:hint="请输入借款金额" android:singleLine="true" android:inputType="numberDecimal" android:layout_toStartOf="@+id/currency_num_info" />
                        <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/currency_num_info" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
                    </RelativeLayout>
                    <RelativeLayout android:id="@+id/remark_layout" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginEnd="15dp">
                        <EditText android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/remark" android:background="@color/translate" android:layout_width="match_parent" android:layout_height="50dp" android:hint="请输入备注" android:singleLine="true" />
                    </RelativeLayout>
                    <RelativeLayout android:id="@+id/file_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="55dp">
                        <androidx.recyclerview.widget.RecyclerView android:id="@+id/file_list" android:paddingBottom="5dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" />
                        <TextView android:textSize="14sp" android:textColor="@color/grey" android:id="@+id/add_file_tip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="点击添加" />
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:id="@+id/date_layout" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                <RelativeLayout android:id="@+id/out_day_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="50dp" android:paddingEnd="10dp">
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end" android:id="@+id/out_account_date_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="借出日期" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
                    <ImageView android:id="@+id/out_account_date_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                    <TextView android:textSize="13sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:gravity="center" android:id="@+id/out_account_date" android:layout_width="wrap_content" android:layout_height="50dp" android:hint="选择日期，选填" android:singleLine="true" android:layout_toStartOf="@+id/out_account_date_more" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/in_day_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="50dp" android:paddingEnd="10dp">
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end" android:id="@+id/in_account_date_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="还款日期" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
                    <ImageView android:id="@+id/in_account_date_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                    <TextView android:textSize="13sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:gravity="center" android:id="@+id/in_account_date" android:layout_width="wrap_content" android:layout_height="50dp" android:hint="选择日期，选填" android:singleLine="true" android:layout_toStartOf="@+id/in_account_date_more" />
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:id="@+id/bill_info_layout" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                <RelativeLayout android:id="@+id/choice_asset_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="50dp">
                    <LinearLayout android:orientation="vertical" android:id="@+id/choice_asset_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="15dp">
                        <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/asset_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="还款账户" />
                    </LinearLayout>
                    <TextView android:textSize="13sp" android:textColor="@color/black" android:gravity="end" android:id="@+id/asset_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="无账户" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/ic_name_more" android:layout_toEndOf="@+id/choice_asset_title" />
                    <ImageView android:id="@+id/ic_name_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/add_bill_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="50dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="20dp" android:layout_toStartOf="@+id/switch_add_bill">
                        <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/add_bill_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="生成账单" />
                        <TextView android:textSize="12sp" android:textColor="@color/grey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="选择生成账单后将会计入收支" android:singleLine="true" />
                    </LinearLayout>
                    <Switch android:id="@+id/switch_add_bill" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="false" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/bill_category" android:background="@drawable/selectable_item_expand_mask" android:visibility="gone" android:layout_width="match_parent" android:layout_height="55dp">
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/bill_category_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="账单分类" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
                    <TextView android:textSize="13sp" android:textColor="@color/black" android:gravity="end" android:id="@+id/category_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="无账户" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/bill_category_more" android:layout_toEndOf="@+id/bill_category_title" />
                    <ImageView android:id="@+id/bill_category_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/bill_currency_cost_layout" android:background="@drawable/selectable_item_expand_mask" android:visibility="gone" android:layout_width="match_parent" android:layout_height="55dp">
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/bill_currency_cost_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="账单金额" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
                    <LinearLayout android:gravity="end" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/bill_currency_cost_more" android:layout_toEndOf="@+id/bill_currency_cost_title">
                        <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/bill_currency_asset_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="11" android:singleLine="true" />
                        <TextView android:textSize="12sp" android:textColor="@color/grey" android:id="@+id/bill_currency_cost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="≈12" android:singleLine="true" />
                    </LinearLayout>
                    <ImageView android:id="@+id/bill_currency_cost_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                <RelativeLayout android:id="@+id/asset_icon_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="56dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="账户图标" android:layout_centerVertical="true" />
                    <ImageView android:id="@+id/asset_icon" android:padding="7dp" android:layout_width="38dp" android:layout_height="38dp" android:src="@mipmap/ic_asset_qita" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <RelativeLayout android:orientation="horizontal" android:id="@+id/night_icon_layout" android:background="@drawable/selectable_item_expand" android:layout_width="match_parent" android:layout_height="55dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="夜间模式图标" android:layout_centerVertical="true" />
                    <ImageView android:id="@+id/icon_night" android:background="@drawable/shape_type_normal_night" android:padding="7dp" android:layout_width="38dp" android:layout_height="38dp" android:src="@mipmap/ic_asset_qita" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/group_name_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="56dp" android:paddingStart="15dp">
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="所属分组" android:layout_centerVertical="true" />
                    <TextView android:textSize="13sp" android:textColor="@color/black" android:gravity="end" android:id="@+id/group_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="无账户" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/ic_more" />
                    <ImageView android:id="@+id/ic_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <RelativeLayout android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="50dp" android:paddingStart="15dp" android:paddingEnd="15dp">
                    <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="计入总资产" android:layout_centerVertical="true" />
                    <Switch android:id="@+id/switch_add_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/account_book_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="56dp" android:paddingStart="15dp">
                    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="20dp" android:layout_toStartOf="@+id/show_book">
                        <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="选择生效账本" />
                        <TextView android:textSize="12sp" android:textColor="@color/grey" android:id="@+id/account_book_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="账户仅显示在指定账本" android:singleLine="true" />
                    </LinearLayout>
                    <TextView android:textSize="13sp" android:textColor="@color/black" android:gravity="end" android:id="@+id/show_book" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="全部账本" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/ic_book_more" />
                    <ImageView android:id="@+id/ic_book_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>