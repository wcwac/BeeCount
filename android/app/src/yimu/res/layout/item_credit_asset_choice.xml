<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/total_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="56dp" android:paddingStart="15dp" android:paddingEnd="13dp">
    <ImageView android:id="@+id/icon" android:layout_width="20dp" android:layout_height="20dp" android:layout_centerVertical="true" />
    <LinearLayout android:gravity="center_vertical" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginStart="8dp" android:layout_toEndOf="@+id/icon">
        <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="花呗" android:singleLine="true" android:layout_marginEnd="20dp" />
        <TextView android:textSize="11sp" android:textColor="@color/grey" android:ellipsize="end" android:id="@+id/quota_num" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="额度：" android:singleLine="true" android:layout_marginEnd="20dp" />
    </LinearLayout>
</RelativeLayout>