<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:orientation="vertical" android:id="@+id/share_image" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
                <ImageView android:id="@+id/cover_custom" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <RelativeLayout android:layout_width="match_parent" android:layout_height="80dp">
                    <TextView android:textSize="12sp" android:textColor="@color/textColorBlack" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="进入“主题外观”页面，点击右上角“导入主题”按钮，扫码导入" android:layout_centerVertical="true" android:lineSpacingExtra="5dp" android:layout_marginStart="20dp" android:layout_marginEnd="50dp" android:layout_toStartOf="@+id/qr_code" />
                    <ImageView android:id="@+id/qr_code" android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="5dp" android:scaleType="fitXY" android:layout_alignParentEnd="true" />
                </RelativeLayout>
            </LinearLayout>
            <TextView android:textSize="15sp" android:textColor="@color/darkGrey" android:layout_gravity="center_horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:text="分享至" />
            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
                <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/share_wechat_session" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                    <ImageView android:layout_width="45dp" android:layout_height="45dp" android:src="@mipmap/ic_wechat" />
                    <TextView android:textSize="13sp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="微信" />
                </LinearLayout>
                <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/share_qq" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                    <ImageView android:layout_width="45dp" android:layout_height="45dp" android:src="@mipmap/ic_qq" />
                    <TextView android:textSize="13sp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="QQ" />
                </LinearLayout>
                <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/share_local" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                    <ImageView android:layout_width="45dp" android:layout_height="45dp" android:src="@mipmap/ic_save_local" />
                    <TextView android:textSize="13sp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="保存本地" />
                </LinearLayout>
                <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/share_more" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                    <ImageView android:layout_width="45dp" android:layout_height="45dp" android:src="@mipmap/ic_share_more" />
                    <TextView android:textSize="13sp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="更多" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>