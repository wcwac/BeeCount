<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/backgroundLight" android:padding="5dp" android:layout_width="match_parent" android:layout_height="220dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <TextView android:textSize="20sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" android:id="@+id/one" android:background="@drawable/bg_white" android:layout_width="0dp" android:layout_height="match_parent" android:text="1" android:layout_weight="1" />
        <TextView android:textSize="20sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" android:id="@+id/two" android:background="@drawable/bg_white" android:layout_width="0dp" android:layout_height="match_parent" android:text="2" android:layout_weight="1" android:layout_marginStart="5dp" />
        <TextView android:textSize="20sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" android:id="@+id/three" android:background="@drawable/bg_white" android:layout_width="0dp" android:layout_height="match_parent" android:text="3" android:layout_weight="1" android:layout_marginStart="5dp" />
        <ImageView android:id="@+id/delete_one" android:background="@drawable/bg_grey" android:layout_width="0dp" android:layout_height="match_parent" android:src="@mipmap/ic_delete_one" android:scaleType="center" android:tint="@color/black" android:layout_weight="1" android:layout_marginStart="5dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="5dp" android:layout_weight="1">
        <TextView android:textSize="20sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" android:id="@+id/four" android:background="@drawable/bg_white" android:layout_width="0dp" android:layout_height="match_parent" android:text="4" android:layout_weight="1" />
        <TextView android:textSize="20sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" android:id="@+id/five" android:background="@drawable/bg_white" android:layout_width="0dp" android:layout_height="match_parent" android:text="5" android:layout_weight="1" android:layout_marginStart="5dp" />
        <TextView android:textSize="20sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" android:id="@+id/six" android:background="@drawable/bg_white" android:layout_width="0dp" android:layout_height="match_parent" android:text="6" android:layout_weight="1" android:layout_marginStart="5dp" />
        <LinearLayout android:orientation="horizontal" android:background="@drawable/bg_grey_top" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp">
            <TextView android:textSize="20sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" android:id="@+id/add" android:layout_width="0dp" android:layout_height="match_parent" android:text="+" android:layout_weight="1" />
            <TextView android:textSize="20sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" android:id="@+id/reduce" android:layout_width="0dp" android:layout_height="match_parent" android:text="-" android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <TextView android:textSize="20sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" android:id="@+id/seven" android:background="@drawable/bg_white" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginTop="5dp" android:text="7" android:layout_weight="1" />
        <TextView android:textSize="20sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" android:id="@+id/eight" android:background="@drawable/bg_white" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginTop="5dp" android:text="8" android:layout_weight="1" android:layout_marginStart="5dp" />
        <TextView android:textSize="20sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" android:id="@+id/nine" android:background="@drawable/bg_white" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginTop="5dp" android:text="9" android:layout_weight="1" android:layout_marginStart="5dp" />
        <LinearLayout android:orientation="horizontal" android:background="@drawable/bg_grey_bottom" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp">
            <TextView android:textSize="20sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" android:id="@+id/ride" android:layout_width="0dp" android:layout_height="match_parent" android:text="×" android:layout_weight="1" />
            <TextView android:textSize="20sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" android:id="@+id/except" android:layout_width="0dp" android:layout_height="match_parent" android:text="÷" android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="5dp" android:layout_weight="1">
        <TextView android:textSize="15sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/add_bill_again" android:background="@drawable/bg_grey" android:layout_width="0dp" android:layout_height="match_parent" android:text="再记" android:layout_weight="1" />
        <TextView android:textSize="20sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" android:id="@+id/zero" android:background="@drawable/bg_white" android:layout_width="0dp" android:layout_height="match_parent" android:text="0" android:layout_weight="1" android:layout_marginStart="5dp" />
        <TextView android:textSize="20sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" android:id="@+id/point" android:background="@drawable/bg_white" android:layout_width="0dp" android:layout_height="match_parent" android:text="." android:layout_weight="1" android:layout_marginStart="5dp" />
        <TextView android:textSize="15sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/cancel" android:background="@drawable/bg_grey" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/cancel" android:layout_weight="1" android:layout_marginStart="5dp" />
    </LinearLayout>
</LinearLayout>