<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_asset_header" android:padding="15dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp">
        <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="账户余额" />
        <TextView android:textSize="22sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/number" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="9999999" />
        <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:id="@+id/number_info" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="" />
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/card_code_layout" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp">
            <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="卡号：" />
            <TextView android:textSize="13sp" android:textColor="@color/textColorLight" android:id="@+id/card_code" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:singleLine="true" />
            <ImageView android:id="@+id/copy_btn" android:background="@drawable/selectable_item_circle" android:padding="5dp" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_copy" android:tint="@color/textColorLight" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:id="@+id/fixed_deposit_layout" android:background="@drawable/shape_bg_setting" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp">
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:textSize="12sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="定期存款" />
            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/fixed_deposit_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:layout_marginBottom="10dp" android:text="4189.66" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:textSize="12sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="预计总收益" />
            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/fixed_deposit_has_income" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:layout_marginBottom="10dp" android:text="3.28%" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:textSize="12sp" android:textColor="@color/black" android:id="@+id/fixed_deposit_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="2023年11月21日" />
            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/fixed_deposit_income" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:layout_marginBottom="10dp" android:text="+855" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:gravity="center" android:orientation="horizontal" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginTop="15dp">
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/add_bill_btn" android:background="@drawable/selectable_item_expand_mask" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2">
            <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@mipmap/ic_add_bill" android:tint="@color/black" />
            <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="添加一条新记账" android:layout_marginStart="10dp" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/transfer_accounts_btn" android:background="@drawable/selectable_item_expand_mask" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@mipmap/ic_transfer_accounts" android:tint="@color/black" />
            <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="转账" android:layout_marginStart="10dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>