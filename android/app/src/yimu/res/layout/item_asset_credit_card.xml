<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/total_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="56dp" android:paddingStart="15dp" android:paddingEnd="13dp">
    <ImageView android:id="@+id/icon" android:layout_width="20dp" android:layout_height="20dp" android:layout_centerVertical="true" />
    <LinearLayout android:gravity="center_vertical" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginStart="8dp" android:layout_toEndOf="@+id/icon">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
            <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="花呗" android:singleLine="true" android:layout_marginEnd="20dp" android:layout_toStartOf="@+id/cost" />
            <TextView android:textSize="15sp" android:id="@+id/cost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10711" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:layout_marginBottom="2dp">
            <FrameLayout android:id="@+id/progress_view_one" android:layout_width="match_parent" android:layout_height="4dp" />
            <FrameLayout android:id="@+id/progress_view_two" android:layout_width="match_parent" android:layout_height="4dp" />
        </RelativeLayout>
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
            <TextView android:textSize="11sp" android:textColor="@color/grey" android:ellipsize="end" android:id="@+id/remark" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="我是备注" android:singleLine="true" android:layout_marginEnd="20dp" android:layout_toStartOf="@+id/repayment_date" />
            <TextView android:textSize="11sp" android:textColor="@color/grey" android:id="@+id/repayment_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3天后还款" android:layout_alignParentEnd="true" />
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>