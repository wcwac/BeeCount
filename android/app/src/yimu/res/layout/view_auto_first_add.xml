<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/parent_layout" android:background="@color/blackAlpha10" android:paddingBottom="20dp" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:id="@+id/content_layout" android:background="@drawable/dialog_user_agreement_bg" android:paddingBottom="10dp" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginStart="15dp">
            <TextView android:textSize="12sp" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="一木记账" android:layout_centerVertical="true" />
            <TextView android:textSize="15sp" android:textColor="@color/darkGrey" android:gravity="center" android:id="@+id/btn_save" android:background="?android:attr/selectableItemBackgroundBorderless" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="保存" android:paddingStart="15dp" android:paddingEnd="15dp" android:layout_toStartOf="@+id/close_btn" />
            <ImageView android:id="@+id/close_btn" android:background="?android:attr/selectableItemBackgroundBorderless" android:padding="12dp" android:layout_width="50dp" android:layout_height="40dp" android:src="@mipmap/ic_close" android:tint="@color/iconTint" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/reamrk_layout" android:layout_width="match_parent" android:layout_height="40dp" android:paddingStart="15dp">
            <TextView android:textSize="14sp" android:textColor="@color/darkGrey" android:id="@+id/remark_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="备注" android:layout_centerVertical="true" />
            <EditText android:textSize="14sp" android:textColor="@color/darkGrey" android:gravity="end|center_vertical" android:id="@+id/remark" android:background="@color/transparent" android:focusable="true" android:focusableInTouchMode="true" android:layout_width="match_parent" android:layout_height="match_parent" android:minWidth="100dp" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="20dp" android:layout_toStartOf="@+id/btn_clear" android:layout_toEndOf="@+id/remark_title" />
            <ImageView android:id="@+id/btn_clear" android:background="@drawable/selectable_item_circle" android:padding="8dp" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_clear" android:tint="@color/iconTint" android:layout_centerVertical="true" android:layout_marginEnd="5dp" android:layout_alignParentEnd="true" />
            <View android:background="@drawable/line_stroke" android:layout_width="match_parent" android:layout_height="1dp" android:layout_alignParentBottom="true" android:layerType="software" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/num_layout" android:layout_width="match_parent" android:layout_height="40dp" android:paddingStart="15dp" android:paddingEnd="15dp">
            <TextView android:textSize="14sp" android:textColor="@color/darkGrey" android:id="@+id/num_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="金额" android:layout_centerVertical="true" />
            <EditText android:textSize="14sp" android:textColor="@color/darkGrey" android:gravity="end|center_vertical" android:id="@+id/num" android:background="@color/transparent" android:focusable="true" android:focusableInTouchMode="true" android:layout_width="match_parent" android:layout_height="match_parent" android:minWidth="100dp" android:text="15.3" android:layout_centerVertical="true" android:inputType="numberDecimal" android:imeOptions="actionDone" android:layout_marginStart="20dp" android:layout_toEndOf="@+id/num_title" />
            <View android:background="@drawable/line_stroke" android:layout_width="match_parent" android:layout_height="1dp" android:layout_alignParentBottom="true" android:layerType="software" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/category_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="40dp" android:paddingStart="15dp" android:paddingEnd="15dp">
            <TextView android:textSize="14sp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="分类" android:layout_centerVertical="true" />
            <ImageView android:id="@+id/category_icon" android:layout_width="16dp" android:layout_height="16dp" android:layout_centerVertical="true" android:layout_marginEnd="6dp" android:layout_toStartOf="@+id/category" />
            <TextView android:textSize="14sp" android:textColor="@color/darkGrey" android:id="@+id/category" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="其他" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
            <View android:background="@drawable/line_stroke" android:layout_width="match_parent" android:layout_height="1dp" android:layout_alignParentBottom="true" android:layerType="software" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/date_layout" android:layout_width="match_parent" android:layout_height="40dp" android:paddingStart="15dp" android:paddingEnd="15dp">
            <TextView android:textSize="14sp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="日期" android:layout_centerVertical="true" />
            <TextView android:textSize="14sp" android:textColor="@color/darkGrey" android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="今天" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
            <View android:background="@drawable/line_stroke" android:layout_width="match_parent" android:layout_height="1dp" android:layout_alignParentBottom="true" android:layerType="software" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/account_book_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="40dp" android:paddingStart="15dp" android:paddingEnd="15dp">
            <TextView android:textSize="14sp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="账本" android:layout_centerVertical="true" />
            <TextView android:textSize="14sp" android:textColor="@color/darkGrey" android:id="@+id/account_book" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="日常账本" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
            <View android:background="@drawable/line_stroke" android:layout_width="match_parent" android:layout_height="1dp" android:layout_alignParentBottom="true" android:layerType="software" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/asset_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="40dp" android:paddingStart="15dp" android:paddingEnd="15dp">
            <TextView android:textSize="14sp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="账户" android:layout_centerVertical="true" />
            <ImageView android:id="@+id/asset_icon" android:layout_width="16dp" android:layout_height="16dp" android:layout_centerVertical="true" android:layout_marginEnd="6dp" android:layout_toStartOf="@+id/asset" />
            <TextView android:textSize="14sp" android:textColor="@color/darkGrey" android:id="@+id/asset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="无账户" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
            <View android:background="@drawable/line_stroke" android:layout_width="match_parent" android:layout_height="1dp" android:layout_alignParentBottom="true" android:layerType="software" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/reimbursement_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="40dp" android:paddingStart="15dp" android:paddingEnd="15dp">
            <TextView android:textSize="14sp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="报销" android:layout_centerVertical="true" />
            <ImageView android:id="@+id/reimbursement_icon" android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_data_no_baoxiao" android:layout_centerVertical="true" android:layout_marginEnd="6dp" android:layout_toStartOf="@+id/reimbursement" />
            <TextView android:textSize="14sp" android:textColor="@color/darkGrey" android:id="@+id/reimbursement" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="不报销" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
            <View android:background="@drawable/line_stroke" android:layout_width="match_parent" android:layout_height="1dp" android:layout_alignParentBottom="true" android:layerType="software" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/tag_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="15dp" android:paddingEnd="15dp">
            <TextView android:textSize="14sp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="标签" android:layout_centerVertical="true" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/tag_list" android:paddingTop="5dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="40dp" android:layout_centerVertical="true" android:layout_marginStart="100dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>