<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/backgroundLight" android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:id="@+id/tool_bar" android:background="@color/white" android:layout_width="match_parent" android:layout_height="50dp">
        <ImageView android:id="@+id/btn_back" android:background="@drawable/selectable_item_circle" android:padding="17dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_close" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" />
        <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="180dp" android:text="退款" android:singleLine="true" android:layout_centerVertical="true" android:layout_toEndOf="@+id/btn_back" />
        <ImageView android:id="@+id/btn_delete" android:background="@drawable/selectable_item_circle" android:padding="14dp" android:visibility="gone" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_delete" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" android:layout_toStartOf="@+id/btn_complete" />
        <ImageView android:id="@+id/btn_complete" android:background="@drawable/selectable_item_circle" android:padding="12dp" android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_tick" android:scaleType="fitCenter" android:tint="@color/black" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <LinearLayout android:orientation="horizontal" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp">
        <LinearLayout android:gravity="end" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="15dp" android:layout_marginEnd="15dp">
            <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:id="@+id/type_title" android:layout_width="wrap_content" android:layout_height="50dp" android:text="金额" />
            <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end|center_vertical" android:id="@+id/remark_title" android:layout_width="wrap_content" android:layout_height="50dp" android:text="备注" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="50dp">
                <EditText android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/type_number" android:background="@color/translate" android:layout_width="match_parent" android:layout_height="50dp" android:hint="请输入退款金额" android:singleLine="true" android:inputType="numberDecimal" android:layout_toStartOf="@+id/currency_num_info" />
                <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/currency_num_info" android:visibility="invisible" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/btn_clear" />
                <ImageView android:id="@+id/btn_clear" android:background="@drawable/selectable_item_circle" android:padding="8dp" android:layout_width="30dp" android:layout_height="30dp" android:src="@mipmap/ic_clear" android:tint="@color/iconTint" android:layout_centerVertical="true" android:layout_marginEnd="8dp" android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <RelativeLayout android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginEnd="15dp">
                <EditText android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:id="@+id/remark" android:background="@color/translate" android:layout_width="match_parent" android:layout_height="50dp" android:hint="请输入备注" android:singleLine="true" />
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
        <RelativeLayout android:id="@+id/choice_asset_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="55dp">
            <LinearLayout android:orientation="vertical" android:id="@+id/choice_asset_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="15dp">
                <TextView android:textSize="14sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="退款账户" />
                <TextView android:textSize="12sp" android:textColor="@color/grey" android:id="@+id/asset_tip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="退款金额会转入选择的账户" />
            </LinearLayout>
            <TextView android:textSize="13sp" android:textColor="@color/black" android:gravity="end" android:id="@+id/asset_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="无账户" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/ic_more" android:layout_toEndOf="@+id/choice_asset_title" />
            <ImageView android:id="@+id/ic_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/date_layout" android:background="@drawable/selectable_item_expand_mask" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:paddingEnd="10dp">
            <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="退款日期" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
            <ImageView android:id="@+id/date_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
            <TextView android:textSize="13sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:gravity="center" android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="50dp" android:text="选择日期" android:singleLine="true" android:layout_toStartOf="@+id/date_more" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/instalment_layout" android:background="@drawable/selectable_item_expand_mask" android:visibility="gone" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:paddingEnd="10dp">
            <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="分期属性" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
            <ImageView android:id="@+id/instalment_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
            <TextView android:textSize="13sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:gravity="center" android:id="@+id/instalment" android:layout_width="wrap_content" android:layout_height="50dp" android:text="减少分期本金" android:singleLine="true" android:layout_toStartOf="@+id/instalment_more" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/in_date_layout" android:background="@drawable/selectable_item_expand_mask" android:visibility="gone" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:paddingEnd="10dp">
            <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="入账日期" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="15dp" />
            <ImageView android:id="@+id/in_date_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
            <TextView android:textSize="13sp" android:textColor="@color/black" android:textColorHint="@color/grey" android:gravity="center" android:id="@+id/in_date" android:layout_width="wrap_content" android:layout_height="50dp" android:hint="选择日期" android:singleLine="true" android:layout_toStartOf="@+id/in_date_more" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/currency_cost_layout" android:background="@drawable/selectable_item_expand_mask" android:visibility="gone" android:layout_width="match_parent" android:layout_height="55dp">
            <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/currency_cost_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="到账金额" android:layout_centerVertical="true" android:layout_marginStart="15dp" />
            <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="end" android:id="@+id/currency_asset_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="14" android:singleLine="true" android:layout_centerVertical="true" android:layout_marginStart="15dp" android:layout_marginEnd="10dp" android:layout_toStartOf="@+id/currency_cost_more" android:layout_toEndOf="@+id/currency_cost_title" />
            <ImageView android:id="@+id/currency_cost_more" android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_more" android:tint="@color/grey" android:layout_centerVertical="true" android:layout_marginEnd="10dp" android:layout_alignParentEnd="true" />
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>