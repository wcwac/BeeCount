<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:orientation="vertical" android:background="@drawable/shape_bg_asset_header" android:padding="15dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp">
        <LinearLayout android:gravity="center" android:layout_gravity="center_horizontal" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:textSize="12sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="持有金额(元)" />
            <TextView android:textSize="20sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/total_number" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" />
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp">
            <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:textSize="12sp" android:textColor="@color/textColorLight" android:id="@+id/last_day_income_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="昨日收益" />
                <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/last_day_income" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" />
            </LinearLayout>
            <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:textSize="12sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="持有收益" />
                <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/total_income" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00" />
            </LinearLayout>
            <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:textSize="12sp" android:textColor="@color/textColorLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="持有收益率" />
                <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/textColorLight" android:id="@+id/income_percent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.00%" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:gravity="center" android:orientation="horizontal" android:background="@drawable/shape_bg_setting" android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginTop="15dp">
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/add_fund" android:background="@drawable/selectable_item_expand_mask" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@mipmap/ic_add_bill" android:tint="@color/black" />
            <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="买入" android:layout_marginStart="10dp" />
        </LinearLayout>
        <View android:background="@color/black" android:layout_width="1px" android:layout_height="match_parent" android:layout_marginTop="10dp" android:layout_marginBottom="10dp" />
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/sell_fund" android:background="@drawable/selectable_item_expand_mask" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@mipmap/ic_data_repayment" android:tint="@color/black" />
            <TextView android:textSize="15sp" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="卖出" android:layout_marginStart="10dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>