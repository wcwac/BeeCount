<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
    <RelativeLayout android:id="@+id/time_layout" android:paddingTop="15dp" android:paddingBottom="5dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/black" android:id="@+id/date_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="10dp" />
        <TextView android:textSize="13sp" android:textColor="@color/darkGrey" android:id="@+id/week_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="星期二" android:layout_toEndOf="@+id/date_text" />
        <LinearLayout android:orientation="horizontal" android:id="@+id/income_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="15dp" android:layout_toStartOf="@+id/pay_layout">
            <TextView android:textSize="13sp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="收" />
            <TextView android:textSize="13sp" android:textColor="@color/moneyIncome" android:id="@+id/income" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:layout_marginStart="4dp" />
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:id="@+id/pay_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true">
            <TextView android:textSize="13sp" android:textColor="@color/darkGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="支" />
            <TextView android:textSize="13sp" android:textColor="@color/moneyPay" android:id="@+id/pay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:layout_marginStart="4dp" />
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout android:id="@+id/bill_layout" android:background="@drawable/selectable_item_expand" android:layout_width="match_parent" android:layout_height="55dp" android:paddingEnd="10dp">
        <RelativeLayout android:id="@+id/start_layout" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_centerVertical="true">
            <ImageView android:id="@+id/icon" android:layout_width="20dp" android:layout_height="20dp" android:layout_centerVertical="true" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" />
            <RadioButton android:id="@+id/radio_button" android:background="@color/transparent" android:focusable="false" android:visibility="gone" android:clickable="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="8dp" android:layout_marginEnd="5dp" />
        </RelativeLayout>
        <LinearLayout android:gravity="center_vertical" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="55dp" android:layout_centerVertical="true" android:layout_marginEnd="5dp" android:layout_toStartOf="@+id/cost_layout" android:layout_toEndOf="@+id/start_layout">
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:textSize="14sp" android:textColor="@color/black" android:id="@+id/category" android:layout_width="0dp" android:layout_height="wrap_content" android:singleLine="true" android:layout_weight="1" />
                <TextView android:textSize="9sp" android:textColor="@color/reimbursement_text" android:id="@+id/reimbursement" android:background="@drawable/bg_reimbursement" android:paddingTop="2dp" android:paddingBottom="2dp" android:visibility="invisible" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="待报销" android:singleLine="true" android:paddingStart="3dp" android:paddingEnd="3dp" android:layout_marginStart="5dp" />
                <TextView android:textSize="9sp" android:textColor="@color/refund_text" android:id="@+id/refund" android:background="@drawable/bg_refund" android:paddingTop="2dp" android:paddingBottom="2dp" android:visibility="invisible" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="退" android:singleLine="true" android:paddingStart="3dp" android:paddingEnd="3dp" android:layout_marginStart="5dp" />
                <TextView android:textSize="9sp" android:textColor="@color/discount_text" android:id="@+id/discount" android:background="@drawable/bg_discount" android:paddingTop="2dp" android:paddingBottom="2dp" android:visibility="invisible" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="惠" android:singleLine="true" android:paddingStart="3dp" android:paddingEnd="3dp" android:layout_marginStart="5dp" />
            </LinearLayout>
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/second_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp">
                <TextView android:textSize="11sp" android:textColor="@color/darkGrey" android:id="@+id/time" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingEnd="5dp" />
                <ImageView android:id="@+id/has_file_tag" android:visibility="gone" android:layout_width="17dp" android:layout_height="16dp" android:src="@mipmap/ic_bill_has_file" android:tint="@color/darkGrey" android:paddingEnd="5dp" />
                <TextView android:textSize="9sp" android:ellipsize="end" android:gravity="center" android:id="@+id/tag_one" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="16dp" android:maxWidth="60dp" android:text="旅游账单" android:singleLine="true" android:paddingStart="5dp" android:paddingEnd="5dp" android:layout_marginEnd="5dp" />
                <TextView android:textSize="9sp" android:ellipsize="end" android:gravity="center" android:id="@+id/tag_two" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="16dp" android:maxWidth="60dp" android:text="旅游账单" android:singleLine="true" android:paddingStart="5dp" android:paddingEnd="5dp" android:layout_marginEnd="5dp" />
                <TextView android:textSize="9sp" android:ellipsize="end" android:gravity="center" android:id="@+id/tag_three" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="16dp" android:maxWidth="60dp" android:text="旅游账单" android:singleLine="true" android:paddingStart="5dp" android:paddingEnd="5dp" android:layout_marginEnd="5dp" />
                <TextView android:textSize="11sp" android:textColor="@color/colorPrimaryDark" android:ellipsize="end" android:id="@+id/create_user" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" />
                <TextView android:textSize="11sp" android:textColor="@color/darkGrey" android:ellipsize="end" android:id="@+id/remark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:gravity="end" android:orientation="vertical" android:id="@+id/cost_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_alignParentEnd="true">
            <LinearLayout android:gravity="bottom" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:textSize="12sp" android:textColor="@color/grey" android:id="@+id/old_cost" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="3dp" />
                <TextView android:textSize="15sp" android:id="@+id/cost" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp">
                <ImageView android:id="@+id/asset_icon" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginEnd="2dp" />
                <TextView android:textSize="10sp" android:textColor="@color/darkGrey" android:id="@+id/asset" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="100dp" android:text="支付宝" android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>
        <View android:id="@+id/file_click_layout" android:visibility="gone" android:layout_width="40dp" android:layout_height="30dp" android:layout_alignParentBottom="true" android:layout_marginStart="30dp" />
    </RelativeLayout>
</LinearLayout>