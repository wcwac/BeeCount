<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#F4F6F5" />
            <stroke android:width="1dp" android:color="#DCE2DF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/reference_surface" />
            <stroke android:width="2dp" android:color="@color/reference_accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/reference_surface" />
            <stroke android:width="1dp" android:color="#C5CFCA" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
