<resources>
    <string name="reference_accessibility_description">开启自动记账后，读取所选支付应用界面并生成本地待确认账单。实验分支保留一木原版的无障碍工具标记，以对比敏感节点的读取差异。只读页面，不上传内容，不执行手势或代替付款。</string>

    <!-- The existing pages and recovered artwork form a light UI. Keep dialog
         surfaces explicit instead of mixing platform/OEM defaults with it. -->
    <color name="reference_surface">#FFFFFF</color>
    <color name="reference_background">#F4F6F5</color>
    <color name="reference_text_primary">#202A27</color>
    <color name="reference_text_secondary">#5D6A65</color>
    <color name="reference_text_disabled">#8D9994</color>
    <color name="reference_accent">#147B64</color>
    <color name="reference_selection">#24147B64</color>

    <style name="BaseReferenceTheme" parent="AppTheme">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/reference_background</item>
        <item name="android:navigationBarColor">@color/reference_surface</item>
        <item name="android:windowBackground">@color/reference_background</item>
        <item name="android:colorBackground">@color/reference_background</item>
        <item name="android:colorBackgroundFloating">@color/reference_surface</item>
        <item name="android:textColorPrimary">@color/reference_text_primary</item>
        <item name="android:textColorSecondary">@color/reference_text_secondary</item>
        <item name="android:colorAccent">@color/reference_accent</item>
        <item name="colorAccent">@color/reference_accent</item>
        <item name="colorSurface">@color/reference_surface</item>
        <item name="colorOnSurface">@color/reference_text_primary</item>
        <item name="colorOnBackground">@color/reference_text_primary</item>
        <item name="colorBackgroundFloating">@color/reference_surface</item>
        <!-- Framework builders and Date/TimePickerDialog do not read the
             unprefixed AppCompat alertDialogTheme attribute. -->
        <item name="android:alertDialogTheme">@style/ReferenceFrameworkDialogTheme</item>
        <item name="android:dialogTheme">@style/ReferenceFrameworkDialogTheme</item>
        <item name="android:datePickerDialogTheme">@style/ReferenceDatePickerDialogTheme</item>
        <item name="android:timePickerDialogTheme">@style/ReferenceTimePickerDialogTheme</item>
        <item name="alertDialogTheme">@style/ReferenceAppCompatDialogTheme</item>
        <item name="dialogTheme">@style/ReferenceAppCompatDialogTheme</item>
    </style>
    <style name="ReferenceTheme" parent="BaseReferenceTheme" />

    <style name="BaseReferenceFrameworkDialogTheme" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@drawable/reference_dialog_background</item>
        <item name="android:colorBackground">@color/reference_surface</item>
        <item name="android:colorBackgroundFloating">@color/reference_surface</item>
        <item name="android:textColorPrimary">@color/reference_text_primary</item>
        <item name="android:textColorSecondary">@color/reference_text_secondary</item>
        <item name="android:textColorHighlight">@color/reference_selection</item>
        <item name="android:colorAccent">@color/reference_accent</item>
        <item name="android:colorControlActivated">@color/reference_accent</item>
        <item name="android:colorControlNormal">@color/reference_text_secondary</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.35</item>
        <item name="android:buttonBarButtonStyle">@style/ReferenceFrameworkDialogButton</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/ReferenceFrameworkDialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/ReferenceFrameworkDialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/ReferenceFrameworkDialogButton</item>
    </style>
    <style name="ReferenceFrameworkDialogTheme" parent="BaseReferenceFrameworkDialogTheme" />
    <style name="ReferenceDatePickerDialogTheme" parent="ReferenceFrameworkDialogTheme" />
    <style name="ReferenceTimePickerDialogTheme" parent="ReferenceFrameworkDialogTheme" />
    <style name="ReferenceFrameworkDialogButton" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textColor">@color/reference_dialog_button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="BaseReferenceAppCompatDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@drawable/reference_dialog_background</item>
        <item name="android:colorBackground">@color/reference_surface</item>
        <item name="android:colorBackgroundFloating">@color/reference_surface</item>
        <item name="android:textColorPrimary">@color/reference_text_primary</item>
        <item name="android:textColorSecondary">@color/reference_text_secondary</item>
        <item name="android:textColorHighlight">@color/reference_selection</item>
        <item name="android:colorAccent">@color/reference_accent</item>
        <item name="colorAccent">@color/reference_accent</item>
        <item name="colorControlActivated">@color/reference_accent</item>
        <item name="colorControlNormal">@color/reference_text_secondary</item>
        <item name="colorBackgroundFloating">@color/reference_surface</item>
        <item name="textColorAlertDialogListItem">@color/reference_text_primary</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.35</item>
        <item name="buttonBarButtonStyle">@style/ReferenceAppCompatDialogButton</item>
        <item name="buttonBarPositiveButtonStyle">@style/ReferenceAppCompatDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/ReferenceAppCompatDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/ReferenceAppCompatDialogButton</item>
    </style>
    <style name="ReferenceAppCompatDialogTheme" parent="BaseReferenceAppCompatDialogTheme" />
    <style name="ReferenceAppCompatDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/reference_dialog_button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
