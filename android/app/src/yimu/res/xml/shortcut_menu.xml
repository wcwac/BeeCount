<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:icon="@mipmap/ic_shortcut_menu_ai"
        android:enabled="true"
        android:shortcutId="add_ai_bill"
        android:shortcutShortLabel="@string/shortcut_ai_text"
