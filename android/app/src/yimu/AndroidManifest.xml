<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <queries>
        <package android:name="com.eg.android.AlipayGphone"/>
        <package android:name="com.tencent.mm"/>
        <package android:name="com.unionpay"/>
        <package android:name="com.jd.jrapp"/>
        <package android:name="com.jingdong.app.mall"/>
        <package android:name="com.xunmeng.pinduoduo"/>
        <package android:name="com.sankuai.meituan"/>
        <package android:name="com.dianping.v1"/>
        <package android:name="com.sankuai.meituan.takeoutnew"/>
        <package android:name="com.alibaba.wireless"/>
        <package android:name="com.taobao.idlefish"/>
        <package android:name="com.wudaokou.hippo"/>
        <package android:name="me.ele"/>
        <package android:name="com.huawei.wallet"/>
        <package android:name="com.ccb.longjiLife"/>
        <package android:name="com.smile.gifmaker"/>
        <package android:name="com.kuaishou.nebula"/>
        <package android:name="com.ss.android.ugc.aweme"/>
        <package android:name="com.ss.android.ugc.livelite"/>
        <package android:name="com.ss.android.ugc.aweme.lite"/>
        <package android:name="com.ss.android.yumme.video"/>
        <package android:name="com.taobao.taobao"/>
    </queries>
    <application android:name="com.wangc.bill.reference.ReferenceApplication" android:allowBackup="false" android:label="一木对比实验" android:icon="@mipmap/ic_launcher" android:theme="@style/ReferenceTheme" android:supportsRtl="true" android:usesCleartextTraffic="false">
        <activity android:name="com.wangc.bill.reference.ui.MainActivity" android:exported="true" android:launchMode="singleTop">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <activity android:name="com.wangc.bill.reference.ui.EditorActivity" android:exported="false" android:windowSoftInputMode="adjustResize"/>
        <activity android:name="com.wangc.bill.reference.ui.ManagerActivity" android:exported="false"/>
        <activity android:name="com.wangc.bill.reference.OriginalCreditStatementActivity" android:exported="false"/>
        <service android:name="com.wangc.bill.reference.capture.ReferenceCaptureService" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true" android:label="一木原版采集对比">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/reference_accessibility"/>
        </service>
        <receiver android:name="com.wangc.bill.reference.capture.PlanReceiver" android:exported="false"><intent-filter><action android:name="android.intent.action.BOOT_COMPLETED"/></intent-filter></receiver>
        <receiver android:name="com.wangc.bill.reference.ReferenceWidget" android:exported="false"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/reference_widget_info"/></receiver>
        <receiver android:name="com.wangc.bill.reference.OriginalRepaymentWidget" android:label="近期还款" android:exported="true"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/reference_repayment_widget_info"/></receiver>
        <service android:name="com.wangc.bill.reference.OriginalRepaymentWidgetService" android:permission="android.permission.BIND_REMOTEVIEWS" android:exported="false"/>
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.files" android:exported="false" android:grantUriPermissions="true"><meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/reference_file_paths"/></provider>
        <provider android:name="androidx.startup.InitializationProvider" tools:node="remove" tools:ignore="MissingClass"/>
        <receiver android:name="androidx.profileinstaller.ProfileInstallReceiver" tools:node="remove" tools:ignore="MissingClass"/>
    </application>
</manifest>
